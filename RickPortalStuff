end

function orbBezier(p0, p1, p2, p3, t)
    local u = 1 - t
    return p0 * (u * u * u) + p1 * (3 * u * u * t) + p2 * (3 * u * t * t) + p3 * (t * t * t)
end

-- one-shot glowing ball that swells and fades out (the "pop" when the orb lets go of the dot)
function orbPop(pos, fromSize, toSize, life, color)
    local pop = Instance.new("Part")
    pop.Shape = Enum.PartType.Ball
    pop.Material = Enum.Material.Neon
    pop.Color = color
    pop.Transparency = 0.15
    pop.Size = Vector3.new(fromSize, fromSize, fromSize)
    pop.Anchored = true
    pop.CanCollide = false
    pop.CanTouch = false
    pop.CanQuery = false
    pop.CastShadow = false
    pop.Position = pos
    pop.Parent = workspace
    local tween = TweenService:Create(
        pop,
        TweenInfo.new(life, Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
        { Size = Vector3.new(toSize, toSize, toSize), Transparency = 1 }
    )
    tween.Completed:Once(function()
        pop:Destroy()
    end)
    tween:Play()
end

-- The orb is born INSIDE the gun's dot and charges there (glued to the dot's live position, so it rides
-- the arm as it swings up). Then it lets go from wherever the dot is RIGHT NOW with a pop, leaves up out
-- of the dome, and flies one smooth curve that lands exactly on toPos. Speed is mapped by distance along
-- the curve (never wobbles), it eases up to full speed over the first part and then holds it, and a
-- glowing trail draws the curve behind it.
function shootOrb(fromPos, toPos, travelTime)
    local dotPart = getGunDotPart()
    local lastDot = dotPart and dotPart.Position or fromPos
    local function dotPos()
        if dotPart and dotPart.Parent then
            lastDot = dotPart.Position
        end
        return lastDot
    end

    local function makeBall(color, transparency)
        local ball = Instance.new("Part")
        ball.Shape = Enum.PartType.Ball
        ball.Material = Enum.Material.Neon
        ball.Color = color
        ball.Transparency = transparency
        ball.Size = Vector3.new(ORB_START_SIZE, ORB_START_SIZE, ORB_START_SIZE)
        ball.Anchored = true
        ball.CanCollide = false
        ball.CanTouch = false
        ball.CanQuery = false
        ball.CastShadow = false
        ball.Position = lastDot
        ball.Parent = workspace
        return ball
    end

    -- green shell + hot white core, a light that follows it, and a trail
    local shell = makeBall(GLOW_COLOR, 0.1)
    local core = makeBall(Color3.fromRGB(235, 255, 225), 0)

    local light = Instance.new("PointLight")
    light.Color = GLOW_COLOR
    light.Range = 10
    light.Brightness = 0
    light.Shadows = false
    light.Parent = shell

    local trailTop = Instance.new("Attachment")
    trailTop.Parent = shell
    local trailBottom = Instance.new("Attachment")
    trailBottom.Parent = shell
    local trail = Instance.new("Trail")
    trail.Attachment0 = trailTop
    trail.Attachment1 = trailBottom
    trail.Color = ColorSequence.new(Color3.fromRGB(215, 255, 200), GLOW_COLOR)
    trail.Transparency = NumberSequence.new({
        NumberSequenceKeypoint.new(0, 0.05),
        NumberSequenceKeypoint.new(1, 1),
    })
    trail.WidthScale = NumberSequence.new({
        NumberSequenceKeypoint.new(0, 1),
        NumberSequenceKeypoint.new(1, 0),
    })
    trail.Lifetime = ORB_TRAIL_LIFETIME
    trail.MinLength = 0.02
    trail.LightEmission = 1
    trail.LightInfluence = 0
    trail.FaceCamera = true
    trail.Enabled = false
    trail.Parent = shell

    local function place(pos, d)
        shell.Size = Vector3.new(d, d, d)
        shell.Position = pos
        local c = d * 0.55
        core.Size = Vector3.new(c, c, c)
        core.Position = pos
        trailTop.Position = Vector3.new(0, d * 0.5, 0)
        trailBottom.Position = Vector3.new(0, -d * 0.5, 0)
        light.Brightness = 2.2 * math.clamp(d / ORB_PEAK_SIZE, 0, 1)
    end

    -- progress along the curve (0..1) for flight time x (0..1): starts at ORB_START_SPEED of cruising
    -- speed, eases up to full speed over ORB_EASE_IN_FRAC, then holds it. Normalised so progress(1) = 1.
    local ease = ORB_EASE_IN_FRAC
    local v0 = ORB_START_SPEED
    local norm = 1 - ease * 0.5 * (1 - v0)
    local function progress(x)
        local covered
        if x < ease then
            local u = x / ease
            covered = v0 * x + (1 - v0) * ease * (u * u * u - u * u * u * u * 0.5)
        else
            covered = v0 * ease + (1 - v0) * ease * 0.5 + (x - ease)
        end
        return covered / norm
    end

    local ok, err = pcall(function()
        -- 1) charge inside the dot, riding it while the arm swings up
        local holdStart = os.clock()
        while true do
            local raw = (os.clock() - holdStart) / ORB_HOLD_TIME
            local h = math.clamp(raw, 0, 1)
            h = h * h * (3 - 2 * h)
            place(dotPos(), ORB_START_SIZE + (ORB_CHARGE_SIZE - ORB_START_SIZE) * h)
            if raw >= 1 then break end
            RunService.RenderStepped:Wait()
        end

        -- 2) let go from where the dot is right now
        local p0 = dotPos()
        local p3 = toPos
        local toTarget = p3 - p0
        local dist = toTarget.Magnitude
        local aim = dist > 0.01 and toTarget.Unit or Vector3.zAxis

        -- leaves up out of the dome, pulled toward the target so the curve can never swing backwards
        local exitDir = (aim + Vector3.yAxis * ORB_EXIT_UP).Unit
        local p1 = p0 + exitDir * (dist * ORB_P1_REACH)
        local p2 = p3 - aim * (dist * ORB_P2_REACH)

        -- arc-length table so the orb moves at a steady, controllable speed along the curve
        local steps = 32
        local lens = { 0 }
        local prev = p0
        for i = 1, steps do
            local pt = orbBezier(p0, p1, p2, p3, i / steps)
            lens[i + 1] = lens[i] + (pt - prev).Magnitude
            prev = pt
        end
        local total = lens[steps + 1]

        local function curveParam(s)
            local want = s * total
            local lo, hi = 1, steps + 1
            while hi - lo > 1 do
                local mid = math.floor((lo + hi) / 2)
                if lens[mid] <= want then lo = mid else hi = mid end
            end
            local seg = lens[hi] - lens[lo]
            local f = seg > 1e-6 and (want - lens[lo]) / seg or 0
            return ((lo - 1) + f) / steps
        end

        orbPop(p0, ORB_CHARGE_SIZE, ORB_PEAK_SIZE * 2.2, 0.14, GLOW_COLOR)
        trail.Enabled = true

        -- 3) fly the curve
        local flightStart = os.clock()
        while true do
            local x = math.clamp((os.clock() - flightStart) / travelTime, 0, 1)
            local pos = orbBezier(p0, p1, p2, p3, curveParam(progress(x)))

            -- keep riding the dot's motion for a moment, then let go of it smoothly
            local follow = math.clamp(x / ORB_FOLLOW_FRAC, 0, 1)
            follow = 1 - follow * follow * (3 - 2 * follow)
            if follow > 0 then
                pos = pos + (dotPos() - p0) * follow
            end

            -- swells out of the dot, then tightens toward the shoot point
            local swell = math.clamp(x / ORB_SWELL_FRAC, 0, 1)
            swell = swell * swell * (3 - 2 * swell)
            local shrink = math.clamp((x - ORB_SWELL_FRAC) / (1 - ORB_SWELL_FRAC), 0, 1)
            local d = ORB_CHARGE_SIZE + (ORB_PEAK_SIZE - ORB_CHARGE_SIZE) * swell
            d = d + (ORB_END_SIZE - d) * shrink * shrink

            place(pos, d)

            if x >= 1 then break end
            RunService.RenderStepped:Wait()
        end
    end)

    -- the orb is gone, but the trail is left to fade out on its own
    trail.Enabled = false
    light:Destroy()
    core:Destroy()
    shell.Transparency = 1
    task.delay(ORB_TRAIL_LIFETIME + 0.1, function()
        shell:Destroy()
    end)
    if not ok then error(err, 0) end
end

function buildPortal(portalCF, decorative, onWall, p, frame, light, enter)
    p = { state = "opening", stateStart = os.clock(), spawnTime = os.clock(), armed = false, decorative = decorative, onWall = onWall }
    if not decorative then
        snapFieldOfView()
    end

    -- Wall portal: switch off collision on the wall behind the opening (same trick as the
    -- retreat floor) so you can actually walk through. Restored when the portal goes away.
    p.wallParts = {}
    if onWall and not decorative then
        overlap = OverlapParams.new()
        overlap.FilterType = Enum.RaycastFilterType.Exclude
        ignore = {}
        for _, plr in ipairs(Players:GetPlayers()) do
            if plr.Character then
                table.insert(ignore, plr.Character)
            end
        end
        overlap.FilterDescendantsInstances = ignore
        -- portal faces out along -Z, so the wall is on the +Z side
        cutCF = portalCF * CFrame.new(0, 0, WALL_CUT_DEPTH / 2)
        found = workspace:GetPartBoundsInBox(cutCF, Vector3.new(TRIGGER_SIZE.X, TRIGGER_SIZE.Y, WALL_CUT_DEPTH), overlap)
        for _, part in ipairs(found) do
            if part.CanCollide and not part:IsA("Terrain") then
                table.insert(p.wallParts, part)
                part.CanCollide = false
            end
        end
    end
    -- if nothing could be switched off (e.g. a terrain wall) fall back to touch-to-enter
    p.touchMode = onWall and not decorative and #p.wallParts == 0

    frame = Instance.new("Part")
    frame.Name = "RickPortal"
    frame.Transparency = 1
    frame.Size = Vector3.new(0.05, 0.05, DISC_THICKNESS)
    frame.Anchored = true
    frame.CanCollide = false
    frame.CanTouch = false
    frame.CanQuery = false
    frame.CastShadow = false
    frame.CFrame = portalCF

    p.labels = {
        makeFace(frame, Enum.NormalId.Front),
        makeFace(frame, Enum.NormalId.Back),
    }

    light = Instance.new("PointLight")
    light.Color = GLOW_COLOR
    light.Range = 0
    light.Brightness = 0
    light.Shadows = false
    light.Parent = frame
    p.light = light

    TweenService:Create(
        light,
        TweenInfo.new(LIGHT_TWEEN_TIME, Enum.EasingStyle.Quint, Enum.EasingDirection.Out),
        { Range = LIGHT_RANGE }
    ):Play()

    frame.Parent = workspace
    p.frame = frame
    playSounds(OPEN_SOUNDS, frame)
    if decorative and EXIT_SOUND.asset then
        playSounds({ { id = EXIT_SOUND.asset, volume = EXIT_PORTAL_SOUND_VOLUME } }, frame)
    end

    -- Walking into a portal isn't enough: you have to go all the way THROUGH it, and a bit
    -- past (ENTER_DEPTH studs beyond the portal's face), inside its opening, before it fires.
    function enter(root, area, tRoot, portalSpot, toTarget, landPos, retPos)
        area = chosenArea
        chosenArea = nil

        if area then
            chosenTarget = nil
            p.armed = false
            hideGun()
            teleportToArea(root, area, p)
            return
        end

        tRoot = (chosenTarget and chosenTarget:IsDescendantOf(workspace)) and chosenTarget or pickTarget()
        chosenTarget = nil
        if not tRoot then
            warn("[RickPortal] no other player to teleport to")
            return
        end

        p.armed = false
        hideGun()
        -- exit portal sits where you used to land; you appear 2 studs behind it, facing the
        -- target, and keep walking forward through it
        portalSpot = (tRoot.CFrame * CFrame.new(0, 0, ARRIVE_DISTANCE + RETURN_PORTAL_OFFSET - EXIT_PORTAL_FRONT_DISTANCE)).Position
        toTarget = Vector3.new(tRoot.Position.X - portalSpot.X, 0, tRoot.Position.Z - portalSpot.Z)
        toTarget = toTarget.Magnitude > 0.01 and toTarget.Unit or Vector3.new(0, 0, -1)
        landPos = portalSpot - toTarget * EXIT_PORTAL_BEHIND_DISTANCE
        snapFieldOfView()
        teleportOut(root, landPos, tRoot.Position, true)
        closePortal(p)

        retPos = Vector3.new(portalSpot.X, tRoot.Position.Y + SPAWN_HEIGHT, portalSpot.Z)
        buildPortal(CFrame.lookAt(retPos, retPos + toTarget), true)
    end

    p.conn = RunService.Heartbeat:Connect(function()
        now = os.clock()
        t = now - p.stateStart
        w, h = nil, nil

        if not p.decorative and p.state ~= "closing" then
            char = LocalPlayer.Character
            root = char and char:FindFirstChild("HumanoidRootPart")
            if root and p.touchMode then
                -- wall we couldn't cut open (e.g. terrain): touching the portal is enough
                if p.armed then
                    overlap = OverlapParams.new()
                    overlap.FilterType = Enum.RaycastFilterType.Include
                    overlap.FilterDescendantsInstances = { char }
                    if #workspace:GetPartBoundsInBox(portalCF, TRIGGER_SIZE, overlap) > 0 then
                        enter(root)
                    end
                end
            elseif root then
                rel = portalCF:PointToObjectSpace(root.Position)
                prev = p.lastRel
                p.lastRel = rel

                -- startSide = the side of the portal you came from (+1 or -1 along its normal)
                if p.startSide == nil then
                    p.startSide = rel.Z >= 0 and 1 or -1
                elseif math.abs(rel.Z) > ENTER_DEPTH + 1 then
                    p.startSide = rel.Z > 0 and 1 or -1
                end

                -- depth = how far past the plane you are, measured away from where you started
                if p.armed and prev then
                    dPrev = -p.startSide * prev.Z
                    dNow = -p.startSide * rel.Z
                    if dPrev < ENTER_DEPTH and dNow >= ENTER_DEPTH then
                        -- where on the portal's opening did you cross the "deep" line?
                        alpha = (ENTER_DEPTH - dPrev) / (dNow - dPrev)
                        crossX = prev.X + (rel.X - prev.X) * alpha
                        crossY = prev.Y + (rel.Y - prev.Y) * alpha
                        if math.abs(crossX) <= TRIGGER_SIZE.X / 2 and math.abs(crossY) <= TRIGGER_SIZE.Y / 2 then
                            enter(root)
                        end
                    end
                end
            else
                p.lastRel = nil
            end
        end

        if p.state == "opening" then
            w = PORTAL_SIZE * bounce(t)
            h = PORTAL_SIZE * bounce(t - STAGGER)
            if t >= ARM_DELAY and not p.decorative then p.armed = true end
            if t >= OPEN_TIME then
                if p.decorative then
                    closePortal(p)
                else
                    p.state = "open"
                    p.stateStart = now
                end
            end
        elseif p.state == "open" then
            w = PORTAL_SIZE * (1 + PULSE_AMOUNT * math.sin(t * PULSE_SPEED))
            h = PORTAL_SIZE * (1 + PULSE_AMOUNT * math.sin(t * PULSE_SPEED + 1.2))
            if t >= PORTAL_LIFETIME then
                closePortal(p)
            end
        else
            u = math.clamp(t / CLOSE_TIME, 0, 1)
            w = PORTAL_SIZE * (1 - TweenService:GetValue(u, Enum.EasingStyle.Back, Enum.EasingDirection.In))
            h = PORTAL_SIZE * (1 - TweenService:GetValue(math.min(u * 1.25, 1), Enum.EasingStyle.Back, Enum.EasingDirection.In))
            if u >= 1 then
                destroyPortal(p)
                return
            end
        end

        w = math.max(w, 0.05)
        h = math.max(h, 0.05)

        frame.Size = Vector3.new(w * widthScale, h, DISC_THICKNESS)

        rot = ((now - p.spawnTime) * SPIN_SPEED) % 360
        for _, lbl in ipairs(p.labels) do
            lbl.Rotation = rot
        end
        light.Brightness = LIGHT_BRIGHTNESS * math.clamp(w / PORTAL_SIZE, 0, 1.3)
    end)

    portals[p] = true
    return p
end

-- Retreat arrival: you appear sunk into the ground under the exit portal, hold for a moment,
-- then get thrown up and forward. Only YOU go non-solid (and un-supported) - the floor itself is
-- never touched, so a big floor part keeps its collision everywhere.
function emergeFromFloor(root, portalPos, normal, look, upSpeed, fwdSpeed, character, hum, charParts, prevPlatformStand, sunkPos, launchUp, forwardApplied, done, launched, launchTime, conn, finish)
    upSpeed = upSpeed or FAILSAFE_LAUNCH_UP
    fwdSpeed = fwdSpeed or FAILSAFE_LAUNCH_FWD
    character = root.Parent
    hum = character and character:FindFirstChildOfClass("Humanoid")
    if not character or not hum then return end

    -- no collision on you
    charParts = {}
    for _, d in ipairs(character:GetDescendants()) do
        if d:IsA("BasePart") then
            charParts[d] = d.CanCollide
            d.CanCollide = false
        end
    end
    prevPlatformStand = hum.PlatformStand
    hum.PlatformStand = true

    -- sunk into the ground, held still
    sunkPos = portalPos - normal * FAILSAFE_SINK_DEPTH
    root.CFrame = CFrame.lookAt(sunkPos, sunkPos + look)
    root.AssemblyLinearVelocity = Vector3.zero
    root.Anchored = true

    -- straight up first; the forward push only starts once you've risen back out of the sink depth
    launchUp = Vector3.new(0, upSpeed, 0)
    forwardApplied = false
    done = false
    launched = false
    launchTime = 0
    conn = nil

    function finish()
        if done then return end
        done = true
        if conn then
            conn:Disconnect()
            conn = nil
        end
        if root.Parent then
            root.Anchored = false
        end
        for part, original in pairs(charParts) do
            if part.Parent then
                part.CanCollide = original
            end
        end
        if hum.Parent then
            hum.PlatformStand = prevPlatformStand
            hum:ChangeState(Enum.HumanoidStateType.Freefall)
        end
    end

    conn = RunService.Stepped:Connect(function()
        if not character.Parent or not root.Parent or hum.Health <= 0 then
            finish()
            return
        end
        -- the humanoid keeps turning collision back on, so keep it off
        for part in pairs(charParts) do
            if part.Parent and part.CanCollide then
                part.CanCollide = false
            end
        end
        if launched then
            height = (root.Position - portalPos):Dot(normal)
            -- height starts at -FAILSAFE_SINK_DEPTH; 0 means you've passed the whole sink distance
            if not forwardApplied and height >= 0 then
                forwardApplied = true
                if fwdSpeed > 0 then
                    v = root.AssemblyLinearVelocity
                    root.AssemblyLinearVelocity = Vector3.new(look.X * fwdSpeed, v.Y, look.Z * fwdSpeed)
                end
            end
            if height >= 3 or os.clock() - launchTime > 2 then
                finish()
            end
        end
    end)

    task.delay(FAILSAFE_SINK_HOLD, function()
        if done or not root.Parent then return end
        root.Anchored = false
        root.AssemblyLinearVelocity = launchUp
        launched = true
        launchTime = os.clock()
        RunService.Heartbeat:Once(function()
            if not done and not forwardApplied and root.Parent then
                root.AssemblyLinearVelocity = launchUp
            end
        end)
    end)
end

teleportToArea = function(root, area, fromPortal, opts, origin, flat, look, landPos, floorExit, pos, faceAt, toFace, floorPos, rayParams, ignore, hit, behind, portalPos, retPos)

    origin = root.CFrame
    flat = Vector3.new(origin.LookVector.X, 0, origin.LookVector.Z)
    look = flat.Magnitude > 0.01 and flat.Unit or Vector3.new(0, 0, -1)
    landPos = area.cframe.Position
    floorExit = opts and opts.floorExit

    -- areas can work out their destination at the last moment (e.g. "behind that player")
    if area.resolve then
        pos, faceAt = area.resolve()
        if pos then
            landPos = pos
            if faceAt then
                toFace = Vector3.new(faceAt.X - pos.X, 0, faceAt.Z - pos.Z)
                if toFace.Magnitude > 0.01 then
                    look = toFace.Unit
                end
            end
        end
    end

    floorPos = nil
    if floorExit then
        -- find the floor at the destination and put the exit portal flat on it
        rayParams = RaycastParams.new()
        rayParams.FilterType = Enum.RaycastFilterType.Exclude
        rayParams.RespectCanCollide = true
        ignore = {}
        for _, plr in ipairs(Players:GetPlayers()) do
            if plr.Character then
                table.insert(ignore, plr.Character)
            end
        end
        rayParams.FilterDescendantsInstances = ignore
        hit = workspace:Raycast(landPos + Vector3.new(0, 5, 0), Vector3.new(0, -40, 0), rayParams)
        floorPos = hit and hit.Position or (landPos - Vector3.new(0, 3, 0))
        landPos = Vector3.new(landPos.X, floorPos.Y + 2.5, landPos.Z)
    end

    snapFieldOfView()
    if floorExit then
        -- retreat arrival: no exit animation
        teleportOut(root, landPos, landPos + look, false, true)
    else
        -- regular portal: appear 2 studs behind the exit portal and keep walking forward
        behind = landPos - look * EXIT_PORTAL_BEHIND_DISTANCE
        teleportOut(root, behind, behind + look, true)
    end
    if fromPortal then
        closePortal(fromPortal)
    end

    if floorExit then
        portalPos = floorPos + Vector3.new(0, WALL_OFFSET, 0)
        buildPortal(CFrame.lookAt(portalPos, portalPos + Vector3.yAxis, Vector3.zAxis), true)

        -- start sunk into the ground under the portal, then get thrown out up and forward
        emergeFromFloor(root, portalPos, Vector3.yAxis, look, opts.upSpeed, opts.fwdSpeed)
    else
        retPos = Vector3.new(landPos.X, landPos.Y + SPAWN_HEIGHT, landPos.Z)
        buildPortal(CFrame.lookAt(retPos, retPos + look), true)
    end

    if area.onArrive then
        task.spawn(area.onArrive)
    end
end

function openPortal(target, char, root, rootCF, center, portalCF, rayParams, ignore, rayOrigin, shotVector, reach, hit, orbEnd, onWall, stuckPos, hand, fromPos)
    if shooting then return end
    char = LocalPlayer.Character
    root = char and char:FindFirstChild("HumanoidRootPart")
    if not root then
        warn("[RickPortal] no character / HumanoidRootPart found")
        return
    end

    rootCF = root.CFrame
    center = (rootCF * CFrame.new(0, SPAWN_HEIGHT, -SPAWN_DISTANCE)).Position

    portalCF = CFrame.lookAt(center, Vector3.new(rootCF.Position.X, center.Y, rootCF.Position.Z))

    rayParams = RaycastParams.new()
    rayParams.FilterType = Enum.RaycastFilterType.Exclude
    rayParams.RespectCanCollide = true
    ignore = {}
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr.Character then
            table.insert(ignore, plr.Character)
        end
    end
    rayParams.FilterDescendantsInstances = ignore

    rayOrigin = rootCF.Position + Vector3.new(0, SPAWN_HEIGHT, 0)
    shotVector = center - rayOrigin
    reach = shotVector + shotVector.Unit * WALL_SNAP_DISTANCE
    hit = workspace:Raycast(rayOrigin, reach, rayParams)
    orbEnd = center
    onWall = false
    if hit and math.abs(hit.Normal.Y) < WALL_MAX_NORMAL_Y then
        onWall = true
        orbEnd = hit.Position
        stuckPos = hit.Position + hit.Normal * WALL_OFFSET

        portalCF = CFrame.lookAt(stuckPos, stuckPos + hit.Normal)
    end

    hand = char:FindFirstChild("RightHand") or char:FindFirstChild("Right Arm") or root
    fromPos = hand.Position

    for p in pairs(portals) do
        closePortal(p)
    end

    chosenTarget = typeof(target) == "Instance" and target or nil
    chosenArea = (type(target) == "table" and typeof(target.cframe) == "CFrame") and target or nil
    shooting = true
    showGun()
    shootTrack = playCharacterAnimation(char, SHOOT_ANIMATION_ID)
    playSounds(SHOOT_SOUNDS, root)
    task.spawn(function()

        shotTime = math.max(SHOT_TIME * (orbEnd - fromPos).Magnitude / (center - fromPos).Magnitude, 0.08)
        local orbTotal = ORB_HOLD_TIME + shotTime   -- charge-up + flight: when the portal actually opens
        zoomFieldOfView(orbTotal)
        task.delay(math.max(orbTotal - PRE_OPEN_TIME, 0), function()
            playSounds({ PRE_OPEN_SOUND }, root)
        end)
        orbOk, orbErr = pcall(shootOrb, fromPos, orbEnd, shotTime)
        if not orbOk then warn("[RickPortal] orb failed: " .. tostring(orbErr)) end
        shooting = false
        buildOk, buildResult = pcall(buildPortal, portalCF, nil, onWall)
        if buildOk and buildResult then
            buildResult.shotPortal = true
        else
            hideGun()
            warn("[RickPortal] portal failed: " .. tostring(buildResult))
        end
    end)
end

failsafe = {
    enabled = FAILSAFE_ENABLED,
    threshold = FAILSAFE_HEALTH,
    armed = true,
    retreating = false,
    lastTrigger = -math.huge,
    bindId = 0,
    conns = {},
}

function findArea(name)
    for _, area in ipairs(AREAS) do
        if area.name == name then
            return area
        end
    end
    return nil
end

StarterGui = game:GetService("StarterGui")

function performRetreat(character, humanoid, area, track, preflagged, stopTrack, root, ignore, rayParams, hit, floorPos, floorY, portalPos)
    function stopTrack()
        if track and track.IsPlaying then
            track:Stop(0)
        end
    end

    if failsafe.retreating and not preflagged then return end
    root = character:FindFirstChild("HumanoidRootPart")
    if not character.Parent or humanoid.Health <= 0 or not root then
        stopTrack()
        failsafe.retreating = false
        return
    end

    ignore = {}
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr.Character then
            table.insert(ignore, plr.Character)
        end
    end

    -- find the floor under the player and lay a portal flat on it
    rayParams = RaycastParams.new()
    rayParams.FilterType = Enum.RaycastFilterType.Exclude
    rayParams.RespectCanCollide = true
    rayParams.FilterDescendantsInstances = ignore

    hit = workspace:Raycast(root.Position, Vector3.new(0, -40, 0), rayParams)
    floorPos = hit and hit.Position or (root.Position - Vector3.new(0, 3, 0))
    floorY = floorPos.Y
    portalPos = floorPos + Vector3.new(0, WALL_OFFSET, 0)
    ok, err = pcall(buildPortal, CFrame.lookAt(portalPos, portalPos + Vector3.yAxis, Vector3.zAxis), true)
    if not ok then
        warn("[RickPortal] failsafe portal failed: " .. tostring(err))
    end

    failsafe.retreating = true

    task.delay(FAILSAFE_DELAY, function(curRoot, floorParts, overlap, found, charParts, prevPlatformStand, done, conn, started, finish)
        curRoot = character:FindFirstChild("HumanoidRootPart")
        if not character.Parent or humanoid.Health <= 0 or not curRoot then
            stopTrack()
            failsafe.retreating = false
            return
        end

        -- remember + disable the floor parts under the portal
        floorParts = {}
        overlap = OverlapParams.new()
        overlap.FilterType = Enum.RaycastFilterType.Exclude
        overlap.FilterDescendantsInstances = ignore
        found = workspace:GetPartBoundsInBox(CFrame.new(floorPos.X, floorY - 8, floorPos.Z), Vector3.new(10, 20, 10), overlap)
        for _, part in ipairs(found) do
            if part.CanCollide and not part:IsA("Terrain") then
                table.insert(floorParts, part)
                part.CanCollide = false
            end
        end

        -- remember + disable the character's collision
        charParts = {}
        for _, d in ipairs(character:GetDescendants()) do
            if d:IsA("BasePart") then
                charParts[d] = d.CanCollide
                d.CanCollide = false
            end
        end

        -- PlatformStand stops the humanoid from holding you up off the ground
        prevPlatformStand = humanoid.PlatformStand
        humanoid.PlatformStand = true
        curRoot.AssemblyLinearVelocity = Vector3.new(0, -12, 0)

        done = false
        conn = nil
        started = os.clock()

        function finish(doTeleport)
            if done then return end
            done = true
            if conn then
                conn:Disconnect()
                conn = nil
            end
            stopTrack()

            for part, original in pairs(charParts) do
                if part.Parent then
                    part.CanCollide = original
                end
            end
            for _, part in ipairs(floorParts) do
                if part.Parent then
                    part.CanCollide = true
                end
            end
            if humanoid.Parent then
                humanoid.PlatformStand = prevPlatformStand
            end
            failsafe.retreating = false

            if doTeleport then
                r = character:FindFirstChild("HumanoidRootPart")
                if r and humanoid.Health > 0 then
                    teleportToArea(r, area, nil, { floorExit = true, upSpeed = area.upSpeed, fwdSpeed = area.fwdSpeed })
                end
            end
        end

        conn = RunService.Stepped:Connect(function()
            if not character.Parent or humanoid.Health <= 0 or not curRoot.Parent then
                finish(false)
                return
            end
            -- the humanoid keeps trying to turn collision back on, so keep it off
            for part in pairs(charParts) do
                if part.Parent and part.CanCollide then
                    part.CanCollide = false
                end
            end
            if curRoot.Position.Y <= floorY - FAILSAFE_FALL_DEPTH or os.clock() - started > FAILSAFE_FALL_TIMEOUT then
                finish(true)
            end
        end)
    end)
end

-- The full retreat: wave animation + pre-open sound, then the floor portal 0.1s later.
-- Both the mini button and the Retreat? popup use this so they look identical.
function runRetreatSequence(character, humanoid, area, root, track)
    root = character:FindFirstChild("HumanoidRootPart")
    if not character.Parent or not root or humanoid.Health <= 0 or failsafe.retreating then
        return false
    end

    failsafe.retreating = true
    track = playCharacterAnimation(character, RETREAT_ANIMATION_ID)
    playSounds({ PRE_OPEN_SOUND }, root)
    task.delay(RETREAT_START_DELAY, function()
        performRetreat(character, humanoid, area, track, true)
    end)
    return true
end

function triggerFailsafe(character, humanoid, area, root, callback)
    area = findArea(FAILSAFE_AREA)
    root = character:FindFirstChild("HumanoidRootPart")
    if not area or not root then return end
    if (root.Position - area.cframe.Position).Magnitude < FAILSAFE_MIN_DISTANCE then return end

    -- disarmed until health goes back above the threshold (or you respawn)
    failsafe.armed = false
    failsafe.lastTrigger = os.clock()

    callback = Instance.new("BindableFunction")
    callback.OnInvoke = function(choice)
        if choice == "Yes" then
            runRetreatSequence(character, humanoid, area)
        end
        task.defer(function()
            callback:Destroy()
        end)
    end
    task.delay(FAILSAFE_PROMPT_TIME + 2, function()
        if callback.Parent == nil then
            callback:Destroy()
        end
    end)

    ok, err = pcall(function()
        StarterGui:SetCore("SendNotification", {
            Title = "Retreat?",
            Text = string.format("Health is low (%d). Teleport to %s?", math.floor(humanoid.Health), area.name),
            Duration = FAILSAFE_PROMPT_TIME,
            Button1 = "Yes",
            Button2 = "No",
            Callback = callback,
        })
    end)
    if not ok then
        warn("[RickPortal] couldn't show the Retreat? prompt: " .. tostring(err))
        callback:Destroy()
    end
end

function bindFailsafe(character)
    failsafe.bindId = failsafe.bindId + 1
    local myId = failsafe.bindId
    for _, c in ipairs(failsafe.conns) do
        c:Disconnect()
    end
    table.clear(failsafe.conns)
    failsafe.armed = true

    local humanoid = character:WaitForChild("Humanoid", 10)
    if not humanoid or failsafe.bindId ~= myId then return end

    table.insert(failsafe.conns, humanoid.HealthChanged:Connect(function(health)
        if health > failsafe.threshold then
            failsafe.armed = true
            return
        end
        if not failsafe.enabled or not failsafe.armed or health <= 0 then return end
        if os.clock() - failsafe.lastTrigger < FAILSAFE_COOLDOWN then return end
        triggerFailsafe(character, humanoid)
    end))
end

failsafeCharConn = LocalPlayer.CharacterAdded:Connect(function(character)
    task.delay(MORPH_DELAY, function()
        if character.Parent then
            bindFailsafe(character)
        end
    end)
end)
if LocalPlayer.Character then
    task.spawn(bindFailsafe, LocalPlayer.Character)
end

-- Same retreat as the failsafe, but started on demand (no popup, no low-health needed).
-- Returns true if the retreat started.
function manualRetreat()
    character = LocalPlayer.Character
    humanoid = character and character:FindFirstChildOfClass("Humanoid")
    root = character and character:FindFirstChild("HumanoidRootPart")
    area = findArea(FAILSAFE_AREA)
    if not humanoid or not root or not area or humanoid.Health <= 0 then
        return false
    end
    if failsafe.retreating then
        return false
    end
    if (root.Position - area.cframe.Position).Magnitude < FAILSAFE_MIN_DISTANCE then
        pcall(function()
            StarterGui:SetCore("SendNotification", {
                Title = "Retreat",
                Text = "You're already at " .. area.name .. ".",
                Duration = 3,
            })
        end)
        return false
    end

    return runRetreatSequence(character, humanoid, area)
end

-- ===================== AUTO-DODGE =====================
ReplicatedStorage = game:GetService("ReplicatedStorage")
Debris = game:GetService("Debris")

dodge = { enabled = DODGE_ENABLED, cooldownEnd = 0, seen = {} }

-- download the dodge sound once at startup (same writefile + getcustomasset route as the portal texture)
for _, snd in ipairs(DODGE_SOUNDS) do
    task.spawn(function()
        ok, assetOrErr = pcall(function()
            writefile(snd.file, game:HttpGet(snd.url))
            return getcustomasset(snd.file)
        end)
        if ok and assetOrErr and assetOrErr ~= "" then
            snd.asset = assetOrErr
            print("[RickPortal] dodge sound loaded: " .. snd.file)
        else
            warn("[RickPortal] couldn't load dodge sound " .. snd.file .. ": " .. tostring(assetOrErr))
        end
    end)
end

function flatXZ(v)
    return Vector3.new(v.X, 0, v.Z)
end

-- How much the attacker must be facing you grows smoothly (an S-curve) with distance:
-- point-blank = anything goes, short range = "kind of facing", max range = "properly facing".
function dodgeRequiredFacing(dist)
    t = math.clamp((dist - DODGE_POINT_BLANK) / (DODGE_RANGE - DODGE_POINT_BLANK), 0, 1)
    smooth = t * t * (3 - 2 * t)
    return DODGE_FACING_NEAR + (DODGE_FACING_FAR - DODGE_FACING_NEAR) * smooth
end

function isConditionedDodgeAnimation(animationId)
    for _, id in ipairs(CONDITIONED_DODGE_ANIMATION_IDS) do
        if string.find(animationId, id, 1, true) then
            return true
        end
    end
    return false
end

function isDodgeAnimation(animationId)
    if isConditionedDodgeAnimation(animationId) then
        return true
    end
    for _, id in ipairs(DODGE_ANIMATION_IDS) do
        if string.find(animationId, id, 1, true) then
            return true
        end
    end
    return false
end

function shouldDodge(attackerChar, maxRange, anyDirection)
    maxRange = maxRange or DODGE_RANGE
    myChar = LocalPlayer.Character
    myRoot = myChar and myChar:FindFirstChild("HumanoidRootPart")
    myHum = myChar and myChar:FindFirstChildOfClass("Humanoid")
    aRoot = attackerChar:FindFirstChild("HumanoidRootPart")
    aHum = attackerChar:FindFirstChildOfClass("Humanoid")
    if not myRoot or not myHum or myHum.Health <= 0 or not aRoot or not aHum or aHum.Health <= 0 then
        return false
    end

    offset = myRoot.Position - aRoot.Position
    dist = offset.Magnitude
    if dist > maxRange then
        return false
    end
    if dist <= DODGE_POINT_BLANK or anyDirection then
        return true
    end

    toMe = flatXZ(offset)
    look = flatXZ(aRoot.CFrame.LookVector)
    if toMe.Magnitude < 0.01 or look.Magnitude < 0.01 then
        return false
    end
    return look.Unit:Dot(toMe.Unit) >= dodgeRequiredFacing(dist)
end

-- Teleport VFX: clones a particle template onto your root and bursts every emitter in it.
function emitVFX(root, vfxTemplate, emitCount, keepEnabled)
    part = vfxTemplate:Clone()
    part.Parent = root
    for _, v in ipairs(part:GetChildren()) do
        if v:IsA("ParticleEmitter") then
            v:Emit(emitCount or 15)
            v.Enabled = keepEnabled or false
        end
    end
    Debris:AddItem(part, 3)
end

-- hidden = true makes your whole body invisible, false brings it back exactly as it was
hiddenOriginals = setmetatable({}, { __mode = "k" })
function setVisibility(character, hidden)
    for _, d in ipairs(character:GetDescendants()) do
        if (d:IsA("BasePart") or d:IsA("Decal")) and d.Name ~= "HumanoidRootPart" then
            if hidden then
                if hiddenOriginals[d] == nil then
                    hiddenOriginals[d] = d.Transparency
                end
                d.Transparency = 1
            elseif hiddenOriginals[d] ~= nil then
                d.Transparency = hiddenOriginals[d]
                hiddenOriginals[d] = nil
            end
        end
    end
end

-- Hologram-blue highlight over your whole body (hidden behind walls, not through them) that fades out
-- smoothly; one tween drives both the fill and the outline, same as the portal flash.
function flashDodgeHighlight(character, highlight, tween)
    highlight = Instance.new("Highlight")
    highlight.Name = "RickDodgeFlash"
    highlight.Adornee = character
    highlight.FillColor = DODGE_GLOW_COLOR
    highlight.OutlineColor = DODGE_GLOW_COLOR
    highlight.FillTransparency = 0
    highlight.OutlineTransparency = 0
    highlight.DepthMode = Enum.HighlightDepthMode.Occluded
    highlight.Parent = character

    tween = TweenService:Create(
        highlight,
        TweenInfo.new(DODGE_FLASH_TIME, Enum.EasingStyle.Sine, Enum.EasingDirection.Out),
        { FillTransparency = 1, OutlineTransparency = 1 }
    )
    tween.Completed:Once(function()
        highlight:Destroy()
    end)
    tween:Play()
end

function emitDodgeBurst(root)
    pcall(function()
        particles = ReplicatedStorage.Resources.NinjaUlt.Start_Effects.Particles
        emitVFX(root, particles.Low)
        emitVFX(root, particles.Center_Tilted)
        emitVFX(root, particles.Ground)
    end)
end

function isStreakVoicePlaying()
    return dodgeStreak.sound ~= nil and dodgeStreak.sound.Parent ~= nil and dodgeStreak.sound.IsPlaying
end

function playDodgeArrival(character, root, playVoice, playStreakVoice, sound)
    flashDodgeHighlight(character)
    for _, snd in ipairs(DODGE_SOUNDS) do
        if snd.asset and (snd ~= DODGE_VOICE or (playVoice and not isStreakVoicePlaying())) and (snd ~= DODGE_STREAK_VOICE or playStreakVoice) then
            sound = playSounds({ { id = snd.asset, volume = snd.volume } }, root)
            if snd == DODGE_STREAK_VOICE then
                dodgeStreak.sound = sound
            end
        end
    end

    -- quick blink so the teleport reads as a flash (own thread so the dodge poll isn't held up)
    task.spawn(function()
        setVisibility(character, true)  task.wait(0.01)
        setVisibility(character, false) task.wait(0.01)
        setVisibility(character, true)  task.wait(0.01)
        setVisibility(character, false)
    end)
end

-- ===================== BLUE BUTTON BLINK FX (visuals only) =====================
-- Everything below is cosmetic and runs inside a pcall, so a failed effect can never stop the teleport.

-- an anchored, non-colliding neon part
function behindFxPart(shape, size, color, transparency, cf)
    local part = Instance.new("Part")
    part.Shape = shape
    part.Material = Enum.Material.Neon
    part.Color = color
    part.Transparency = transparency
    part.Size = size
    part.Anchored = true
    part.CanCollide = false
    part.CanTouch = false
    part.CanQuery = false
    part.CastShadow = false
    part.CFrame = cf
    part.Parent = workspace
    return part
end

-- tweens `inst` to `goal`, then destroys it
function behindFxTween(inst, time, goal, style, direction)
    local tween = TweenService:Create(
        inst,
        TweenInfo.new(time, style or Enum.EasingStyle.Quad, direction or Enum.EasingDirection.Out),
        goal
    )
    tween.Completed:Once(function()
        inst:Destroy()
    end)
    tween:Play()
    return tween
end

-- y of the floor under pos (nil if there's nothing within 12 studs)
function behindFxFloor(pos)
    local params = RaycastParams.new()
    params.FilterType = Enum.RaycastFilterType.Exclude
    params.RespectCanCollide = true
    local ignore = {}
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr.Character then
            table.insert(ignore, plr.Character)
        end
    end
    params.FilterDescendantsInstances = ignore
    local hit = workspace:Raycast(pos, Vector3.new(0, -12, 0), params)
    return hit and hit.Position.Y or nil
end

-- glowing ball that swells and fades, with a light that fades with it
function behindFxFlash(pos, startSize, endSize, time, color)
    local ball = behindFxPart(Enum.PartType.Ball, Vector3.new(startSize, startSize, startSize), color, 0.1, CFrame.new(pos))
    local glow = Instance.new("PointLight")
    glow.Color = BEHIND_FX_COLOR
    glow.Range = 22
    glow.Brightness = 4
    glow.Shadows = false
    glow.Parent = ball
    TweenService:Create(glow, TweenInfo.new(time, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), { Brightness = 0 }):Play()
    behindFxTween(ball, time, { Size = Vector3.new(endSize, endSize, endSize), Transparency = 1 })
end

-- vertical beam of light that stretches upward and thins out
function behindFxPillar(pos, height, time)
    local pillar = behindFxPart(
        Enum.PartType.Cylinder,
        Vector3.new(height, 2.2, 2.2),
        BEHIND_FX_COLOR,
        0.25,
        CFrame.new(pos) * CFrame.Angles(0, 0, math.pi / 2)
    )
    behindFxTween(pillar, time, { Size = Vector3.new(height * 1.4, 0.1, 0.1), Transparency = 1 })
end

-- expanding ring lying on the floor (a hollow circle drawn on a flat invisible part)
function behindFxRing(pos, floorY, size, delay)
    task.delay(delay, function()
        local ring = behindFxPart(Enum.PartType.Block, Vector3.new(1, 0.05, 1), BEHIND_FX_COLOR, 1, CFrame.new(pos.X, floorY + 0.1, pos.Z))

        local gui = Instance.new("SurfaceGui")
        gui.Face = Enum.NormalId.Top
        gui.SizingMode = Enum.SurfaceGuiSizingMode.FixedSize
        gui.CanvasSize = Vector2.new(512, 512)
        gui.LightInfluence = 0
        gui.Brightness = 3
        gui.AlwaysOnTop = false
        gui.Parent = ring

        local circle = Instance.new("Frame")
        circle.AnchorPoint = Vector2.new(0.5, 0.5)
        circle.Position = UDim2.fromScale(0.5, 0.5)
        circle.Size = UDim2.fromScale(0.9, 0.9)   -- leaves room so the stroke is never clipped by the canvas
        circle.BackgroundTransparency = 1
        circle.Parent = gui

        local corner = Instance.new("UICorner")
        corner.CornerRadius = UDim.new(0.5, 0)
        corner.Parent = circle

        local stroke = Instance.new("UIStroke")
        stroke.Color = BEHIND_FX_COLOR
        stroke.Thickness = 20
        stroke.Transparency = 0
        stroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
        stroke.Parent = circle

        local info = TweenInfo.new(0.5, Enum.EasingStyle.Quint, Enum.EasingDirection.Out)
        TweenService:Create(stroke, info, { Thickness = 3, Transparency = 1 }):Play()
        behindFxTween(ring, 0.5, { Size = Vector3.new(size, 0.05, size) }, Enum.EasingStyle.Quint, Enum.EasingDirection.Out)
    end)
end

-- omnidirectional burst of glowing sparks
function behindFxSparks(pos, count)
    local anchor = behindFxPart(Enum.PartType.Block, Vector3.new(0.2, 0.2, 0.2), BEHIND_FX_COLOR, 1, CFrame.new(pos))
    local emitter = Instance.new("ParticleEmitter")
    emitter.Color = ColorSequence.new(BEHIND_FX_CORE_COLOR, BEHIND_FX_COLOR)
    emitter.LightEmission = 1
    emitter.LightInfluence = 0
    emitter.Size = NumberSequence.new({
        NumberSequenceKeypoint.new(0, 0.9),
        NumberSequenceKeypoint.new(1, 0),
    })
    emitter.Transparency = NumberSequence.new({
        NumberSequenceKeypoint.new(0, 0),
        NumberSequenceKeypoint.new(0.7, 0.2),
        NumberSequenceKeypoint.new(1, 1),
    })
    emitter.Lifetime = NumberRange.new(0.35, 0.7)
    emitter.Speed = NumberRange.new(14, 38)
    emitter.SpreadAngle = Vector2.new(180, 180)
    emitter.Drag = 3
    emitter.Rotation = NumberRange.new(0, 360)
    emitter.Rate = 0
    emitter.Parent = anchor
    emitter:Emit(count)
    Debris:AddItem(anchor, 1.2)
end

-- bright dash line from where you were to where you land; it passes right through the enemy
function behindFxStreak(a, b)
    local len = (b - a).Magnitude
    if len < 0.5 then return end
    local cf = CFrame.lookAt((a + b) / 2, b)
    local glow = behindFxPart(Enum.PartType.Block, Vector3.new(1.4, 1.4, len), BEHIND_FX_COLOR, 0.55, cf)
    local core = behindFxPart(Enum.PartType.Block, Vector3.new(0.45, 0.45, len), BEHIND_FX_CORE_COLOR, 0, cf)
    behindFxTween(glow, BEHIND_FX_STREAK_TIME, { Size = Vector3.new(0.05, 0.05, len), Transparency = 1 })
    behindFxTween(core, BEHIND_FX_STREAK_TIME * 0.8, { Size = Vector3.new(0.02, 0.02, len), Transparency = 1 }, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
end

-- glowing hologram copies of your body (head, torso, limbs, custom head mesh), left along the dash path
-- and faded out. Must run BEFORE you move, because it copies your body where it stands.
function behindFxAfterimages(character, pathVector)
    local sources = {}
    for _, child in ipairs(character:GetChildren()) do
        if child:IsA("BasePart") and child.Name ~= "HumanoidRootPart" and child.Transparency < 0.95 then
            table.insert(sources, child)
        end
    end

    for _, ghost in ipairs(BEHIND_FX_GHOSTS) do
        local offset = pathVector * ghost.at
        for _, src in ipairs(sources) do
            local made, copy = pcall(function()
                local wasArchivable = src.Archivable
                src.Archivable = true
                local c = src:Clone()
                src.Archivable = wasArchivable
                return c
            end)
            if made and copy then
                -- keep only the mesh that gives the part its shape, nothing else (no joints, decals, scripts, textures)
                for _, child in ipairs(copy:GetChildren()) do
                    if child:IsA("DataModelMesh") then
                        if child:IsA("FileMesh") then
                            child.TextureId = ""
                        end
                    else
                        child:Destroy()
                    end
                end
                if copy:IsA("MeshPart") then
                    copy.TextureID = ""
                end
                copy.Anchored = true
                copy.CanCollide = false
                copy.CanTouch = false
                copy.CanQuery = false
                copy.CastShadow = false
                copy.Material = Enum.Material.Neon
                copy.Color = BEHIND_FX_COLOR
                copy.Transparency = ghost.transparency
                copy.CFrame = src.CFrame + offset
                copy.Parent = workspace
                behindFxTween(copy, BEHIND_FX_GHOST_FADE, { Transparency = 1 })
            end
        end
    end
end

-- the landing hit on the screen: FOV punch, a short blur, and a blue flash
function behindFxScreen()
    local camera = workspace.CurrentCamera
    if camera then
        if activeFovTween then
            activeFovTween:Cancel()
        end
        camera.FieldOfView = BEHIND_FX_FOV_PUNCH
        activeFovTween = TweenService:Create(
            camera,
            TweenInfo.new(0.45, Enum.EasingStyle.Quint, Enum.EasingDirection.Out),
            { FieldOfView = PORTAL_FOV_REST }
        )
        activeFovTween:Play()
    end
    if BEHIND_FX_BLUR > 0 then
        local blur = Instance.new("BlurEffect")
        blur.Name = "RickBehindBlur"
        blur.Size = BEHIND_FX_BLUR
        blur.Parent = Lighting
        behindFxTween(blur, 0.28, { Size = 0 })
    end
    if BEHIND_FX_SCREEN_FLASH > 0 then
        local flash = Instance.new("ColorCorrectionEffect")
        flash.Name = "RickBehindFlash"
        flash.Brightness = BEHIND_FX_SCREEN_FLASH
        flash.TintColor = Color3.fromRGB(190, 220, 255)
        flash.Parent = Lighting
        behindFxTween(flash, 0.35, { Brightness = 0, TintColor = Color3.new(1, 1, 1) })
    end
end

-- everything at the spot you're leaving + the dash line
function behindFxDepart(character, originPos, landPos)
    behindFxAfterimages(character, landPos - originPos)
    behindFxFlash(originPos, 1, 7, 0.22, BEHIND_FX_CORE_COLOR)
    behindFxFlash(originPos, 2, 12, 0.34, BEHIND_FX_COLOR)
    behindFxPillar(originPos, 14, 0.4)
    behindFxSparks(originPos, 28)
    local floorY = behindFxFloor(originPos)
    if floorY then
        behindFxRing(originPos, floorY, BEHIND_FX_RING_SIZE, 0)
    end
    behindFxStreak(originPos, landPos)
end

-- everything where you land
function behindFxArrive(landPos)
    behindFxFlash(landPos, 1.5, 6, 0.2, BEHIND_FX_CORE_COLOR)
    behindFxFlash(landPos, 2, 9, 0.34, BEHIND_FX_COLOR)
    behindFxSparks(landPos, 40)
    local floorY = behindFxFloor(landPos)
    if floorY then
        behindFxRing(landPos, floorY, BEHIND_FX_RING_SIZE, 0)
        behindFxRing(landPos, floorY, BEHIND_FX_RING_SIZE * 1.5, 0.07)
    end
    behindFxScreen()
end

-- the teleport itself: burst, land behind them, highlight, sounds, blink. Returns false if it couldn't.
-- fancy = true (the blue button) adds the full blink FX on top; the auto-dodge leaves it off.
function teleportBehind(attackerChar, playVoice, playStreakVoice, behindDistance, fancy)
    character = LocalPlayer.Character
    humanoid = character and character:FindFirstChildOfClass("Humanoid")
    root = character and character:FindFirstChild("HumanoidRootPart")
    aRoot = attackerChar:FindFirstChild("HumanoidRootPart")
    if not humanoid or humanoid.Health <= 0 or not root or not aRoot then return false end

    local originPos = root.Position
    local useFx = fancy and BEHIND_FX_ENABLED

    -- burst at the spot you're leaving (a missing template never blocks the teleport)
    emitDodgeBurst(root)

    -- land behind them, facing them
    look = flatXZ(aRoot.CFrame.LookVector)
    look = look.Magnitude > 0.01 and look.Unit or Vector3.new(0, 0, -1)
    landPos = aRoot.Position - look * (behindDistance or DODGE_BEHIND_DISTANCE)

    if useFx then
        pcall(behindFxDepart, character, originPos, landPos)
    end

