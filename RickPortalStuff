function behindFxStreak(a, b)
    local len = (b - a).Magnitude
    if len < 0.5 then return end
    local cf = CFrame.lookAt((a + b) / 2, b)
    local glow = behindFxPart(Enum.PartType.Block, Vector3.new(1.4, 1.4, len), BEHIND_FX_COLOR, 0.55, cf)
    local core = behindFxPart(Enum.PartType.Block, Vector3.new(0.45, 0.45, len), BEHIND_FX_CORE_COLOR, 0, cf)
    behindFxTween(glow, BEHIND_FX_STREAK_TIME, { Size = Vector3.new(0.05, 0.05, len), Transparency = 1 })
    behindFxTween(core, BEHIND_FX_STREAK_TIME * 0.8, { Size = Vector3.new(0.02, 0.02, len), Transparency = 1 }, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
end

function behindFxAfterimages(character, pathVector)
    local sources = {}
    for _, child in ipairs(character:GetChildren()) do
        if child:IsA("BasePart") and child.Name ~= "HumanoidRootPart" and child.Transparency < 0.95 then
            table.insert(sources, child)
        end
    end

    for _, ghost in ipairs(BEHIND_FX_GHOSTS) do
        local offset = pathVector * ghost.at
        for _, src in ipairs(sources) do
            local made, copy = pcall(function()
                local wasArchivable = src.Archivable
                src.Archivable = true
                local c = src:Clone()
                src.Archivable = wasArchivable
                return c
            end)
            if made and copy then
                for _, child in ipairs(copy:GetChildren()) do
                    if child:IsA("DataModelMesh") then
                        if child:IsA("FileMesh") then
                            child.TextureId = ""
                        end
                    else
                        child:Destroy()
                    end
                end
                if copy:IsA("MeshPart") then
                    copy.TextureID = ""
                end
                copy.Anchored = true
                copy.CanCollide = false
                copy.CanTouch = false
                copy.CanQuery = false
                copy.CastShadow = false
                copy.Material = Enum.Material.Neon
                copy.Color = BEHIND_FX_COLOR
                copy.Transparency = ghost.transparency
                copy.CFrame = src.CFrame + offset
                copy.Parent = workspace
                behindFxTween(copy, BEHIND_FX_GHOST_FADE, { Transparency = 1 })
            end
        end
    end
end

function behindFxScreen()
    local camera = workspace.CurrentCamera
    if camera then
        if activeFovTween then
            activeFovTween:Cancel()
        end
        camera.FieldOfView = BEHIND_FX_FOV_PUNCH
        activeFovTween = TweenService:Create(
            camera,
            TweenInfo.new(0.45, Enum.EasingStyle.Quint, Enum.EasingDirection.Out),
            { FieldOfView = PORTAL_FOV_REST }
        )
        activeFovTween:Play()
    end
    if BEHIND_FX_BLUR > 0 then
        local blur = Instance.new("BlurEffect")
        blur.Name = "RickBehindBlur"
        blur.Size = BEHIND_FX_BLUR
        blur.Parent = Lighting
        behindFxTween(blur, 0.28, { Size = 0 })
    end
    if BEHIND_FX_SCREEN_FLASH > 0 then
        local flash = Instance.new("ColorCorrectionEffect")
        flash.Name = "RickBehindFlash"
        flash.Brightness = BEHIND_FX_SCREEN_FLASH
