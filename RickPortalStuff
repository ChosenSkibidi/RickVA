------------------------------------------------------------------ HIDING A RESPAWNED BODY
-- hides every part/decal of a model (including ones added later) and remembers the original transparency
local function hideModel(model, rec)
	local function hide(d)
		if (d:IsA("BasePart") or d:IsA("Decal")) and rec[d] == nil then
			rec[d] = d.Transparency
			d.Transparency = 1
		end
	end
	for _, d in ipairs(model:GetDescendants()) do hide(d) end
	return model.DescendantAdded:Connect(hide)
end

local function unhide(rec, conn)
	if conn then conn:Disconnect() end
	for inst, tr in pairs(rec or {}) do
		if inst.Parent then inst.Transparency = tr end
	end
end

