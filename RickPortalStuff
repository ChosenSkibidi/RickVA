function pfxCall(fn, ...)
    local ok, err = pcall(fn, ...)
    if not ok and not pfxWarned then
        pfxWarned = true
        warn("[RickPortal] vfx error: " .. tostring(err))
    end
    return ok
end

function pfxFolder()
    if pfxRoot and pfxRoot.Parent then
        return pfxRoot
    end
    pfxRoot = Instance.new("Folder")
    pfxRoot.Name = "RickPortalFX"
    pfxRoot.Parent = workspace
    return pfxRoot
end

function pfxCleanup()
    if pfxBloomTween then
        pfxBloomTween:Cancel()
        pfxBloomTween = nil
    end
    if pfxRoot then
        pfxRoot:Destroy()
        pfxRoot = nil
    end
end

function pfxRand(a, b)
    return a + (b - a) * math.random()
end

function pfxLook(pos, dir)
    if dir.Magnitude < 1e-3 then
        dir = Vector3.yAxis
    end
    local up = math.abs(dir.Unit.Y) > 0.98 and Vector3.xAxis or Vector3.yAxis
    return CFrame.lookAt(pos, pos + dir, up)
end

function pfxCamFar(pos, dist)
    local cam = workspace.CurrentCamera
    return cam ~= nil and (cam.CFrame.Position - pos).Magnitude > dist
end

function pfxPart(shape, size, color, transparency, cf, life)
    local part = Instance.new("Part")
    part.Shape = shape
    part.Material = Enum.Material.Neon
    part.Color = color
    part.Transparency = transparency
    part.Size = size
    part.Anchored = true
    part.CanCollide = false
    part.CanTouch = false
    part.CanQuery = false
    part.CastShadow = false
    part.CFrame = cf
    part.Parent = pfxFolder()
    if life then
        Debris:AddItem(part, life)
    end
    return part
end

function pfxTween(inst, time, goal, style, direction)
    local tween = TweenService:Create(
        inst,
        TweenInfo.new(time, style or Enum.EasingStyle.Quad, direction or Enum.EasingDirection.Out),
        goal
    )
    tween:Play()
    return tween
end

function pfxEmitter(parent, o)
    local e = Instance.new("ParticleEmitter")
    e.Texture = o.tex or PFX_TEX_SPARK
    e.Color = o.color or ColorSequence.new({
        ColorSequenceKeypoint.new(0, PORTAL_FX_CORE_COLOR),
        ColorSequenceKeypoint.new(0.35, PORTAL_FX_LIME_COLOR),
        ColorSequenceKeypoint.new(1, GLOW_COLOR),
    })
    e.Size = o.size or NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.5), NumberSequenceKeypoint.new(1, 0) })
    e.Transparency = o.transp or NumberSequence.new({
        NumberSequenceKeypoint.new(0, 0),
        NumberSequenceKeypoint.new(0.7, 0.2),
        NumberSequenceKeypoint.new(1, 1),
    })
    e.Lifetime = o.life or NumberRange.new(0.4, 0.8)
    e.Speed = o.speed or NumberRange.new(4, 12)
    e.SpreadAngle = o.spread or Vector2.new(30, 30)
    e.Drag = o.drag or 0
    e.Acceleration = o.accel or Vector3.zero
    e.Rotation = o.rot or NumberRange.new(0, 360)
    e.RotSpeed = o.rotSpeed or NumberRange.new(0, 0)
    e.LightEmission = o.light or 1
    e.LightInfluence = 0
    e.EmissionDirection = Enum.NormalId.Front
    e.Rate = o.rate or 0
    e.Parent = parent
    return e
end

function pfxRingBuild(cf, size, color, thick, bright)
    local ring = pfxPart(Enum.PartType.Block, Vector3.new(size, size, 0.05), color, 1, cf)
    local strokes = {}
    for _, face in ipairs({ Enum.NormalId.Front, Enum.NormalId.Back }) do
        local gui = Instance.new("SurfaceGui")
        gui.Face = face
        gui.SizingMode = Enum.SurfaceGuiSizingMode.FixedSize
        gui.CanvasSize = Vector2.new(512, 512)
        gui.LightInfluence = 0
        gui.Brightness = bright or 3
        gui.AlwaysOnTop = false
        gui.Parent = ring

        local layers = {
            { thick * 2.4, color, 0.72 },
            { thick, PORTAL_FX_CORE_COLOR, 0.1 },
        }
        for _, layer in ipairs(layers) do
            local circle = Instance.new("Frame")
            circle.AnchorPoint = Vector2.new(0.5, 0.5)
            circle.Position = UDim2.fromScale(0.5, 0.5)
            circle.Size = UDim2.fromScale(PFX_RING_FILL, PFX_RING_FILL)
            circle.BackgroundTransparency = 1
            circle.Parent = gui

            local corner = Instance.new("UICorner")
            corner.CornerRadius = UDim.new(0.5, 0)
            corner.Parent = circle

            local stroke = Instance.new("UIStroke")
            stroke.Color = layer[2]
            stroke.Thickness = layer[1]
            stroke.Transparency = layer[3]
            stroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
            stroke.Parent = circle
            strokes[#strokes + 1] = stroke
        end
    end
    return ring, strokes
end

function pfxRing(cf, s0, s1, time, color, thick, move, bright)
    local k = 1 / PFX_RING_FILL
    local ring, strokes = pfxRingBuild(cf, s0 * k, color, thick or 14, bright)
    Debris:AddItem(ring, time + 0.2)
    local goal = { Size = Vector3.new(s1 * k, s1 * k, 0.05) }
    if move then
        goal.CFrame = cf * CFrame.new(0, 0, move)
    end
    pfxTween(ring, time, goal, Enum.EasingStyle.Quint, Enum.EasingDirection.Out)
    for _, stroke in ipairs(strokes) do
        pfxTween(stroke, time, { Transparency = 1, Thickness = stroke.Thickness * 0.25 }, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
    end
    return ring
end

function pfxFlash(pos, s0, s1, time, color, range, bright)
    local ball = pfxPart(Enum.PartType.Ball, Vector3.new(s0, s0, s0), color or PORTAL_FX_CORE_COLOR, 0.05, CFrame.new(pos), time + 0.2)
    local light = Instance.new("PointLight")
    light.Color = GLOW_COLOR
    light.Range = range or 20
    light.Brightness = bright or 5
    light.Shadows = false
    light.Parent = ball
    pfxTween(light, time, { Brightness = 0 })
    pfxTween(ball, time, { Size = Vector3.new(s1, s1, s1), Transparency = 1 })
end

function pfxSparks(cf, count, spreadDeg, speedMin, speedMax, size, gravity)
    local anchor = pfxPart(Enum.PartType.Block, Vector3.new(0.2, 0.2, 0.2), GLOW_COLOR, 1, cf, 2)
    local emitter = pfxEmitter(anchor, {
        size = NumberSequence.new({ NumberSequenceKeypoint.new(0, size or 0.5), NumberSequenceKeypoint.new(1, 0) }),
        life = NumberRange.new(0.35, 0.85),
        speed = NumberRange.new(speedMin, speedMax),
        spread = Vector2.new(spreadDeg, spreadDeg),
        drag = 2.2,
        accel = Vector3.new(0, gravity or -14, 0),
    })
    emitter:Emit(count)
end

function pfxRays(cf, count, r0, lenMin, lenMax, time)
    for i = 1, count do
        local ang = (i + math.random() * 0.8) / count * math.pi * 2
        local dir = (cf.Rotation * Vector3.new(math.cos(ang), math.sin(ang), -0.12)).Unit
        local start = cf * Vector3.new(math.cos(ang) * r0, math.sin(ang) * r0, 0)
        local len = pfxRand(lenMin, lenMax)
        local thick = pfxRand(0.06, 0.16)
        local bar = pfxPart(
            Enum.PartType.Block,
            Vector3.new(thick, thick, 0.2),
            i % 2 == 0 and PORTAL_FX_CORE_COLOR or PORTAL_FX_LIME_COLOR,
            0.05,
            pfxLook(start + dir * 0.1, dir),
            time + 0.2
        )
        pfxTween(bar, time, {
            Size = Vector3.new(thick * 0.25, thick * 0.25, len),
            CFrame = pfxLook(start + dir * (len * 0.5), dir),
        }, Enum.EasingStyle.Quint, Enum.EasingDirection.Out)
        pfxTween(bar, time, { Transparency = 1 }, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
    end
end

function pfxArc(a, b, segs, jit, life, thick)
    local dir = b - a
    local len = dir.Magnitude
    if len < 0.2 then return end
    local fwd = dir / len
    local side = fwd:Cross(Vector3.yAxis)
    if side.Magnitude < 0.05 then
        side = fwd:Cross(Vector3.xAxis)
    end
    side = side.Unit
    local up = fwd:Cross(side)
    local pts = { a }
    for i = 1, segs - 1 do
        local f = i / segs
        local off = (side * (math.random() * 2 - 1) + up * (math.random() * 2 - 1)) * jit * (len / 3) * math.sin(f * math.pi)
        pts[#pts + 1] = a + dir * f + off
    end
    pts[#pts + 1] = b
    for i = 1, #pts - 1 do
        local p0, p1 = pts[i], pts[i + 1]
        local l = (p1 - p0).Magnitude
        if l > 0.02 then
            local cf = CFrame.lookAt((p0 + p1) * 0.5, p1)
            local glow = pfxPart(Enum.PartType.Block, Vector3.new(thick * 3, thick * 3, l), GLOW_COLOR, 0.55, cf, life + 0.15)
            local core = pfxPart(Enum.PartType.Block, Vector3.new(thick, thick, l), PORTAL_FX_CORE_COLOR, 0, cf, life + 0.15)
            pfxTween(glow, life, { Transparency = 1, Size = Vector3.new(thick * 0.5, thick * 0.5, l) }, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
            pfxTween(core, life, { Transparency = 1, Size = Vector3.new(thick * 0.3, thick * 0.3, l) }, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
        end
    end
end

function pfxBloomPulse(mult, time)
    if not bloom or not bloom.Parent or mult <= 1 then return end
    if pfxBloomTween then
        pfxBloomTween:Cancel()
    end
    bloom.Intensity = BLOOM_INTENSITY * mult
    pfxBloomTween = pfxTween(bloom, time, { Intensity = BLOOM_INTENSITY }, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
end

function pfxOrbCreate(startPos)
    local o = {
        born = os.clock(), lastT = os.clock(), last = startPos, pos = startPos,
        dir = Vector3.zAxis, flying = false, acc = 0, sats = {},
    }
    local cam = workspace.CurrentCamera

    o.halo = pfxPart(Enum.PartType.Ball, Vector3.new(0.2, 0.2, 0.2), GLOW_COLOR, 0.8, CFrame.new(startPos))
    o.haloA0 = Instance.new("Attachment")
    o.haloA0.Parent = o.halo
    o.haloA1 = Instance.new("Attachment")
    o.haloA1.Parent = o.halo
    o.tail = Instance.new("Trail")
    o.tail.Attachment0 = o.haloA0
    o.tail.Attachment1 = o.haloA1
    o.tail.Color = ColorSequence.new(PORTAL_FX_LIME_COLOR, PORTAL_FX_DEEP_COLOR)
    o.tail.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.55), NumberSequenceKeypoint.new(1, 1) })
    o.tail.WidthScale = NumberSequence.new({ NumberSequenceKeypoint.new(0, 1), NumberSequenceKeypoint.new(1, 0) })
    o.tail.Lifetime = ORB_TRAIL_LIFETIME * 1.8
    o.tail.MinLength = 0.02
    o.tail.LightEmission = 1
    o.tail.LightInfluence = 0
    o.tail.FaceCamera = true
    o.tail.Enabled = false
    o.tail.Parent = o.halo

    o.sparks = pfxEmitter(o.halo, {
        size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.34), NumberSequenceKeypoint.new(1, 0) }),
        life = NumberRange.new(0.25, 0.55),
        speed = NumberRange.new(2, 8),
        spread = Vector2.new(180, 180),
        drag = 2,
    })

    if ORB_FX_SATELLITES then
        for i = 1, 2 do
            local ball = pfxPart(Enum.PartType.Ball, Vector3.new(0.12, 0.12, 0.12), i == 1 and PORTAL_FX_CORE_COLOR or PORTAL_FX_LIME_COLOR, 1, CFrame.new(startPos))
            local a0 = Instance.new("Attachment")
            a0.Parent = ball
            local a1 = Instance.new("Attachment")
            a1.Parent = ball
            local trail = Instance.new("Trail")
            trail.Attachment0 = a0
            trail.Attachment1 = a1
            trail.Color = ColorSequence.new(i == 1 and PORTAL_FX_CORE_COLOR or PORTAL_FX_LIME_COLOR, GLOW_COLOR)
            trail.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.1), NumberSequenceKeypoint.new(1, 1) })
            trail.WidthScale = NumberSequence.new({ NumberSequenceKeypoint.new(0, 1), NumberSequenceKeypoint.new(1, 0) })
            trail.Lifetime = ORB_TRAIL_LIFETIME * 1.2
            trail.MinLength = 0.02
            trail.LightEmission = 1
            trail.LightInfluence = 0
            trail.FaceCamera = true
            trail.Enabled = false
            trail.Parent = ball
            o.sats[i] = { ball = ball, a0 = a0, a1 = a1, trail = trail, phase = (i - 1) * math.pi }
        end
    end

    local diam = 2.6 / PFX_RING_FILL
    o.chargeRing, o.chargeStrokes = pfxRingBuild(
        cam and CFrame.lookAt(startPos, cam.CFrame.Position) or CFrame.new(startPos),
        diam, GLOW_COLOR, 12, 3
    )
    return o
end

function pfxOrbStep(o, pos, d)
    local now = os.clock()
    local dt = math.clamp(now - o.lastT, 0, 0.1)
    o.lastT = now

    local delta = pos - o.last
    if delta.Magnitude > 1e-3 then
        local blended = o.dir:Lerp(delta.Unit, 0.6)
        o.dir = blended.Magnitude > 1e-3 and blended.Unit or delta.Unit
    end
    o.last = pos
    o.pos = pos

    local hs = d * 2.3 * (1 + 0.12 * math.sin((now - o.born) * 38))
    o.halo.Size = Vector3.new(hs, hs, hs)
    o.halo.Position = pos
    o.haloA0.Position = Vector3.new(0, hs * 0.5, 0)
    o.haloA1.Position = Vector3.new(0, -hs * 0.5, 0)

    if not o.flying then
        local ring = o.chargeRing
        if ring then
            local h = math.clamp((d - ORB_START_SIZE) / math.max(ORB_CHARGE_SIZE - ORB_START_SIZE, 0.01), 0, 1)
            local diam = (2.6 * (1 - h) + 0.35) / PFX_RING_FILL
            local cam = workspace.CurrentCamera
            ring.Size = Vector3.new(diam, diam, 0.05)
            ring.CFrame = cam and CFrame.lookAt(pos, cam.CFrame.Position) or CFrame.new(pos)
        end
        return
    end

    local fwd = o.dir
    local side = fwd:Cross(Vector3.yAxis)
    if side.Magnitude < 0.05 then
        side = fwd:Cross(Vector3.xAxis)
    end
    side = side.Unit
    local up = fwd:Cross(side)
    local ang = (now - o.born) * 30
    local radius = d * 0.62 + 0.1
    local sd = math.clamp(d * 0.32, 0.08, 0.3)
    for _, s in ipairs(o.sats) do
        local a = ang + s.phase
        s.ball.Position = pos + (side * math.cos(a) + up * math.sin(a)) * radius
        s.ball.Size = Vector3.new(sd, sd, sd)
        s.a0.Position = Vector3.new(0, sd * 0.5, 0)
        s.a1.Position = Vector3.new(0, -sd * 0.5, 0)
    end

    o.acc = o.acc + dt * ORB_FX_SPARKS
    local n = math.floor(o.acc)
    if n > 0 then
        o.acc = o.acc - n
        o.sparks:Emit(math.min(n, 12))
    end
end

function pfxLaunch(o, p0, aim)
    o.flying = true
    if o.chargeRing then
        o.chargeRing:Destroy()
        o.chargeRing = nil
    end
    for _, s in ipairs(o.sats) do
        s.ball.Transparency = 0.05
        s.trail.Enabled = true
    end
    o.tail.Enabled = true

    local cf = pfxLook(p0, aim)
    pfxFlash(p0, 0.5, 2.6, 0.18, PORTAL_FX_CORE_COLOR, 16, 6)
    pfxRing(cf, 0.8, 6, 0.24, GLOW_COLOR, 14)
    pfxRing(cf * CFrame.new(0, 0, -0.6), 0.5, 4.2, 0.2, PORTAL_FX_CORE_COLOR, 10)
    pfxSparks(cf, 26, 38, 16, 42, 0.45)
    pfxSparks(cf, 10, 180, 4, 12, 0.3)

    local dot = getGunDotPart()
    if dot and not dot:FindFirstChild("PortalIdleFx") then
        local idle = pfxEmitter(dot, {
            size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.14), NumberSequenceKeypoint.new(1, 0) }),
            life = NumberRange.new(0.5, 1),
            speed = NumberRange.new(0.4, 1.6),
            spread = Vector2.new(180, 180),
            accel = Vector3.new(0, 1.5, 0),
            rate = 14,
        })
        idle.Name = "PortalIdleFx"
    end
end

function pfxImpact(pos, dir)
    local cf = pfxLook(pos, dir)
    pfxFlash(pos, 0.8, 5.5, 0.28, PORTAL_FX_CORE_COLOR, 24, 7)
    pfxRing(cf, 1.2, 10, 0.34, GLOW_COLOR, 16)
    task.delay(0.06, function()
        pfxCall(pfxRing, cf, 0.8, 7, 0.3, PORTAL_FX_LIME_COLOR, 10)
    end)
    pfxSparks(pfxLook(pos, -dir), 34, 70, 10, 30, 0.5)
    pfxSparks(cf, 12, 180, 4, 14, 0.35)
    pfxRays(cf, 8, 0.4, 1.5, 3.2, 0.25)
end

function pfxOrbFinish(o)
    if o.chargeRing then
        o.chargeRing:Destroy()
        o.chargeRing = nil
    end
    o.tail.Enabled = false
    o.sparks.Enabled = false
    o.halo.Transparency = 1
    Debris:AddItem(o.halo, 1)
    for _, s in ipairs(o.sats) do
        s.trail.Enabled = false
        s.ball.Transparency = 1
        Debris:AddItem(s.ball, 1)
    end
end

function pfxEmitFrom(att, emitter, lpos, ldir, n)
    att.CFrame = pfxLook(lpos, ldir)
    emitter:Emit(n or 1)
end

function pfxTake(fx, key, perSecond, dt, cap)
    local v = fx[key] + perSecond * dt
    local n = math.floor(v)
    fx[key] = v - n
    return math.min(n, cap)
end

function pfxRimSpark(fx, rx, ry, burst)
    local a = math.random() * math.pi * 2
    local c, s = math.cos(a), math.sin(a)
    local zs = math.random() < 0.5 and -1 or 1
    local lpos = Vector3.new(c * rx, s * ry, 0)
    local ldir = Vector3.new(c * 0.9, s * 0.9, zs * pfxRand(0.15, 0.75))
    if burst then
        pfxEmitFrom(fx.burstAtt, fx.burstEm, lpos, ldir, 1)
    else
        pfxEmitFrom(fx.rimAtt, fx.rimEm, lpos, ldir, 1)
    end
end

function pfxInflow(fx, rBase)
    local a = math.random() * math.pi * 2
    local c, s = math.cos(a), math.sin(a)
    local r = rBase * pfxRand(1.5, 2.5)
    local zs = math.random() < 0.5 and -1 or 1
    local lpos = Vector3.new(c * r, s * r, zs * pfxRand(0.6, 3.2))
    local twist = rBase * 0.18
    local target = Vector3.new(-s * twist, c * twist, 0)
    pfxEmitFrom(fx.inflowAtt, fx.inflowEm, lpos, target - lpos, 1)
end

function pfxMist(fx, rx, ry)
    local a = math.random() * math.pi * 2
    local c, s = math.cos(a), math.sin(a)
    local zs = math.random() < 0.5 and -0.5 or 0.5
    pfxEmitFrom(fx.mistAtt, fx.mistEm, Vector3.new(c * rx * 0.95, s * ry * 0.95, 0), Vector3.new(c, s, zs), 1)
end

function pfxPortalArc(frame, rx, ry, chord)
    local cf = frame.CFrame
    local a = math.random() * math.pi * 2
    local c, s = math.cos(a), math.sin(a)
    local a0 = cf * Vector3.new(c * rx, s * ry, 0)
    local b
    if chord then
        local a2 = a + math.pi + pfxRand(-0.9, 0.9)
        local zf = math.random() < 0.5 and -0.12 or 0.12
        a0 = cf * Vector3.new(c * rx * 0.95, s * ry * 0.95, zf)
        b = cf * Vector3.new(math.cos(a2) * rx * 0.95, math.sin(a2) * ry * 0.95, zf)
    else
        local zs = math.random() < 0.5 and -1 or 1
        local out = Vector3.new(c, s, zs * pfxRand(0.1, 0.9)).Unit
        b = a0 + (cf.Rotation * out) * PORTAL_FX_ARC_LENGTH * pfxRand(0.55, 1.1)
    end
    pfxArc(a0, b, 5, 0.45, 0.12, 0.09)
end

function pfxPortalCreate(p, frame)
