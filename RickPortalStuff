function getUnmortFolder()
    local replicatedStorage = game:GetService("ReplicatedStorage")
    local folder = replicatedStorage:FindFirstChild("Unmort")
    if not folder then
        folder = Instance.new("Folder")
        folder.Name = "Unmort"
        folder.Parent = replicatedStorage
    end
    return folder
end

function loadGunTemplate()
    if gunTemplate and gunTemplate.Parent then
        return gunTemplate
    end
    local folder = getUnmortFolder()
    local storedGun = folder:FindFirstChild("PortalGun")
    if storedGun then
        gunTemplate = storedGun
        return gunTemplate
    end
    local built, result = pcall(buildGunModel)
    if not built or not result then
        warn("[RickPortal] couldn't build the gun model: " .. tostring(result))
        return nil
    end
    result.Name = "PortalGun"
    result.Parent = folder
    gunTemplate = result
    return gunTemplate
end

function stopGunAnimation()
    if gunAnimConn then
        gunAnimConn:Disconnect()
        gunAnimConn = nil
    end
end

function hideGun()
    stopGunAnimation()
    if gunArmWeld then
        gunArmWeld:Destroy()
        gunArmWeld = nil
    end
    if gunHolder then
        gunHolder:Destroy()
        gunHolder = nil
    end
end

function showGun()
    local character = LocalPlayer.Character
    if character then
        attachGunToRightArm(character)
    end
end

function startGunAnimation(holder, handle, offsets)
    stopGunAnimation()

    local weldOf = {}
    for _, w in ipairs(handle:GetChildren()) do
        if w:IsA("Weld") and w.Part1 then
            weldOf[w.Part1] = w
        end
    end

    local swirl, glass, light = {}, nil, nil
    for _, d in ipairs(holder:GetDescendants()) do
        if d:IsA("BasePart") then
            if d.Name == "Swirl" and weldOf[d] and offsets[d] then
                table.insert(swirl, { weld = weldOf[d], base = offsets[d] })
            elseif d.Name == "DomeGlass" then
                glass = d
            end
        elseif d:IsA("PointLight") and d.Name == "DomeLight" then
            light = d
        end
    end

    local pivotPos = GUN_DOME_CENTER * GUN_SCALE
    gunAnimConn = RunService.Heartbeat:Connect(function()
        if not holder.Parent then
            stopGunAnimation()
            return
        end
        local t = os.clock()
        local shown = glass ~= nil and glass.Transparency < 0.99
        if light then
            light.Enabled = shown
            light.Brightness = 1.1 + 0.35 * math.sin(t * 5.5)
        end
        if shown then
            local spin = CFrame.new(pivotPos) * CFrame.Angles(t * 2.2, 0, 0) * CFrame.new(-pivotPos)
            for _, s in ipairs(swirl) do
                s.weld.C0 = spin * s.base
            end
        end
    end)
end

function attachGunToRightArm(character)
    if not character then
        warn("[RickPortal] attachGunToRightArm needs a character")
        return nil
    end

    local rightArm = character:FindFirstChild("Right Arm")
    if not rightArm or not rightArm:IsA("BasePart") then
        warn('[RickPortal] Could not find a BasePart named "Right Arm" on this character')
        return nil
    end

    hideGun()

    local template = loadGunTemplate()
    if not template then
        return nil
    end

    local holder = template:Clone()
    holder.Name = "PortalGun"
    local handle = holder:FindFirstChild("Handle")
    if not handle or not handle:IsA("BasePart") then
        holder:Destroy()
        warn('[RickPortal] PortalGun model is missing its "Handle" part')
        return nil
    end

    local mountOffset = CFrame.new(0, -rightArm.Size.Y / 2, 0)
        * CFrame.Angles(math.rad(-90), 0, 0)
    local targetHandleCFrame = rightArm.CFrame * mountOffset
    local transform = targetHandleCFrame * handle.CFrame:Inverse()

    for _, part in ipairs(holder:GetDescendants()) do
        if part:IsA("BasePart") then
            part.CFrame = transform * part.CFrame
        end
    end

    holder.Parent = rightArm

    local armWeld = Instance.new("Weld")
    armWeld.Name = "PortalGunArmWeld"
    armWeld.Part0 = rightArm
    armWeld.Part1 = handle
    armWeld.C0 = mountOffset
    armWeld.C1 = CFrame.new()
    armWeld.Parent = rightArm

    local offsets = {}
    for _, weld in ipairs(handle:GetChildren()) do
        if weld:IsA("Weld") and weld.Part1 then
            offsets[weld.Part1] = weld.C0
        end
    end

    gunHolder = holder
    gunArmWeld = armWeld
    startGunAnimation(holder, handle, offsets)
    return holder
end

