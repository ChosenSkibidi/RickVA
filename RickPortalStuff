HEALTH_STALE_TIME = 15
HEALTH_GREEN_AT      = 0.6
HEALTH_YELLOW_AT     = 0.3
HEALTH_GREEN  = Color3.fromRGB(70, 220, 80)
HEALTH_YELLOW = Color3.fromRGB(255, 204, 40)
HEALTH_RED    = Color3.fromRGB(235, 45, 45)
HEALTH_DEAD   = Color3.fromRGB(0, 0, 0)

healthCleanups = {}

function getEntryHumanoid(entry)
    model = entry.player and entry.player.Character or entry.model
    if not model or not model.Parent then
        return nil, nil
    end
    return model:FindFirstChildOfClass("Humanoid"), model
end

function attachHealthBar(entry, fill, pctLabel)
    local destroyed = false
    local tracking = false
    local heartbeatConn = nil
    local watchConns = {}
    local lastHealth, lastMax, lastHum = nil, nil, nil
    local lastChange = os.clock()
    local render, sample, stopTracking, startTracking, wake, bind, clearWatch, playerConns

    function render(hum)
        local frac, color
        local health = hum and hum.Health or 0
        local maxHealth = hum and hum.MaxHealth or 0
        if not hum or health ~= health or health <= 0 or maxHealth <= 0 then
            frac, color = 1, HEALTH_DEAD
        else
            frac = math.clamp(health / maxHealth, 0, 1)
            if frac >= HEALTH_GREEN_AT then
                color = HEALTH_GREEN
            elseif frac >= HEALTH_YELLOW_AT then
                color = HEALTH_YELLOW
            else
                color = HEALTH_RED
            end
        end
        fill.Size = UDim2.new(frac, 0, 1, 0)
        fill.BackgroundColor3 = color
        if pctLabel then
            if color == HEALTH_DEAD then
                pctLabel.Text = "DEAD"
            else
                pctLabel.Text = math.max(1, math.floor(frac * 100 + 0.5)) .. "%"
            end
            pctLabel.TextColor3 = color == HEALTH_DEAD and Color3.fromRGB(150, 150, 150) or color
        end
    end

    function sample()
        local hum = getEntryHumanoid(entry)
        local health = hum and hum.Health or -1
        local maxHealth = hum and hum.MaxHealth or -1
        if hum == lastHum and health == lastHealth and maxHealth == lastMax then
            return false
        end
        lastHum, lastHealth, lastMax = hum, health, maxHealth
        render(hum)
        return true
    end

    function stopTracking()
        tracking = false
        if heartbeatConn then
            heartbeatConn:Disconnect()
            heartbeatConn = nil
        end
    end

    function startTracking()
        if tracking or destroyed then return end
        tracking = true
        lastChange = os.clock()
        heartbeatConn = RunService.Heartbeat:Connect(function()
            if not fill.Parent then
                stopTracking()
                return
            end
            if sample() then
                lastChange = os.clock()
            elseif os.clock() - lastChange >= HEALTH_STALE_TIME then
                stopTracking()
            end
        end)
    end

    function wake()
        if destroyed or not fill.Parent then return end
        sample()
        lastChange = os.clock()
        startTracking()
    end

    function clearWatch()
        for _, c in ipairs(watchConns) do
            c:Disconnect()
        end
        table.clear(watchConns)
    end

    bind = function()
        clearWatch()
        local hum, model = getEntryHumanoid(entry)
        if hum then
            table.insert(watchConns, hum.HealthChanged:Connect(wake))
            table.insert(watchConns, hum:GetPropertyChangedSignal("MaxHealth"):Connect(wake))
            table.insert(watchConns, hum.Died:Connect(wake))
        end
        if model then
            table.insert(watchConns, model.ChildAdded:Connect(function(child)
                if child:IsA("Humanoid") then
                    bind()
                    wake()
                end
            end))
        end
    end

    playerConns = {}
    if entry.player then
        table.insert(playerConns, entry.player.CharacterAdded:Connect(function()
            task.defer(function()
                if destroyed then return end
                bind()
                wake()
            end)
        end))
        table.insert(playerConns, entry.player.CharacterRemoving:Connect(wake))
    end

    bind()
    sample()
    startTracking()

    table.insert(healthCleanups, function()
        destroyed = true
        stopTracking()
        clearWatch()
        for _, c in ipairs(playerConns) do
            c:Disconnect()
        end
    end)
end

