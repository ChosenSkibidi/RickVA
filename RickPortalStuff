function pfxPortalBurst(p, frame)
    local fx = p.fx
    local cf = frame.CFrame
    local base = PORTAL_SIZE
    local rx, ry = base * 0.5 * widthScale, base * 0.5

    pfxFlash(cf.Position, 2, base * 1.1, 0.4, PORTAL_FX_CORE_COLOR, 30, 8)
    for i = 1, 3 do
        task.delay((i - 1) * 0.07, function()
            pfxCall(
                pfxRing, cf, base * 0.35, base * (1.5 + i * 0.35), 0.5 + i * 0.12,
                i == 2 and PORTAL_FX_CORE_COLOR or GLOW_COLOR, 16 - i * 2, -0.5 * i
            )
        end)
    end
    pfxRays(cf, 16, base * 0.5, 2.5, 6.5, 0.35)
    for _ = 1, 6 do
        pfxPortalArc(frame, rx, ry, false)
    end
    for _ = 1, PORTAL_FX_OPEN_SPARKS do
        pfxRimSpark(fx, rx, ry, true)
    end
    for _ = 1, 8 do
        pfxMist(fx, rx, ry)
    end
    pfxBloomPulse(PORTAL_FX_BLOOM_PULSE, 0.7)
end

function pfxPortalUpdate(p, frame)
    local fx = p.fx
    if not fx or not frame.Parent then return end
    local now = os.clock()
    local dt = math.clamp(now - fx.last, 0, 0.1)
    fx.last = now

    local cf = frame.CFrame
    local fw, fh = frame.Size.X, frame.Size.Y
    local rx, ry = fw * 0.5, fh * 0.5
    local closing = p.state == "closing"
    local age = now - fx.born
    local sizeK = math.clamp(math.max(fw, fh) / PORTAL_SIZE, 0, 1.3)
    local boost = age < PORTAL_FX_OPEN_BOOST_TIME and PORTAL_FX_OPEN_BOOST or 1
    local rBase = PORTAL_SIZE * 0.5
    local swallow = math.clamp(1 - (now - fx.swallow) / 0.45, 0, 1)

    local flick = 0.5 + 0.5 * math.noise(now * 7, fx.seed)
    if fx.glow then
        fx.glow.Size = Vector3.new(fw / PFX_RING_FILL, fh / PFX_RING_FILL, 0.05)
        for i, stroke in ipairs(fx.glowStrokes) do
            if i % 2 == 1 then
                stroke.Transparency = 0.82 - 0.28 * flick - 0.3 * swallow
            else
                stroke.Transparency = 0.2 + 0.35 * (1 - flick) - 0.15 * swallow
            end
        end
    end
    if p.light then
        p.light.Brightness = p.light.Brightness * (0.82 + 0.36 * flick) + swallow * 4
    end

    if pfxCamFar(cf.Position, 350) then return end

    for _ = 1, pfxTake(fx, "rim", PORTAL_FX_RIM_SPARKS * boost * sizeK * (closing and 0.6 or 1), dt, 14) do
        pfxRimSpark(fx, rx, ry, false)
    end
    for _ = 1, pfxTake(fx, "inflow", PORTAL_FX_INFLOW * boost * (closing and PORTAL_FX_CLOSE_INFLOW_MULT or 1), dt, 24) do
        pfxInflow(fx, rBase)
    end
    for _ = 1, pfxTake(fx, "mist", PORTAL_FX_MIST * sizeK, dt, 4) do
        pfxMist(fx, rx, ry)
    end

    local arcRate = PORTAL_FX_ARCS * sizeK * (closing and 3 or 1) * (age < PORTAL_FX_OPEN_BOOST_TIME and 3 or 1)
    for _ = 1, pfxTake(fx, "arc", arcRate, dt, 2) do
        pfxCall(pfxPortalArc, frame, rx, ry, math.random() < 0.4)
    end

    if not closing then
        fx.ripple = fx.ripple - dt
        if fx.ripple <= 0 then
            fx.ripple = PORTAL_FX_RIPPLE_EVERY
            local diam = math.max(fw, fh)
            pfxCall(pfxRing, cf, diam, diam * 1.5, 0.95, GLOW_COLOR, 8, -1.8)
        end
    end
end

function pfxPortalSnap(p, frame)
    if not p.fx then return end
    local cf = frame.CFrame
    pfxFlash(cf.Position, 0.5, 3.6, 0.28, PORTAL_FX_CORE_COLOR, 18, 6)
    pfxRing(cf, 0.6, PORTAL_SIZE * 0.5, 0.35, PORTAL_FX_CORE_COLOR, 12)
    pfxSparks(cf, PORTAL_FX_CLOSE_SPARKS, 55, 10, 28, 0.42)
    pfxSparks(cf * CFrame.Angles(0, math.pi, 0), PORTAL_FX_CLOSE_SPARKS, 55, 10, 28, 0.42)
    pfxSparks(cf, 12, 180, 3, 10, 0.3)
    for _ = 1, 3 do
        pfxPortalArc(frame, 1.4, 1.4, false)
    end
end

function pfxPortalSwallow(p)
    local fx = p.fx
    local frame = p.frame
    if not fx or not frame or not frame.Parent then return end
    fx.swallow = os.clock()
    local cf = frame.CFrame
    local rx, ry = frame.Size.X * 0.5, frame.Size.Y * 0.5
    pfxFlash(cf.Position, 3, PORTAL_SIZE * 0.9, 0.3, PORTAL_FX_CORE_COLOR, 26, 7)
    pfxRing(cf, PORTAL_SIZE * 0.9, PORTAL_SIZE * 1.9, 0.45, PORTAL_FX_CORE_COLOR, 16, -1.2)
    for _ = 1, 18 do
        pfxRimSpark(fx, rx, ry, true)
    end
    pfxBloomPulse(1.6, 0.45)
end

function shootOrb(fromPos, toPos, travelTime)
    local dotPart = getGunDotPart()
    local lastDot = dotPart and dotPart.Position or fromPos
    local function dotPos()
        if dotPart and dotPart.Parent then
            lastDot = dotPart.Position
        end
        return lastDot
    end

    local function makeBall(color, transparency)
        local ball = Instance.new("Part")
        ball.Shape = Enum.PartType.Ball
        ball.Material = Enum.Material.Neon
        ball.Color = color
        ball.Transparency = transparency
        ball.Size = Vector3.new(ORB_START_SIZE, ORB_START_SIZE, ORB_START_SIZE)
        ball.Anchored = true
        ball.CanCollide = false
        ball.CanTouch = false
        ball.CanQuery = false
        ball.CastShadow = false
        ball.Position = lastDot
        ball.Parent = workspace
        return ball
    end

    local shell = makeBall(GLOW_COLOR, 0.1)
    local core = makeBall(Color3.fromRGB(235, 255, 225), 0)

    local orbFx = nil
    if PORTAL_FX_ENABLED then
        local okFx, resFx = pcall(pfxOrbCreate, lastDot)
        if okFx then
            orbFx = resFx
        else
            warn("[RickPortal] orb vfx failed: " .. tostring(resFx))
        end
    end

    local light = Instance.new("PointLight")
    light.Color = GLOW_COLOR
    light.Range = 10
    light.Brightness = 0
    light.Shadows = false
    light.Parent = shell

    local trailTop = Instance.new("Attachment")
    trailTop.Parent = shell
    local trailBottom = Instance.new("Attachment")
    trailBottom.Parent = shell
    local trail = Instance.new("Trail")
    trail.Attachment0 = trailTop
    trail.Attachment1 = trailBottom
    trail.Color = ColorSequence.new(Color3.fromRGB(215, 255, 200), GLOW_COLOR)
    trail.Transparency = NumberSequence.new({
        NumberSequenceKeypoint.new(0, 0.05),
        NumberSequenceKeypoint.new(1, 1),
    })
    trail.WidthScale = NumberSequence.new({
        NumberSequenceKeypoint.new(0, 1),
        NumberSequenceKeypoint.new(1, 0),
    })
    trail.Lifetime = ORB_TRAIL_LIFETIME
    trail.MinLength = 0.02
    trail.LightEmission = 1
    trail.LightInfluence = 0
    trail.FaceCamera = true
    trail.Enabled = false
    trail.Parent = shell

    local function place(pos, d)
        shell.Size = Vector3.new(d, d, d)
        shell.Position = pos
        local c = d * 0.55
        core.Size = Vector3.new(c, c, c)
        core.Position = pos
        trailTop.Position = Vector3.new(0, d * 0.5, 0)
        trailBottom.Position = Vector3.new(0, -d * 0.5, 0)
        light.Brightness = 2.2 * math.clamp(d / ORB_PEAK_SIZE, 0, 1)
        if orbFx then pfxCall(pfxOrbStep, orbFx, pos, d) end
    end

    local ease = ORB_EASE_IN_FRAC
    local v0 = ORB_START_SPEED
    local norm = 1 - ease * 0.5 * (1 - v0)
    local function progress(x)
        local covered
        if x < ease then
            local u = x / ease
            covered = v0 * x + (1 - v0) * ease * (u * u * u - u * u * u * u * 0.5)
        else
            covered = v0 * ease + (1 - v0) * ease * 0.5 + (x - ease)
        end
        return covered / norm
    end

    local ok, err = pcall(function()
        local holdStart = os.clock()
        while true do
            local raw = (os.clock() - holdStart) / ORB_HOLD_TIME
            local h = math.clamp(raw, 0, 1)
            h = h * h * (3 - 2 * h)
            place(dotPos(), ORB_START_SIZE + (ORB_CHARGE_SIZE - ORB_START_SIZE) * h)
            if raw >= 1 then break end
            RunService.RenderStepped:Wait()
        end

        local p0 = dotPos()
        local p3 = toPos
        local toTarget = p3 - p0
        local dist = toTarget.Magnitude
        local aim = dist > 0.01 and toTarget.Unit or Vector3.zAxis

        local exitDir = (aim + Vector3.yAxis * ORB_EXIT_UP).Unit
        local p1 = p0 + exitDir * (dist * ORB_P1_REACH)
        local p2 = p3 - aim * (dist * ORB_P2_REACH)

        local steps = 32
        local lens = { 0 }
        local prev = p0
        for i = 1, steps do
            local pt = orbBezier(p0, p1, p2, p3, i / steps)
            lens[i + 1] = lens[i] + (pt - prev).Magnitude
            prev = pt
        end
        local total = lens[steps + 1]

        local function curveParam(s)
            local want = s * total
            local lo, hi = 1, steps + 1
            while hi - lo > 1 do
                local mid = math.floor((lo + hi) / 2)
                if lens[mid] <= want then lo = mid else hi = mid end
            end
            local seg = lens[hi] - lens[lo]
            local f = seg > 1e-6 and (want - lens[lo]) / seg or 0
            return ((lo - 1) + f) / steps
        end

        orbPop(p0, ORB_CHARGE_SIZE, ORB_PEAK_SIZE * 2.2, 0.14, GLOW_COLOR)
        if orbFx then pfxCall(pfxLaunch, orbFx, p0, aim) end
        trail.Enabled = true

        local flightStart = os.clock()
        while true do
            local x = math.clamp((os.clock() - flightStart) / travelTime, 0, 1)
            local pos = orbBezier(p0, p1, p2, p3, curveParam(progress(x)))

            local follow = math.clamp(x / ORB_FOLLOW_FRAC, 0, 1)
            follow = 1 - follow * follow * (3 - 2 * follow)
            if follow > 0 then
                pos = pos + (dotPos() - p0) * follow
            end

            local swell = math.clamp(x / ORB_SWELL_FRAC, 0, 1)
            swell = swell * swell * (3 - 2 * swell)
            local shrink = math.clamp((x - ORB_SWELL_FRAC) / (1 - ORB_SWELL_FRAC), 0, 1)
            local d = ORB_CHARGE_SIZE + (ORB_PEAK_SIZE - ORB_CHARGE_SIZE) * swell
            d = d + (ORB_END_SIZE - d) * shrink * shrink

            place(pos, d)

            if x >= 1 then break end
            RunService.RenderStepped:Wait()
        end
    end)

    if orbFx then
        if ok then pfxCall(pfxImpact, toPos, orbFx.dir) end
        pfxCall(pfxOrbFinish, orbFx)
    end

    trail.Enabled = false
    light:Destroy()
    core:Destroy()
    shell.Transparency = 1
    task.delay(ORB_TRAIL_LIFETIME + 0.1, function()
        shell:Destroy()
    end)
    if not ok then error(err, 0) end
end

function buildPortal(portalCF, decorative, onWall, p, frame, light, enter)
    p = { state = "opening", stateStart = os.clock(), spawnTime = os.clock(), armed = false, decorative = decorative, onWall = onWall }
    if not decorative then
        snapFieldOfView()
    end

    p.wallParts = {}
    if onWall and not decorative then
        overlap = OverlapParams.new()
        overlap.FilterType = Enum.RaycastFilterType.Exclude
        ignore = {}
        for _, plr in ipairs(Players:GetPlayers()) do
            if plr.Character then
                table.insert(ignore, plr.Character)
            end
        end
        overlap.FilterDescendantsInstances = ignore
        cutCF = portalCF * CFrame.new(0, 0, WALL_CUT_DEPTH / 2)
        found = workspace:GetPartBoundsInBox(cutCF, Vector3.new(TRIGGER_SIZE.X, TRIGGER_SIZE.Y, WALL_CUT_DEPTH), overlap)
        for _, part in ipairs(found) do
            if part.CanCollide and not part:IsA("Terrain") then
                table.insert(p.wallParts, part)
                part.CanCollide = false
            end
        end
    end
    p.touchMode = onWall and not decorative and #p.wallParts == 0

    frame = Instance.new("Part")
    frame.Name = "RickPortal"
    frame.Transparency = 1
    frame.Size = Vector3.new(0.05, 0.05, DISC_THICKNESS)
    frame.Anchored = true
    frame.CanCollide = false
    frame.CanTouch = false
    frame.CanQuery = false
    frame.CastShadow = false
    frame.CFrame = portalCF

    p.labels = {
        makeFace(frame, Enum.NormalId.Front),
        makeFace(frame, Enum.NormalId.Back),
    }

    light = Instance.new("PointLight")
    light.Color = GLOW_COLOR
    light.Range = 0
    light.Brightness = 0
    light.Shadows = false
    light.Parent = frame
    p.light = light

    TweenService:Create(
        light,
        TweenInfo.new(LIGHT_TWEEN_TIME, Enum.EasingStyle.Quint, Enum.EasingDirection.Out),
        { Range = LIGHT_RANGE }
    ):Play()

    frame.Parent = workspace
    p.frame = frame
    pfxCall(pfxPortalCreate, p, frame)
    playSounds(OPEN_SOUNDS, frame)
    if decorative and EXIT_SOUND.asset then
        playSounds({ { id = EXIT_SOUND.asset, volume = EXIT_PORTAL_SOUND_VOLUME } }, frame)
    end

    function enter(root, area, tRoot, portalSpot, toTarget, landPos, retPos)
        area = chosenArea
        chosenArea = nil

        if area then
            chosenTarget = nil
            p.armed = false
            pfxCall(pfxPortalSwallow, p)
            hideGun()
            if area.serverJoin then
                snapFieldOfView()
                joinServer(area.serverJoin)
                closePortal(p)
                return
            end
            teleportToArea(root, area, p)
            return
        end

        tRoot = (chosenTarget and chosenTarget:IsDescendantOf(workspace)) and chosenTarget or pickTarget()
        chosenTarget = nil
        if not tRoot then
            warn("[RickPortal] no other player to teleport to")
            return
        end

        p.armed = false
        pfxCall(pfxPortalSwallow, p)
        hideGun()
        portalSpot = (tRoot.CFrame * CFrame.new(0, 0, ARRIVE_DISTANCE + RETURN_PORTAL_OFFSET - EXIT_PORTAL_FRONT_DISTANCE)).Position
        toTarget = Vector3.new(tRoot.Position.X - portalSpot.X, 0, tRoot.Position.Z - portalSpot.Z)
        toTarget = toTarget.Magnitude > 0.01 and toTarget.Unit or Vector3.new(0, 0, -1)
        landPos = portalSpot - toTarget * EXIT_PORTAL_BEHIND_DISTANCE
        snapFieldOfView()
        teleportOut(root, landPos, tRoot.Position, true)
        closePortal(p)

        retPos = Vector3.new(portalSpot.X, tRoot.Position.Y + SPAWN_HEIGHT, portalSpot.Z)
        buildPortal(CFrame.lookAt(retPos, retPos + toTarget), true)
    end

    p.conn = RunService.Heartbeat:Connect(function()
        now = os.clock()
        t = now - p.stateStart
        w, h = nil, nil

        if not p.decorative and p.state ~= "closing" then
            char = LocalPlayer.Character
            root = char and char:FindFirstChild("HumanoidRootPart")
            if root and p.touchMode then
                if p.armed then
                    overlap = OverlapParams.new()
                    overlap.FilterType = Enum.RaycastFilterType.Include
                    overlap.FilterDescendantsInstances = { char }
                    if #workspace:GetPartBoundsInBox(portalCF, TRIGGER_SIZE, overlap) > 0 then
                        enter(root)
                    end
                end
            elseif root then
                rel = portalCF:PointToObjectSpace(root.Position)
                prev = p.lastRel
                p.lastRel = rel

                if p.startSide == nil then
                    p.startSide = rel.Z >= 0 and 1 or -1
                elseif math.abs(rel.Z) > ENTER_DEPTH + 1 then
                    p.startSide = rel.Z > 0 and 1 or -1
                end

                if p.armed and prev then
                    dPrev = -p.startSide * prev.Z
                    dNow = -p.startSide * rel.Z
                    if dPrev < ENTER_DEPTH and dNow >= ENTER_DEPTH then
                        alpha = (ENTER_DEPTH - dPrev) / (dNow - dPrev)
                        crossX = prev.X + (rel.X - prev.X) * alpha
                        crossY = prev.Y + (rel.Y - prev.Y) * alpha
                        if math.abs(crossX) <= TRIGGER_SIZE.X / 2 and math.abs(crossY) <= TRIGGER_SIZE.Y / 2 then
                            enter(root)
                        end
                    end
                end
            else
                p.lastRel = nil
            end
        end

        if p.state == "opening" then
            w = PORTAL_SIZE * bounce(t)
            h = PORTAL_SIZE * bounce(t - STAGGER)
            if t >= ARM_DELAY and not p.decorative then p.armed = true end
            if t >= OPEN_TIME then
                if p.decorative then
                    closePortal(p)
                else
                    p.state = "open"
                    p.stateStart = now
                end
            end
        elseif p.state == "open" then
            w = PORTAL_SIZE * (1 + PULSE_AMOUNT * math.sin(t * PULSE_SPEED))
            h = PORTAL_SIZE * (1 + PULSE_AMOUNT * math.sin(t * PULSE_SPEED + 1.2))
            if t >= PORTAL_LIFETIME then
                closePortal(p)
            end
        else
            u = math.clamp(t / CLOSE_TIME, 0, 1)
            w = PORTAL_SIZE * (1 - TweenService:GetValue(u, Enum.EasingStyle.Back, Enum.EasingDirection.In))
            h = PORTAL_SIZE * (1 - TweenService:GetValue(math.min(u * 1.25, 1), Enum.EasingStyle.Back, Enum.EasingDirection.In))
            if u >= 1 then
                pfxCall(pfxPortalSnap, p, frame)
                destroyPortal(p)
                return
            end
        end

        w = math.max(w, 0.05)
        h = math.max(h, 0.05)

        frame.Size = Vector3.new(w * widthScale, h, DISC_THICKNESS)

        rot = ((now - p.spawnTime) * SPIN_SPEED) % 360
        for _, lbl in ipairs(p.labels) do
            lbl.Rotation = rot
        end
        light.Brightness = LIGHT_BRIGHTNESS * math.clamp(w / PORTAL_SIZE, 0, 1.3)
        if p.fx then pfxCall(pfxPortalUpdate, p, frame) end
    end)

    portals[p] = true
    return p
end

function emergeFromFloor(root, portalPos, normal, look, upSpeed, fwdSpeed, character, hum, charParts, prevPlatformStand, sunkPos, launchUp, forwardApplied, done, launched, launchTime, conn, finish)
    upSpeed = upSpeed or FAILSAFE_LAUNCH_UP
    fwdSpeed = fwdSpeed or FAILSAFE_LAUNCH_FWD
    character = root.Parent
    hum = character and character:FindFirstChildOfClass("Humanoid")
    if not character or not hum then return end

    charParts = {}
    for _, d in ipairs(character:GetDescendants()) do
        if d:IsA("BasePart") then
            charParts[d] = d.CanCollide
            d.CanCollide = false
        end
    end
    prevPlatformStand = hum.PlatformStand
    hum.PlatformStand = true

    sunkPos = portalPos - normal * FAILSAFE_SINK_DEPTH
    root.CFrame = CFrame.lookAt(sunkPos, sunkPos + look)
    root.AssemblyLinearVelocity = Vector3.zero
    root.Anchored = true

    launchUp = Vector3.new(0, upSpeed, 0)
    forwardApplied = false
    done = false
    launched = false
    launchTime = 0
    conn = nil

    function finish()
        if done then return end
        done = true
        if conn then
            conn:Disconnect()
            conn = nil
        end
        if root.Parent then
            root.Anchored = false
        end
        for part, original in pairs(charParts) do
            if part.Parent then
                part.CanCollide = original
            end
        end
        if hum.Parent then
            hum.PlatformStand = prevPlatformStand
            hum:ChangeState(Enum.HumanoidStateType.Freefall)
        end
    end

    conn = RunService.Stepped:Connect(function()
        if not character.Parent or not root.Parent or hum.Health <= 0 then
            finish()
            return
        end
        for part in pairs(charParts) do
            if part.Parent and part.CanCollide then
                part.CanCollide = false
            end
        end
        if launched then
            height = (root.Position - portalPos):Dot(normal)
            if not forwardApplied and height >= 0 then
                forwardApplied = true
                if fwdSpeed > 0 then
                    v = root.AssemblyLinearVelocity
                    root.AssemblyLinearVelocity = Vector3.new(look.X * fwdSpeed, v.Y, look.Z * fwdSpeed)
                end
            end
            if height >= 3 or os.clock() - launchTime > 2 then
                finish()
            end
        end
    end)

    task.delay(FAILSAFE_SINK_HOLD, function()
        if done or not root.Parent then return end
        root.Anchored = false
        root.AssemblyLinearVelocity = launchUp
        launched = true
        launchTime = os.clock()
        RunService.Heartbeat:Once(function()
            if not done and not forwardApplied and root.Parent then
                root.AssemblyLinearVelocity = launchUp
            end
        end)
    end)
end

teleportToArea = function(root, area, fromPortal, opts, origin, flat, look, landPos, floorExit, pos, faceAt, toFace, floorPos, rayParams, ignore, hit, behind, portalPos, retPos)

    origin = root.CFrame
    flat = Vector3.new(origin.LookVector.X, 0, origin.LookVector.Z)
    look = flat.Magnitude > 0.01 and flat.Unit or Vector3.new(0, 0, -1)
    landPos = area.cframe.Position
    floorExit = opts and opts.floorExit

    if area.resolve then
        pos, faceAt = area.resolve()
        if pos then
            landPos = pos
            if faceAt then
                toFace = Vector3.new(faceAt.X - pos.X, 0, faceAt.Z - pos.Z)
                if toFace.Magnitude > 0.01 then
                    look = toFace.Unit
                end
            end
        end
    end

    floorPos = nil
    if floorExit then
        rayParams = RaycastParams.new()
        rayParams.FilterType = Enum.RaycastFilterType.Exclude
        rayParams.RespectCanCollide = true
        ignore = {}
        for _, plr in ipairs(Players:GetPlayers()) do
            if plr.Character then
                table.insert(ignore, plr.Character)
            end
        end
        rayParams.FilterDescendantsInstances = ignore
        hit = workspace:Raycast(landPos + Vector3.new(0, 5, 0), Vector3.new(0, -40, 0), rayParams)
        floorPos = hit and hit.Position or (landPos - Vector3.new(0, 3, 0))
        landPos = Vector3.new(landPos.X, floorPos.Y + 2.5, landPos.Z)
    end

    snapFieldOfView()
    if floorExit then
        teleportOut(root, landPos, landPos + look, false, true)
    else
        behind = landPos - look * EXIT_PORTAL_BEHIND_DISTANCE
        teleportOut(root, behind, behind + look, true)
    end
    if fromPortal then
        closePortal(fromPortal)
    end

    if floorExit then
        portalPos = floorPos + Vector3.new(0, WALL_OFFSET, 0)
        buildPortal(CFrame.lookAt(portalPos, portalPos + Vector3.yAxis, Vector3.zAxis), true)

        emergeFromFloor(root, portalPos, Vector3.yAxis, look, opts.upSpeed, opts.fwdSpeed)
    else
        retPos = Vector3.new(landPos.X, landPos.Y + SPAWN_HEIGHT, landPos.Z)
        buildPortal(CFrame.lookAt(retPos, retPos + look), true)
    end

    if area.onArrive then
        task.spawn(area.onArrive)
    end
end

-- ---------------------------------------------------------------------------
-- Server codes (portal gun only)
-- Server info is packed into an opaque "RPG2-XXXXXX-..." code with a private
-- encoder. It is not a script, so running it does nothing; only this portal
-- gun can decode it and turn it into a server join.
-- Pipeline: pack fields -> add checksum -> keyed chained cipher
--           -> private shuffled base-32 alphabet -> tagged, dashed groups.
-- ---------------------------------------------------------------------------
do
    local CODE_TAG   = "RPG2"
    local KEY        = "r1ck-p0rt4l-gun::c-137::wubba-lubba-dub-dub"
    local MOD        = 4294967296
    local ALPHA_BASE = "ABCDEFGHJKLMNPQRSTUVWXYZ23456789"
    local SEP        = "\31"
    local FIELD_COUNT = 8

    -- 32-bit string hash (multiplier kept small so h * M stays under 2^53)
    local function hash32(s, seed)
        local h = seed
        for i = 1, #s do
            h = bit32.bxor(h, string.byte(s, i))
            h = (h * 1000003) % MOD
            h = bit32.bxor(h, bit32.rshift(h, 15))
        end
        return h
    end

    -- keystream: xorshift32 seeded from a hash
    local function newStream(seed)
        local x = seed
        if x == 0 then x = 0x9E3779B9 end
        return function()
            x = bit32.bxor(x, bit32.lshift(x, 13))
            x = bit32.bxor(x, bit32.rshift(x, 17))
            x = bit32.bxor(x, bit32.lshift(x, 5))
            return bit32.band(bit32.rshift(x, 11), 255)
        end
    end

    -- private alphabet: the base set shuffled with a key-driven stream
    local ALPHABET, DECODE = {}, {}
    do
        local chars = {}
        for i = 1, #ALPHA_BASE do
            chars[i] = string.sub(ALPHA_BASE, i, i)
        end
        local nextByte = newStream(hash32(KEY, 2166136261))
        for i = #chars, 2, -1 do
            local j = (nextByte() * 256 + nextByte()) % i + 1
            chars[i], chars[j] = chars[j], chars[i]
        end
        for i, c in ipairs(chars) do
            ALPHABET[i - 1] = c
            DECODE[c] = i - 1
        end
    end

    local NONCE_MASK = {}
    do
        local m = hash32(KEY, 305419896)
        for i = 1, 4 do
            NONCE_MASK[i] = bit32.band(bit32.rshift(m, (i - 1) * 8), 255)
        end
    end
    local CHECK_SEED = hash32(KEY, 1540483477)

    local function strToBytes(s)
        local t = table.create and table.create(#s) or {}
        for i = 1, #s do
            t[i] = string.byte(s, i)
        end
        return t
    end

    local function bytesToStr(t)
        local parts = {}
        for i = 1, #t, 200 do
            parts[#parts + 1] = string.char(table.unpack(t, i, math.min(i + 199, #t)))
        end
        return table.concat(parts)
    end

    local function split(s, sep)
        local parts, start = {}, 1
        while true do
            local i = string.find(s, sep, start, true)
            if not i then
                parts[#parts + 1] = string.sub(s, start)
                break
            end
            parts[#parts + 1] = string.sub(s, start, i - 1)
            start = i + 1
        end
        return parts
    end

    -- bytes -> private base-32 symbols
    local function toSymbols(bytes)
        local out, acc, bits = {}, 0, 0
        for i = 1, #bytes do
            acc = acc * 256 + bytes[i]
            bits = bits + 8
            while bits >= 5 do
                bits = bits - 5
                local div = 2 ^ bits
                local v = math.floor(acc / div)
                acc = acc - v * div
                out[#out + 1] = ALPHABET[v]
            end
        end
        if bits > 0 then
            out[#out + 1] = ALPHABET[acc * 2 ^ (5 - bits)]
        end
        return table.concat(out)
    end

    local function fromSymbols(str)
        local bytes, acc, bits = {}, 0, 0
        for i = 1, #str do
            local v = DECODE[string.sub(str, i, i)]
            if not v then return nil end
            acc = acc * 32 + v
            bits = bits + 5
            if bits >= 8 then
                bits = bits - 8
                local div = 2 ^ bits
                local b = math.floor(acc / div)
                acc = acc - b * div
                bytes[#bytes + 1] = b
            end
        end
        return bytes
    end

    -- chained cipher: each byte depends on the keystream and the previous
    -- cipher byte, so a changed character breaks everything after it
    local function scramble(bytes, seed)
        local nextByte, prev, out = newStream(seed), 0, {}
        for i = 1, #bytes do
            local c = (bytes[i] + nextByte() + prev) % 256
            out[i] = c
            prev = c
        end
        return out
    end

    local function unscramble(bytes, seed)
        local nextByte, prev, out = newStream(seed), 0, {}
        for i = 1, #bytes do
            out[i] = (bytes[i] - nextByte() - prev) % 256
            prev = bytes[i]
        end
        return out
    end

    local function seedFromNonce(nonce)
        return hash32(KEY .. bytesToStr(nonce), 2166136261)
    end

    local function clean(v)
        return (string.gsub(tostring(v == nil and "" or v), SEP, ""))
    end

    local function encodeServer(info)
        local plain = table.concat({
            clean(info.placeId),
            clean(info.gameId),
            clean(info.jobId),
            clean(info.privateServerId),
            clean(info.privateServerOwnerId),
            clean(info.userId),
            clean(info.userName),
            clean(info.time or os.time()),
        }, SEP)

        local check = hash32(plain, CHECK_SEED)
        local data = {
            bit32.band(bit32.rshift(check, 24), 255),
            bit32.band(bit32.rshift(check, 16), 255),
            bit32.band(bit32.rshift(check, 8), 255),
            bit32.band(check, 255),
        }
        for _, b in ipairs(strToBytes(plain)) do
            data[#data + 1] = b
        end

        local nonce = {}
        for i = 1, 4 do
            nonce[i] = math.random(0, 255)
        end
        local cipher = scramble(data, seedFromNonce(nonce))

        local packet = {}
        for i = 1, 4 do
            packet[i] = bit32.bxor(nonce[i], NONCE_MASK[i])
        end
        for _, b in ipairs(cipher) do
            packet[#packet + 1] = b
        end

        local symbols = toSymbols(packet)
        local groups = {}
        for i = 1, #symbols, 6 do
            groups[#groups + 1] = string.sub(symbols, i, i + 5)
        end
        return CODE_TAG .. "-" .. table.concat(groups, "-")
    end

    -- Used by the Join row. Takes whatever was pasted, returns the server info
    -- or nil plus a reason. Plain join scripts are rejected on purpose.
    function parseJoinScript(text)
        text = string.upper(tostring(text or ""))
        local _, tagEnd = string.find(text, CODE_TAG .. "%s*%-")
        if not tagEnd then
            return nil, "Not a portal gun server code"
        end
        local body = string.gsub(string.sub(text, tagEnd + 1), "[^A-Z2-9]", "")
        local packet = fromSymbols(body)
        if not packet or #packet < 9 then
            return nil, "That server code is damaged"
        end

        local nonce = {}
        for i = 1, 4 do
            nonce[i] = bit32.bxor(packet[i], NONCE_MASK[i])
        end
        local cipher = {}
        for i = 5, #packet do
            cipher[#cipher + 1] = packet[i]
        end
        local data = unscramble(cipher, seedFromNonce(nonce))

        local check = data[1] * 16777216 + data[2] * 65536 + data[3] * 256 + data[4]
        local plainBytes = {}
        for i = 5, #data do
            plainBytes[#plainBytes + 1] = data[i]
        end
        local plain = bytesToStr(plainBytes)
        if hash32(plain, CHECK_SEED) ~= check then
            return nil, "That server code is damaged"
        end

        local f = split(plain, SEP)
        if #f ~= FIELD_COUNT then
            return nil, "That server code is damaged"
        end
        local placeId = tonumber(f[1])
        local guid = string.rep("%x", 8) .. "%-" .. string.rep("%x", 4) .. "%-" .. string.rep("%x", 4) .. "%-" .. string.rep("%x", 4) .. "%-" .. string.rep("%x", 12)
        if not placeId or placeId <= 0 or not string.match(f[3], "^" .. guid .. "$") then
            return nil, "That server code is damaged"
        end

        return {
            placeId = placeId,
            gameId = tonumber(f[2]),
            jobId = f[3],
            privateServerId = f[4],
            privateServerOwnerId = tonumber(f[5]),
            userId = tonumber(f[6]),
            userName = f[7],
            time = tonumber(f[8]),
        }
    end

    -- picked up by _G.RickPortal below, then cleared so it isn't left global
    RP_EncodeServer = encodeServer
end

function joinServer(info)
    local TeleportService = game:GetService("TeleportService")
    local StarterGuiService = game:GetService("StarterGui")

    local function notify(text)
        pcall(function()
            StarterGuiService:SetCore("SendNotification", { Title = "Join server", Text = text, Duration = 6 })
        end)
    end

    local failConn
    failConn = TeleportService.TeleportInitFailed:Connect(function(plr, result, message)
        if plr ~= LocalPlayer then return end
        failConn:Disconnect()
        warn("[RickPortal] couldn't join that server: " .. tostring(message))
        notify("Couldn't join that server: " .. tostring(message))
    end)
    task.delay(30, function()
        if failConn.Connected then failConn:Disconnect() end
    end)

    local ok, err = pcall(function()
        TeleportService:TeleportToPlaceInstance(info.placeId, info.jobId, LocalPlayer)
    end)
    if not ok then
        failConn:Disconnect()
        warn("[RickPortal] server join failed: " .. tostring(err))
        notify("Couldn't join that server.")
        return false
    end
    return true
end

function openPortal(target, char, root, rootCF, center, portalCF, rayParams, ignore, rayOrigin, shotVector, reach, hit, orbEnd, onWall, stuckPos, hand, fromPos)
    if shooting then return end
    char = LocalPlayer.Character
    root = char and char:FindFirstChild("HumanoidRootPart")
    if not root then
        warn("[RickPortal] no character / HumanoidRootPart found")
        return
    end

    rootCF = root.CFrame
    center = (rootCF * CFrame.new(0, SPAWN_HEIGHT, -SPAWN_DISTANCE)).Position

    portalCF = CFrame.lookAt(center, Vector3.new(rootCF.Position.X, center.Y, rootCF.Position.Z))

    rayParams = RaycastParams.new()
    rayParams.FilterType = Enum.RaycastFilterType.Exclude
    rayParams.RespectCanCollide = true
    ignore = {}
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr.Character then
            table.insert(ignore, plr.Character)
        end
    end
    rayParams.FilterDescendantsInstances = ignore

    rayOrigin = rootCF.Position + Vector3.new(0, SPAWN_HEIGHT, 0)
    shotVector = center - rayOrigin
    reach = shotVector + shotVector.Unit * WALL_SNAP_DISTANCE
    hit = workspace:Raycast(rayOrigin, reach, rayParams)
    orbEnd = center
    onWall = false
    if hit and math.abs(hit.Normal.Y) < WALL_MAX_NORMAL_Y then
        onWall = true
        orbEnd = hit.Position
        stuckPos = hit.Position + hit.Normal * WALL_OFFSET

        portalCF = CFrame.lookAt(stuckPos, stuckPos + hit.Normal)
    end

    hand = char:FindFirstChild("RightHand") or char:FindFirstChild("Right Arm") or root
    fromPos = hand.Position

    for p in pairs(portals) do
        closePortal(p)
    end

    chosenTarget = typeof(target) == "Instance" and target or nil
    chosenArea = (type(target) == "table" and typeof(target.cframe) == "CFrame") and target or nil
    shooting = true
    showGun()
    shootTrack = playCharacterAnimation(char, SHOOT_ANIMATION_ID)
    playSounds(SHOOT_SOUNDS, root)
    task.spawn(function()

        shotTime = math.max(SHOT_TIME * (orbEnd - fromPos).Magnitude / (center - fromPos).Magnitude, 0.08)
        local orbTotal = ORB_HOLD_TIME + shotTime
        zoomFieldOfView(orbTotal)
        task.delay(math.max(orbTotal - PRE_OPEN_TIME, 0), function()
            playSounds({ PRE_OPEN_SOUND }, root)
        end)
        orbOk, orbErr = pcall(shootOrb, fromPos, orbEnd, shotTime)
        if not orbOk then warn("[RickPortal] orb failed: " .. tostring(orbErr)) end
        shooting = false
        buildOk, buildResult = pcall(buildPortal, portalCF, nil, onWall)
        if buildOk and buildResult then
            buildResult.shotPortal = true
        else
            hideGun()
            warn("[RickPortal] portal failed: " .. tostring(buildResult))
        end
    end)
end

