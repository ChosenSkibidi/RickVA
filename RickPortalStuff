function bounce(t)
    if t <= 0 then
        return 0
    end
    return 1 - math.exp(-DAMPING * t) * math.cos(FREQUENCY * t)
end

function getTargets()
    local list = {}
    for _, p in ipairs(Players:GetPlayers()) do
        local root = p ~= LocalPlayer and p.Character and p.Character:FindFirstChild("HumanoidRootPart")
        if root then
            table.insert(list, { name = p.Name, displayName = p.DisplayName, root = root, userId = p.UserId, player = p })
        end
    end

    local live = workspace:FindFirstChild("Live")
    local dummy = live and live:FindFirstChild("Weakest Dummy")
    local dummyRoot = dummy and dummy:FindFirstChild("HumanoidRootPart")
    if dummyRoot then
        table.insert(list, { name = "Weakest Dummy", displayName = "Weakest Dummy", root = dummyRoot, model = dummy })
    end

    return list
end

function pickTarget()
    local list = getTargets()
    if #list == 0 then
        return nil
    end
    return list[math.random(1, #list)].root
end

activeFovTween = nil

function snapFieldOfView()
    camera = workspace.CurrentCamera
    if not camera then return end
    if activeFovTween then
        activeFovTween:Cancel()
    end
    camera.FieldOfView = PORTAL_FOV_SNAP
    activeFovTween = TweenService:Create(
        camera,
        TweenInfo.new(PORTAL_FOV_RETURN_TIME, Enum.EasingStyle.Quint, Enum.EasingDirection.Out),
        { FieldOfView = PORTAL_FOV_REST }
    )
    activeFovTween:Play()
end

function zoomFieldOfView(duration)
    camera = workspace.CurrentCamera
    if not camera then return end
    if activeFovTween then
        activeFovTween:Cancel()
