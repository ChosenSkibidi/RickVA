    cyl("DialInner", "X", 0.2, 0.02, Vector3.new(SX + 0.07, DIAL_Y, DIAL_Z), Color3.fromRGB(150, 158, 154))
    block("DialPointer", Vector3.new(0.02, 0.05, 0.15), CFrame.new(SX + 0.088, DIAL_Y + 0.045, DIAL_Z + 0.02) * CFrame.Angles(math.rad(-40), 0, 0), DARK)
    cyl("DialHub", "X", 0.07, 0.02, Vector3.new(SX + 0.09, DIAL_Y, DIAL_Z), DARK)

    local TZ = -0.72
    cyl("ToggleBase", "X", 0.11, 0.025, Vector3.new(SX + 0.005, 0.3, TZ), DARK_GREY)
    cyl("ToggleCollar", "X", 0.075, 0.03, Vector3.new(SX + 0.02, 0.3, TZ), Color3.fromRGB(190, 198, 194))
