	Gravity     = 105,
	Slowmo      = 0.18,  -- time scale right after the burst
	SlowTime    = 0.6,   -- how long it takes to ramp back to full speed

	BloodColor  = Color3.fromRGB(122, 6, 14),
	VeinDark    = Color3.fromRGB(70, 0, 10),
	VeinHot     = Color3.fromRGB(255, 40, 55),
}

-- R6 sockets. Every local CFrame has +Y pointing OUT of the cut face.
local SPEC = {
