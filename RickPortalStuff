------------------------------------------------------------------ UTILS
local rng = Random.new()
local function rr(a, b) return rng:NextNumber(a, b) end
local function clamp01(x) return math.clamp(x, 0, 1) end
local function lerp(a, b, t) return a + (b - a) * t end

local Ease = {}
function Ease.inCubic(t) return t * t * t end
function Ease.outCubic(t) local u = 1 - t return 1 - u * u * u end
function Ease.inOutCubic(t)
	if t < 0.5 then return 4 * t * t * t end
	local u = -2 * t + 2
	return 1 - u * u * u / 2
end
function Ease.outQuint(t) local u = 1 - t return 1 - u ^ 5 end

local function bezier(a, b, c, t)
	local u = 1 - t
	return a * (u * u) + b * (2 * u * t) + c * (t * t)
end

local function heartbeat(phase)
	local f = phase % 1
	return math.exp(-f * 10) + 0.55 * math.exp(-((f - 0.24) % 1) * 12)
end

local function jitter(cf, s)
	return cf * CFrame.new(rr(-s, s), 0, rr(-s * 0.8, s * 0.8))
end

local function newPart(parent, size, color, shape, material)
	local p = Instance.new("Part")
	p.Anchored = true
	p.CanCollide = false
	p.CanQuery = false
	p.CanTouch = false
	p.CastShadow = false
	p.Massless = true
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	if shape then p.Shape = shape end
	p.Material = material or Enum.Material.SmoothPlastic
	p.Size = size
	p.Color = color or Color3.new(1, 1, 1)
	p.Parent = parent
	return p
end

------------------------------------------------------------------ SHARED STATE
local S = {
	running = false, Fired = false, fadeAt = math.huge, splats = 0, groundY = 0,
	folder = nil, rp = nil,
	trauma = 0, flash = 0, fov = 0, zoom = 0, beatPhase = 0,
}
local fx, drops = {}, {}

local function addFx(fn) fx[#fx + 1] = fn end
local function runFx(dt)
	local i = 1
	while i <= #fx do
		if fx[i](dt) then table.remove(fx, i) else i = i + 1 end
	end
end

------------------------------------------------------------------ BLOOD / IMPACT FX
local function glowBall(pos, color, size, life)
	local p = newPart(S.folder, Vector3.new(1, 1, 1), color, Enum.PartType.Ball, Enum.Material.Neon)
	p.Position = pos
	local age = 0
	addFx(function(dt)
		age = age + dt
		local a = clamp01(age / life)
		local s = lerp(0.6, size, Ease.outCubic(a))
		p.Size = Vector3.new(s, s, s)
		p.Transparency = 0.1 + 0.9 * a
		if a >= 1 then
			p:Destroy()
			return true
		end
	end)
end

local function puddle(pos, scale)
	if S.splats >= 90 then return end
	S.splats = S.splats + 1
	local d = rr(1.3, 3.2) * scale
	local yOff = rr(0.03, 0.055)
	local spin = rr(0, PI * 2)
	local col = CFG.BloodColor:Lerp(Color3.new(0, 0, 0), rr(0, 0.4))
	local p = newPart(S.folder, Vector3.new(0.05, 0.1, 0.1), col, Enum.PartType.Cylinder)
	p.Reflectance = 0.12
	local age = 0
	addFx(function(dt)
		age = age + dt
		local g = Ease.outCubic(clamp01(age / 0.4))
		p.Size = Vector3.new(0.05, d * g, d * g)
		p.CFrame = CFrame.new(pos.X, pos.Y + yOff, pos.Z) * CFrame.Angles(0, spin, PI / 2)
		local fade = clamp01((os.clock() - S.fadeAt) / 1.4)
		p.Transparency = fade
		if fade >= 1 then
			S.splats = S.splats - 1
			p:Destroy()
			return true
		end
	end)
end

local function spawnDrop(pos, vel)
	local s = rr(0.12, 0.46)
	local col = CFG.BloodColor:Lerp(Color3.fromRGB(190, 15, 25), rr(0, 0.6))
	local p = newPart(S.folder, Vector3.new(s, s, s), col)
	p.CFrame = CFrame.new(pos)
	drops[#drops + 1] = { p = p, pos = pos, vel = vel, size = s }
end

local function stepDrops(dt)
	local i = 1
	while i <= #drops do
		local d = drops[i]
		d.vel = d.vel + Vector3.new(0, -CFG.Gravity * dt, 0)
		d.pos = d.pos + d.vel * dt
		if d.pos.Y <= S.groundY then
			if rng:NextNumber() < 0.3 then
				puddle(Vector3.new(d.pos.X, S.groundY, d.pos.Z), d.size * 1.6)
			end
			d.p:Destroy()
			table.remove(drops, i)
		else
			local sp = d.vel.Magnitude
			if sp > 0.5 then
				local len = math.clamp(sp * 0.016, d.size, d.size * 5)
				d.p.Size = Vector3.new(d.size, d.size, len)
				d.p.CFrame = CFrame.lookAt(d.pos, d.pos + d.vel)
			else
				d.p.CFrame = CFrame.new(d.pos)
			end
			i = i + 1
		end
	end
end

