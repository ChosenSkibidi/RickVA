function behindFxDepart(character, originPos, landPos)
    behindFxAfterimages(character, landPos - originPos)
    behindFxFlash(originPos, 1, 7, 0.22, BEHIND_FX_CORE_COLOR)
    behindFxFlash(originPos, 2, 12, 0.34, BEHIND_FX_COLOR)
    behindFxPillar(originPos, 14, 0.4)
    behindFxSparks(originPos, 28)
    local floorY = behindFxFloor(originPos)
    if floorY then
        behindFxRing(originPos, floorY, BEHIND_FX_RING_SIZE, 0)
    end
    behindFxStreak(originPos, landPos)
end

function behindFxArrive(landPos)
    behindFxFlash(landPos, 1.5, 6, 0.2, BEHIND_FX_CORE_COLOR)
    behindFxFlash(landPos, 2, 9, 0.34, BEHIND_FX_COLOR)
    behindFxSparks(landPos, 40)
    local floorY = behindFxFloor(landPos)
    if floorY then
        behindFxRing(landPos, floorY, BEHIND_FX_RING_SIZE, 0)
        behindFxRing(landPos, floorY, BEHIND_FX_RING_SIZE * 1.5, 0.07)
    end
    behindFxScreen()
end

function teleportBehind(attackerChar, playVoice, playStreakVoice, behindDistance, fancy)
    character = LocalPlayer.Character
    humanoid = character and character:FindFirstChildOfClass("Humanoid")
    root = character and character:FindFirstChild("HumanoidRootPart")
    aRoot = attackerChar:FindFirstChild("HumanoidRootPart")
    if not humanoid or humanoid.Health <= 0 or not root or not aRoot then return false end

    local originPos = root.Position
    local useFx = fancy and BEHIND_FX_ENABLED

    emitDodgeBurst(root)

    look = flatXZ(aRoot.CFrame.LookVector)
    look = look.Magnitude > 0.01 and look.Unit or Vector3.new(0, 0, -1)
    landPos = aRoot.Position - look * (behindDistance or DODGE_BEHIND_DISTANCE)

    if useFx then
        pcall(behindFxDepart, character, originPos, landPos)
    end

    root.CFrame = CFrame.new(landPos, Vector3.new(aRoot.Position.X, landPos.Y, aRoot.Position.Z))

    playDodgeArrival(character, root, playVoice, playStreakVoice)

    if useFx then
        pcall(behindFxArrive, landPos)
    end
    return true
end

