    cyl("DialRing", "X", 0.44, 0.05, Vector3.new(SX + 0.015, DIAL_Y, DIAL_Z), Color3.fromRGB(224, 230, 226))
    for i = 0, 15 do
        local a = i * (math.pi * 2 / 16)
