        CFrame.new(SX + 0.085, 0.31, TZ - 0.012) * CFrame.Angles(0, 0, math.rad(18)), YELLOW)
    ball("ToggleTip", 0.055, Vector3.new(SX + 0.152, 0.3185, TZ - 0.018), YELLOW)

    for i, y in ipairs({ 0.12, -0.04 }) do
        cyl("ButtonRing" .. i, "X", 0.15, 0.02, Vector3.new(SX + 0.005, y, TZ), Color3.fromRGB(170, 178, 174))
        cyl("Button" .. i, "X", 0.11, 0.05, Vector3.new(SX + 0.025, y, TZ), DARK)
        cyl("ButtonShine" .. i, "X", 0.045, 0.01, Vector3.new(SX + 0.052, y + 0.015, TZ), Color3.fromRGB(110, 118, 114))
    end

    for i = 0, 7 do
        local t = i / 7
        local pos = Vector3.new(SX + 0.02, 0.12 - 0.16 * t, TZ + 0.085 * math.sin(math.pi * t))
        ball("Bead", 0.04, pos, PURPLE)
    end

    for _, sx in ipairs({ 1, -1 }) do
        wedge("CutoutLip", Vector3.new(0.02, 0.24, 0.35), CFrame.new(sx * (SX + 0.004), -0.27, -0.79), WHITE_LO)
        wedge("CutoutDark", Vector3.new(0.024, 0.19, 0.28), CFrame.new(sx * (SX + 0.008), -0.285, -0.775), DARK)
    end

    cyl("DomeOutline", "Y", 0.68, 0.02, Vector3.new(0, 0.41, DZ), DARK)
    cyl("DomeFlange", "Y", 0.64, 0.06, Vector3.new(0, 0.43, DZ), MINT, SMOOTH, 0.1)
    cyl("DomeCollar", "Y", 0.52, 0.04, Vector3.new(0, 0.48, DZ), Color3.fromRGB(170, 215, 212), SMOOTH, 0.1)
    local glassA = cyl("DomeGlass", "Y", 0.46, 0.34, Vector3.new(0, 0.67, DZ), GLASS, Enum.Material.Glass, 0.5)
    local glassB = ball("DomeGlassTop", 0.46, Vector3.new(0, 0.84, DZ), GLASS, Enum.Material.Glass, 0.5)
    glassA.Reflectance = 0.06
    glassB.Reflectance = 0.06

    local core = ball("DomeCore", 0.34, Vector3.new(0, 0.76, DZ), FILL, NEONMAT, 0.55)
    local light = Instance.new("PointLight")
    light.Name = "DomeLight"
    light.Color = GLASS
    light.Brightness = 1.2
    light.Range = 7
    light.Shadows = false
    light.Parent = core

    local rng = Random.new(5)
    local R = 0.19
    for v = 1, 6 do
        local dir = Vector3.new(rng:NextNumber(-1, 1), rng:NextNumber(-0.1, 1), rng:NextNumber(-1, 1)).Unit
        local prev = DC + dir * R
        for _ = 1, 3 do
            dir = (dir + Vector3.new(rng:NextNumber(-0.8, 0.8), rng:NextNumber(-0.6, 0.8), rng:NextNumber(-0.8, 0.8))).Unit
            local nxt = DC + dir * (R * rng:NextNumber(0.8, 1.05))
            segment("Vein", prev, nxt, 0.02, NEON)
            prev = nxt
        end
    end

    for arm = 0, 1 do
        local prev
        for i = 0, 8 do
            local a = arm * math.pi + i * 0.62
            local r = 0.025 + i * 0.012
            local pt = DC + Vector3.new(0, math.sin(a) * r, math.cos(a) * r)
            if prev then segment("Swirl", prev, pt, 0.024, NEON) end
            prev = pt
        end
    end
    ball("SwirlEye", 0.07, DC, Color3.fromRGB(215, 255, 170), NEONMAT)

    local handle = model:FindFirstChild("Handle")
    model.PrimaryPart = handle
    for _, part in ipairs(model:GetDescendants()) do
        if part:IsA("BasePart") and part ~= handle then
            local weld = Instance.new("Weld")
            weld.Name = "GunPartWeld"
            weld.Part0 = handle
            weld.Part1 = part
            weld.C0 = handle.CFrame:ToObjectSpace(part.CFrame)
            weld.C1 = CFrame.new()
            weld.Parent = handle
        end
    end

    return model
end

