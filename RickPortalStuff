-- Blue mini button parked on top of the main portal button. Teleports you 6 studs behind the
-- nearest enemy with the dodge VFX (burst + blue flash + blink) and ONLY the always-on dodge sound
-- (EXIT_SOUND): no voiceline, no streak voiceline.
function nearestEnemyChar()
    local character = LocalPlayer.Character
    local root = character and character:FindFirstChild("HumanoidRootPart")
    if not root then return nil end
    local best, bestDist = nil, math.huge
    for _, t in ipairs(getTargets()) do
        local hum = t.root.Parent and t.root.Parent:FindFirstChildOfClass("Humanoid")
        if t.root.Parent and (not hum or hum.Health > 0) then
            local d = (t.root.Position - root.Position).Magnitude
            if d < bestDist then
                best, bestDist = t.root.Parent, d
            end
        end
    end
    return best
end

