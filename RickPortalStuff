-- modes: off | tether | dangle | grow | attached | retract
local function setMode(v, mode, t)
	v.mode = mode
	v.t0 = t
	v.beam.Enabled = (mode ~= "off")
end

local function makeVein(parent, src, srcLocal, dst, dstLocal, kind, width)
	local a = newPart(parent, Vector3.new(0.1, 0.1, 0.1), Color3.new(1, 0, 0))
	local b = newPart(parent, Vector3.new(0.1, 0.1, 0.1), Color3.new(1, 0, 0))
	a.Transparency = 1
	b.Transparency = 1
	local a0 = Instance.new("Attachment")
	a0.Parent = a
	local a1 = Instance.new("Attachment")
	a1.Parent = b
	local beam = Instance.new("Beam")
	beam.Attachment0 = a0
	beam.Attachment1 = a1
	beam.FaceCamera = true
	beam.Segments = 26
	beam.LightEmission = 0.7
	beam.LightInfluence = 0
	beam.Transparency = NumberSequence.new(0)
	beam.Enabled = false
	beam.Parent = a
	return {
		a = a, b = b, beam = beam, kind = kind, mode = "off", t0 = 0, dur = 1,
		src = src, srcLocal = jitter(srcLocal, 0.32),
		dst = dst, dstLocal = jitter(dstLocal, 0.32),
		width = width, seed = rr(0, 100),
		spin = rr(1.2, 2.6) * ((rng:NextNumber() < 0.5) and -1 or 1),
		wob = rr(0.7, 1.4), snapDist = rr(7, 11), hang = rr(1.6, 3.2),
		ref = Vector3.new(rr(-1, 1), rr(-1, 1), rr(-1, 1)).Unit,
		tipPos = nil, lastTip = nil, tip0 = nil,
	}
end

local function updateVein(v, sdt, clock, heat, beat)
	if v.mode == "off" then return end
	local srcCF = v.src.disp * v.srcLocal
	local sp = srcCF.Position
	local dp = (v.dst.disp * v.dstLocal).Position
	local mode = v.mode
	local tip, wmul, wiggle = dp, 1, 0.5

	if mode == "tether" then
		local dist = (dp - sp).Magnitude
		wmul = math.clamp(1.3 - dist / v.snapDist, 0.15, 1)
		wiggle = 0.3
		if dist > v.snapDist then
			-- SNAP: whips back and dangles off the limb
			v.tipPos = dp
			setMode(v, "dangle", clock)
			mode = "dangle"
			for _ = 1, 5 do
				spawnDrop(sp, Vector3.new(rr(-12, 12), rr(4, 16), rr(-12, 12)))
			end
		end
	end

	if mode == "dangle" then
		local sway = Vector3.new(math.sin(clock * 3.1 + v.seed), 0, math.cos(clock * 2.6 + v.seed * 1.7)) * 0.6
		local target = sp + srcCF.UpVector * (v.hang * 0.3) + Vector3.new(0, -v.hang * 0.75, 0) + sway
		if target.Y < S.groundY + 0.12 then
			target = Vector3.new(target.X, S.groundY + 0.12, target.Z)
		end
		v.tipPos = (v.tipPos or sp):Lerp(target, 1 - math.exp(-sdt * 11))
		tip = v.tipPos
		wmul = 0.8
		wiggle = 1
	elseif mode == "grow" then
		local a = clamp01((clock - v.t0) / v.dur)
		local e = Ease.inOutCubic(a)
		local from = v.tip0 or sp
		local dir = dp - from
		local len = dir.Magnitude
		local side = dir:Cross(v.ref)
		if side.Magnitude < 1e-3 then side = dir:Cross(Vector3.zAxis) end
		if side.Magnitude > 1e-3 then side = side.Unit else side = Vector3.xAxis end
		local arc = math.sin(PI * a) * len * 0.24
		local thrash = 0.65 + 0.35 * math.sin(clock * 11 + v.seed)
		tip = from:Lerp(dp, e) + side * (arc * thrash) + Vector3.new(0, arc * 0.45, 0)
		wmul = 0.3 + 0.7 * clamp01(a * 3)
		wiggle = lerp(1.2, 0.5, a)
		if a >= 1 then setMode(v, "attached", clock) end
	elseif mode == "attached" then
		tip = dp
		wmul = 1
		wiggle = 0.45
	elseif mode == "retract" then
		local a = clamp01((clock - v.t0) / 0.3)
		tip = dp:Lerp(sp, Ease.inCubic(a))
		wmul = 1 - a
		wiggle = 0.4
		if a >= 1 then
			setMode(v, "off", clock)
			return
		end
	end
	v.lastTip = tip

	-- orient both endpoints so the bezier bows perpendicular to the vein, spinning over time
	local vec = tip - sp
	local dist = vec.Magnitude
	local fwd = (dist > 1e-3) and (vec / dist) or Vector3.yAxis
	local r = v.ref:Cross(fwd)
	if r.Magnitude < 1e-3 then r = Vector3.zAxis:Cross(fwd) end
	r = r.Unit
	local d = CFrame.fromAxisAngle(fwd, v.seed + clock * v.spin) * r
	local e2 = fwd:Cross(d)
	v.a.CFrame = CFrame.fromMatrix(sp, d, e2)
	v.b.CFrame = CFrame.fromMatrix(tip, d, e2)

	local amp = math.min(dist * 0.3, 3.2) * wiggle * v.wob
	v.beam.CurveSize0 = amp * math.sin(clock * 5 + v.seed)
	v.beam.CurveSize1 = -amp * math.sin(clock * 4.1 + v.seed * 1.7)

	local w = v.width * wmul * (1 + 0.55 * beat)
	v.beam.Width0 = w
	v.beam.Width1 = w * 0.55
	local c0 = CFG.VeinDark:Lerp(CFG.VeinHot, clamp01(heat * 0.85 + 0.35 * beat))
	local c1 = c0:Lerp(Color3.fromRGB(255, 190, 190), clamp01(0.2 + beat * 0.5))
	v.beam.Color = ColorSequence.new(c0, c1)
end

------------------------------------------------------------------ PHYSICS (custom, so it stays smooth + controllable)
local LOCAL_N = { Vector3.xAxis, -Vector3.xAxis, Vector3.yAxis, -Vector3.yAxis, Vector3.zAxis, -Vector3.zAxis }

local function groundAt(pos)
	local r = workspace:Raycast(pos + Vector3.new(0, 3, 0), Vector3.new(0, -70, 0), S.rp)
	return r and r.Position.Y or S.groundY
end

local function onImpact(p, impact, pos, gy)
	local now = os.clock()
	if now - p.lastImpact < 0.12 then return end
	p.lastImpact = now
	S.trauma = math.min(1, S.trauma + 0.10 * clamp01(impact / 45))
	puddle(Vector3.new(pos.X, gy, pos.Z), 1.1)
	for _ = 1, 11 do
		spawnDrop(pos, Vector3.new(rr(-16, 16), rr(8, 26), rr(-16, 16)))
	end
end

local function simulate(p, dt)
	p.vel = p.vel + Vector3.new(0, -CFG.Gravity * dt, 0)
	local pos = p.cf.Position + p.vel * dt
	local rot = p.cf - p.cf.Position
	local w = p.av.Magnitude
	if w > 1e-3 then rot = CFrame.fromAxisAngle(p.av / w, w * dt) * rot end
	local cf = CFrame.new(pos) * rot

	local gy = groundAt(pos)
	local half = p.size * 0.5
	local lowest = math.huge
	for sx = -1, 1, 2 do
		for sy = -1, 1, 2 do
			for sz = -1, 1, 2 do
				local wy = cf:PointToWorldSpace(Vector3.new(half.X * sx, half.Y * sy, half.Z * sz)).Y
				if wy < lowest then lowest = wy end
			end
		end
	end

	local contact = false
	if lowest < gy then
		contact = true
		cf = cf + Vector3.new(0, gy - lowest, 0)
		if p.vel.Y < 0 then
			local impact = -p.vel.Y
			if impact > 7 then
				p.vel = Vector3.new(p.vel.X * 0.72, impact * 0.30, p.vel.Z * 0.72)
				onImpact(p, impact, cf.Position, gy)
			else
				p.vel = Vector3.new(p.vel.X, 0, p.vel.Z)
			end
		end
		local k = math.exp(-dt * 5)
		p.vel = Vector3.new(p.vel.X * k, p.vel.Y, p.vel.Z * k)

		-- topple onto whichever face is closest to pointing down
		local down = Vector3.new(0, -1, 0)
		local bestD, bestN = -2, nil
		for _, n in ipairs(LOCAL_N) do
			local wn = rot:VectorToWorldSpace(n)
			local dd = wn:Dot(down)
			if dd > bestD then
				bestD, bestN = dd, wn
			end
		end
		local axis = bestN:Cross(down)
		if axis.Magnitude > 1e-3 then
			p.av = p.av + axis.Unit * (math.acos(math.clamp(bestD, -1, 1)) * 18 * dt)
		end
		p.av = p.av * math.exp(-dt * 7)
	else
		p.av = p.av * math.exp(-dt * 0.4)
	end

	if contact and p.vel.Magnitude < 1.5 and p.av.Magnitude < 0.6 then
		p.still = p.still + dt
		if p.still > 0.2 then
			p.state = "rest"
			p.vel = Vector3.zero
			p.av = Vector3.zero
		end
	else
		p.still = 0
	end
	p.cf = cf
end

------------------------------------------------------------------ GIBS (meat + bone chunks)
local gibs = {}
local FLESH = {
	Color3.fromRGB(122, 8, 16), Color3.fromRGB(150, 22, 30), Color3.fromRGB(196, 78, 84),
	Color3.fromRGB(88, 4, 10), Color3.fromRGB(214, 176, 120),
}
local BONE_COL = Color3.fromRGB(236, 226, 204)

local function spawnGib(pos, vel, bone)
	if #gibs >= 80 then return end
	local k = bone and rr(0.12, 0.2) or rr(0.28, 0.7)
	local size = bone and Vector3.new(k, k, rr(0.5, 1.1)) or Vector3.new(k * rr(0.8, 1.4), k * rr(0.6, 1), k * rr(0.8, 1.4))
	local col = bone and BONE_COL:Lerp(CFG.BloodColor, rr(0, 0.4)) or FLESH[rng:NextInteger(1, #FLESH)]
	local p = newPart(S.folder, size, col)
	p.Reflectance = bone and 0 or 0.12
	local cf = CFrame.new(pos) * CFrame.Angles(rr(0, PI * 2), rr(0, PI * 2), rr(0, PI * 2))
	p.CFrame = cf
	gibs[#gibs + 1] = {
		p = p, size = size, cf = cf, vel = vel, bone = bone, trail = 0, rest = false,
		av = Vector3.new(rr(-1, 1), rr(-1, 1), rr(-1, 1)) * rr(6, 16),
	}
end

-- sucking = true while the body is pulling itself back together: loose chunks get dragged into the torso
local function stepGibs(dt, suckPos, sucking)
	local i = 1
	while i <= #gibs do
		local g = gibs[i]
		local remove = false
		local pulled = sucking and suckPos ~= nil
		if pulled then
			g.wait = (g.wait or rr(0, 0.9)) - dt
			if g.wait > 0 then pulled = false end
		end
		if pulled then
			g.drain = (g.drain or 0) + dt
			local to = suckPos - g.cf.Position
			local dist = to.Magnitude
			if dist < 1.2 or g.drain > 1.8 then
				remove = true
			else
				local rot = g.cf - g.cf.Position
				g.cf = CFrame.new(g.cf.Position + to.Unit * math.min(dist, (14 + g.drain * 45) * dt))
					* CFrame.fromAxisAngle(Vector3.yAxis, dt * 9) * rot
				g.p.Size = g.size * math.max(0.25, clamp01(dist / 4))
				g.p.CFrame = g.cf
			end
		elseif not g.rest then
			g.vel = g.vel + Vector3.new(0, -CFG.Gravity * dt, 0)
			local pos = g.cf.Position + g.vel * dt
			local rot = g.cf - g.cf.Position
			local w = g.av.Magnitude
			if w > 1e-3 then rot = CFrame.fromAxisAngle(g.av / w, w * dt) * rot end
			g.trail = g.trail + dt
			if g.trail > 0.045 and not g.bone and g.vel.Magnitude > 6 then
				g.trail = 0 -- meat leaves a blood trail while it flies
				spawnDrop(pos, g.vel * 0.15 + Vector3.new(rr(-2, 2), rr(0, 3), rr(-2, 2)))
			end
			local gy = S.groundY + g.size.Y * 0.4
			if pos.Y <= gy then
				pos = Vector3.new(pos.X, gy, pos.Z)
				if g.vel.Y < -4 then
					puddle(Vector3.new(pos.X, S.groundY, pos.Z), 1.0)
					for _ = 1, 5 do
						spawnDrop(pos, Vector3.new(rr(-9, 9), rr(4, 14), rr(-9, 9)))
					end
					g.vel = Vector3.new(g.vel.X * 0.55, -g.vel.Y * 0.28, g.vel.Z * 0.55)
					g.av = g.av * 0.5
				else
					g.vel, g.av, g.rest = Vector3.zero, Vector3.zero, true
				end
			end
			g.cf = CFrame.new(pos) * rot
			g.p.CFrame = g.cf
		end
		local fade = clamp01((os.clock() - S.fadeAt) / 1.4)
		if fade > 0 then g.p.Transparency = fade end
		if fade >= 1 then remove = true end
		if remove then
			g.p:Destroy()
			table.remove(gibs, i)
		else
			i = i + 1
		end
	end
end

------------------------------------------------------------------ EXPOSED RIBCAGE + ORGANS
-- Everything is stored in torso-local space and follows the torso piece. -Z is the torso's front face.
local function buildChest(parent)
	local chest = { items = {}, shown = false }
	local function add(size, cf, color, shape, refl)
		local p = newPart(parent, size, color, shape)
		p.Transparency = 1
		if refl then p.Reflectance = refl end
		chest.items[#chest.items + 1] = { part = p, cf = cf }
		return p
	end
	local function bar(a, b, th)
		local col = BONE_COL:Lerp(CFG.BloodColor, rr(0, 0.5)) -- some ribs are soaked in blood
		local up = (math.abs((b - a).Unit.Y) > 0.9) and Vector3.xAxis or Vector3.yAxis
		add(Vector3.new((b - a).Magnitude + 0.03, th, th),
			CFrame.lookAt((a + b) * 0.5, b, up) * CFrame.Angles(0, PI / 2, 0), col, Enum.PartType.Cylinder)
	end

	-- the open wound + torn flesh around its edge
	add(Vector3.new(1.6, 1.75, 0.12), CFrame.new(0, 0.02, -0.5), Color3.fromRGB(92, 4, 10), nil, 0.22)
	for i = 1, 16 do
		local ang = (i / 16) * PI * 2
		local sz = rr(0.18, 0.42)
		add(Vector3.new(sz, sz * rr(0.5, 1), sz * rr(0.5, 1)),
			CFrame.new(math.cos(ang) * 0.86, 0.02 + math.sin(ang) * 0.93, -0.54) * CFrame.Angles(rr(-0.5, 0.5), rr(-0.5, 0.5), rr(0, PI)),
			FLESH[rng:NextInteger(1, #FLESH)], nil, 0.12)
	end

	-- organs behind the ribs
	add(Vector3.new(0.62, 1.0, 0.42), CFrame.new(0.43, 0.28, -0.58), Color3.fromRGB(176, 74, 86), Enum.PartType.Ball, 0.15) -- lungs
	add(Vector3.new(0.62, 1.0, 0.42), CFrame.new(-0.43, 0.28, -0.58), Color3.fromRGB(160, 62, 74), Enum.PartType.Ball, 0.15)
	add(Vector3.new(0.78, 0.4, 0.4), CFrame.new(0.3, -0.5, -0.58), Color3.fromRGB(96, 22, 24), Enum.PartType.Ball, 0.18)  -- liver
	for k = 1, 7 do -- intestines
		add(Vector3.new(0.32, 0.3, 0.3), CFrame.new(-0.55 + k * 0.18, -0.72 + math.sin(k * 1.7) * 0.08, -0.58),
			Color3.fromRGB(206, 108, 118), Enum.PartType.Ball, 0.2)
	end
	local heartP = newPart(parent, Vector3.new(0.42, 0.52, 0.38), Color3.fromRGB(176, 12, 26), Enum.PartType.Ball)
	heartP.Transparency = 1
	heartP.Reflectance = 0.28
	chest.heart = { part = heartP, cf = CFrame.new(-0.22, 0.12, -0.66), size = heartP.Size }

	-- ribs: six pairs bowing out of the chest and meeting at the sternum (two of them are snapped)
	local depth = 0.24
	for i = 1, 6 do
		local y0 = 0.82 - (i - 1) * 0.2
		local a = 0.8 - (i - 1) * 0.025
		local th = 0.09 - (i - 1) * 0.004
		for side = -1, 1, 2 do
			local tmax = ((i == 3 and side == 1) or (i == 5 and side == -1)) and 0.62 or 1
			local prev
			for seg = 0, 4 do
				local t = seg / 4 * tmax
				local pt = Vector3.new(side * a * math.cos(t * PI / 2), y0 - 0.12 * t, -0.5 - depth * math.sin(t * PI / 2))
				if prev then bar(prev, pt, th) end
				prev = pt
			end
			if tmax < 1 then
				bar(prev, prev + Vector3.new(side * 0.05, -0.13, -0.09), th * 0.7) -- jagged broken end
			end
		end
	end
	add(Vector3.new(0.16, 1.3, 0.1), CFrame.new(0, 0.3, -0.5 - depth), BONE_COL, nil)  -- sternum
	add(Vector3.new(0.1, 0.3, 0.07), CFrame.new(0, -0.45, -0.5 - depth), BONE_COL, nil)
	bar(Vector3.new(0, 0.94, -0.5 - depth), Vector3.new(0.72, 1.0, -0.56), 0.08)         -- collar bones
	bar(Vector3.new(0, 0.94, -0.5 - depth), Vector3.new(-0.72, 1.0, -0.56), 0.08)

	-- pelvis hanging under the torso: sacrum + coccyx, two flared iliac wings with crests, pubic arch,
	-- ischial tuberosities, and a bone-ringed hip socket for each leg
	local function bcol() return BONE_COL:Lerp(CFG.BloodColor, rr(0, 0.35)) end
	add(Vector3.new(0.5, 0.7, 0.14), CFrame.new(0, -1.08, 0.34) * CFrame.Angles(-0.3, 0, 0), bcol())
	add(Vector3.new(0.14, 0.34, 0.1), CFrame.new(0, -1.5, 0.45) * CFrame.Angles(-0.45, 0, 0), bcol())
	add(Vector3.new(0.14, 0.12, 0.1), CFrame.new(0, -1.3, -0.4), bcol()) -- pubic symphysis
	for side = -1, 1, 2 do
		add(Vector3.new(0.08, 0.78, 0.72), CFrame.new(side * 1.04, -0.55, 0.03) * CFrame.Angles(0, side * -0.5, side * 0.28), bcol(), nil, 0.05) -- iliac blade
		bar(Vector3.new(side * 0.9, -0.17, 0.36), Vector3.new(side * 1.18, -0.15, 0.02), 0.1)    -- crest, back half
		bar(Vector3.new(side * 1.18, -0.15, 0.02), Vector3.new(side * 1.12, -0.2, -0.34), 0.1)   -- crest, front half
		add(Vector3.new(0.18, 0.18, 0.18), CFrame.new(side * 1.12, -0.2, -0.34), bcol(), Enum.PartType.Ball) -- front hip spine
		bar(Vector3.new(side * 0.3, -0.9, 0.3), Vector3.new(side * 0.9, -0.55, 0.2), 0.14)      -- sacroiliac joint
		bar(Vector3.new(side * 0.95, -0.75, 0), Vector3.new(side * 0.55, -1.02, 0), 0.2)         -- blade down to the socket
		bar(Vector3.new(side * 0.52, -1.05, -0.15), Vector3.new(side * 0.07, -1.3, -0.4), 0.13) -- pubic ramus
		bar(Vector3.new(side * 0.5, -1.05, 0.12), Vector3.new(side * 0.42, -1.42, 0.22), 0.15)   -- ischium
		add(Vector3.new(0.2, 0.2, 0.2), CFrame.new(side * 0.42, -1.44, 0.22), bcol(), Enum.PartType.Ball)
		for k = 1, 8 do -- hip socket rim + dark cup
			local ang = k / 8 * PI * 2
			add(Vector3.new(0.15, 0.1, 0.15),
				CFrame.new(side * 0.5 + math.cos(ang) * 0.3, -1.02, math.sin(ang) * 0.3) * CFrame.Angles(rr(-0.3, 0.3), ang, rr(-0.3, 0.3)), bcol())
		end
		add(Vector3.new(0.05, 0.5, 0.5), CFrame.new(side * 0.5, -1.0, 0) * CFrame.Angles(0, 0, PI / 2), Color3.fromRGB(92, 4, 10), Enum.PartType.Cylinder, 0.2)
	end
	for _ = 1, 10 do -- torn flesh hanging off the pelvis
		local sz = rr(0.16, 0.34)
		add(Vector3.new(sz, sz * rr(0.5, 1), sz),
			CFrame.new(rr(-1, 1), rr(-1.4, -1.0), rr(-0.35, 0.35)) * CFrame.Angles(rr(-0.5, 0.5), rr(0, PI), rr(-0.5, 0.5)),
			FLESH[rng:NextInteger(1, #FLESH)], nil, 0.12)
	end
	return chest
end

local function showChest(chest, on)
	for _, it in ipairs(chest.items) do it.part.Transparency = on and 0 or 1 end
	if chest.heart then chest.heart.part.Transparency = on and 0 or 1 end
	chest.shown = on
end

local function updateChest(chest, torsoCF, beat)
	if not chest.shown then return end
	for _, it in ipairs(chest.items) do
		it.part.CFrame = torsoCF * it.cf
	end
	local h = chest.heart
	if h then
		h.part.Size = h.size * (1 + 0.28 * math.min(beat, 1.2)) -- the heart is visibly beating
		h.part.CFrame = torsoCF * h.cf
	end
end

-- Exposed arm bones: the front of the arm is torn open, humerus + radius + ulna show through and the
-- forearm bones snap out past the wrist. Stored in arm-local space (arm is 1x2x1, -Z = front).
local function buildArmBones(parent, k)
	k = k or 1
	local arm = { items = {}, shown = false }
	local function add(size, cf, color, shape, refl)
		local p = newPart(parent, size, color, shape)
		p.Transparency = 1
		if refl then p.Reflectance = refl end
		arm.items[#arm.items + 1] = { part = p, cf = cf }
	end
	local function bone(a, b, th)
		local dir = (b - a).Unit
		local up = (math.abs(dir.Y) > 0.9) and Vector3.xAxis or Vector3.yAxis
		add(Vector3.new((b - a).Magnitude + 0.03, th * k, th * k),
			CFrame.lookAt((a + b) * 0.5, b, up) * CFrame.Angles(0, PI / 2, 0),
			BONE_COL:Lerp(CFG.BloodColor, rr(0, 0.5)), Enum.PartType.Cylinder)
	end
	local function knob(pos, d)
		add(Vector3.new(d * k, d * k, d * k), CFrame.new(pos), BONE_COL:Lerp(CFG.BloodColor, rr(0, 0.35)), Enum.PartType.Ball)
	end

	-- torn-open strip down the front of the arm + ragged flesh around it
	add(Vector3.new(0.62, 1.75, 0.08), CFrame.new(0, 0, -0.52), Color3.fromRGB(92, 4, 10), nil, 0.22)
	for i = 1, 12 do
		local side = (i % 2 == 0) and 1 or -1
		local y = -0.8 + (i - 1) / 11 * 1.6
		local sz = rr(0.14, 0.32)
		add(Vector3.new(sz, sz * rr(0.6, 1.2), sz * rr(0.5, 1)),
			CFrame.new(side * rr(0.28, 0.36), y, -0.55) * CFrame.Angles(rr(-0.5, 0.5), rr(-0.5, 0.5), rr(0, PI)),
			FLESH[rng:NextInteger(1, #FLESH)], nil, 0.12)
	end

	-- humerus (upper arm) with a joint knob at the shoulder end and at the elbow
	bone(Vector3.new(0.02, 0.92, -0.6), Vector3.new(0.04, 0.0, -0.62), 0.17)
	knob(Vector3.new(0.02, 0.95, -0.6), 0.27)
	knob(Vector3.new(0.04, -0.02, -0.62), 0.25)
	-- radius + ulna (forearm); the radius sticks out past the wrist, the ulna is snapped short
	bone(Vector3.new(-0.1, -0.06, -0.6), Vector3.new(-0.13, -1.3, -0.62), 0.12)
	bone(Vector3.new(0.12, -0.06, -0.6), Vector3.new(0.15, -0.78, -0.62), 0.11)
	bone(Vector3.new(0.15, -0.78, -0.62), Vector3.new(0.2, -0.94, -0.66), 0.07)  -- jagged broken end
	bone(Vector3.new(-0.13, -1.3, -0.62), Vector3.new(-0.1, -1.4, -0.66), 0.06)
	return arm
end

-- Broken neck: a stack of vertebrae with the spinal cord, windpipe and gullet hanging out of a torn flesh ring.
-- sign = +1 builds it upward out of the torso's neck hole, -1 builds it downward out of the head's cut.
local function buildNeckBones(parent, sign, baseY, count)
	local neck = { items = {}, shown = false }
	local function add(size, cf, color, shape, refl)
		local p = newPart(parent, size, color, shape)
		p.Transparency = 1
		if refl then p.Reflectance = refl end
		neck.items[#neck.items + 1] = { part = p, cf = cf }
	end
	local function tube(a, b, th, col)
		local dir = (b - a).Unit
		local up = (math.abs(dir.Y) > 0.9) and Vector3.xAxis or Vector3.yAxis
		add(Vector3.new((b - a).Magnitude + 0.02, th, th),
			CFrame.lookAt((a + b) * 0.5, b, up) * CFrame.Angles(0, PI / 2, 0), col, Enum.PartType.Cylinder, 0.15)
	end

	-- ragged flesh ring where the neck was torn
	for i = 1, 9 do
		local ang = i / 9 * PI * 2
		local sz = rr(0.2, 0.4)
		add(Vector3.new(sz, sz * rr(0.5, 1), sz),
			CFrame.new(math.cos(ang) * 0.46, baseY + sign * 0.05, math.sin(ang) * 0.34) * CFrame.Angles(rr(-0.5, 0.5), rr(0, PI), rr(-0.5, 0.5)),
			FLESH[rng:NextInteger(1, #FLESH)], nil, 0.12)
	end

	-- vertebrae: disc body + side wings + the spike at the back; each one slightly crooked
	for i = 0, count - 1 do
		local y = baseY + sign * (0.14 + i * 0.2)
		local tilt = rr(-0.22, 0.22)
		local col = BONE_COL:Lerp(CFG.BloodColor, rr(0, 0.45))
		local base = CFrame.new(rr(-0.04, 0.04) * (i + 1), y, 0.14 + rr(-0.03, 0.03) * (i + 1))
			* CFrame.Angles(tilt, rr(-0.3, 0.3), tilt)
		add(Vector3.new(0.15, 0.36, 0.36), base * CFrame.Angles(0, 0, PI / 2), col, Enum.PartType.Cylinder)
		add(Vector3.new(0.62, 0.07, 0.1), base * CFrame.new(0, 0, 0.05), col)
		add(Vector3.new(0.08, 0.1, 0.3), base * CFrame.new(0, 0, 0.26), col)
	end

	local topY = baseY + sign * (0.14 + (count - 1) * 0.2 + 0.2)
	tube(Vector3.new(0, baseY + sign * 0.1, 0.12), Vector3.new(0.12, topY + sign * 0.45, 0.06), 0.07, Color3.fromRGB(232, 214, 168)) -- spinal cord
	tube(Vector3.new(0, baseY + sign * 0.02, -0.14), Vector3.new(0.03, topY + sign * 0.1, -0.2), 0.17, Color3.fromRGB(212, 120, 128)) -- windpipe
	tube(Vector3.new(0.09, baseY + sign * 0.02, -0.02), Vector3.new(0.14, topY + sign * 0.28, -0.06), 0.1, Color3.fromRGB(150, 30, 40)) -- gullet
	return neck
end

