function buildGunModel()
    local S = GUN_SCALE
    local model = Instance.new("Model")
    model.Name = "PortalGun"

    local WHITE     = Color3.fromRGB(232, 238, 233)
    local WHITE_LO  = Color3.fromRGB(158, 168, 163)
    local NECK      = Color3.fromRGB(205, 211, 207)
    local PANEL     = Color3.fromRGB(196, 204, 200)
    local DARK      = Color3.fromRGB(40, 44, 43)
    local DARK_GREY = Color3.fromRGB(78, 86, 83)
    local MINT      = Color3.fromRGB(196, 236, 232)
    local GLASS     = Color3.fromRGB(120, 255, 105)
    local FILL      = Color3.fromRGB(55, 190, 50)
    local NEON      = Color3.fromRGB(165, 255, 110)
    local DOT       = Color3.fromRGB(110, 255, 95)
    local RED       = Color3.fromRGB(224, 38, 38)
    local RED_DARK  = Color3.fromRGB(112, 16, 16)
    local YELLOW    = Color3.fromRGB(242, 200, 36)
    local PURPLE    = Color3.fromRGB(128, 72, 188)
    local SMOOTH    = Enum.Material.SmoothPlastic
    local NEONMAT   = Enum.Material.Neon

    local function finish(p)
        p.Anchored = false
        p.CanCollide = false
        p.CanTouch = false
        p.CanQuery = false
        p.CastShadow = false
        p.Massless = true
        p.TopSurface = Enum.SurfaceType.Smooth
        p.BottomSurface = Enum.SurfaceType.Smooth
        p.Parent = model
        return p
    end

    local function setCF(p, cf)
        p.CFrame = CFrame.new(cf.Position * S) * cf.Rotation
    end

    local function block(name, size, cf, color, material, transparency)
        local p = Instance.new("Part")
        p.Name = name
        p.Size = size * S
        p.Color = color
        p.Material = material or SMOOTH
        p.Transparency = transparency or 0
        setCF(p, cf)
        return finish(p)
    end

    local function wedge(name, size, cf, color, material)
        local p = Instance.new("WedgePart")
        p.Name = name
        p.Size = size * S
        p.Color = color
        p.Material = material or SMOOTH
        setCF(p, cf)
        return finish(p)
    end

    local function ball(name, diameter, pos, color, material, transparency)
        local p = Instance.new("Part")
        p.Shape = Enum.PartType.Ball
        p.Name = name
        p.Size = Vector3.new(diameter, diameter, diameter) * S
        p.Color = color
        p.Material = material or SMOOTH
        p.Transparency = transparency or 0
        setCF(p, CFrame.new(pos))
        return finish(p)
    end

    local function cyl(name, axis, diameter, length, pos, color, material, transparency)
        local p = Instance.new("Part")
        p.Shape = Enum.PartType.Cylinder
        p.Name = name
        p.Size = Vector3.new(length, diameter, diameter) * S
        p.Color = color
        p.Material = material or SMOOTH
        p.Transparency = transparency or 0
        local rot = CFrame.new()
        if axis == "Y" then
            rot = CFrame.Angles(0, 0, math.rad(90))
        elseif axis == "Z" then
            rot = CFrame.Angles(0, math.rad(90), 0)
        end
        setCF(p, CFrame.new(pos) * rot)
        return finish(p)
    end

    local function segment(name, a, b, thick, color)
        local d = (b - a).Magnitude
        if d < 0.001 then return nil end
        return block(name, Vector3.new(thick, thick, d), CFrame.lookAt((a + b) / 2, b), color, NEONMAT)
    end

    local DC = GUN_DOME_CENTER
    local DZ = DC.Z

    block("Handle", Vector3.new(0.5, 0.36, 0.62), CFrame.new(0, 0, 0), NECK)
    block("RearCap", Vector3.new(0.5, 0.36, 0.05), CFrame.new(0, 0, 0.335), DARK_GREY)

    block("RedBezel", Vector3.new(0.03, 0.28, 0.28), CFrame.new(0.255, 0, 0.02), RED_DARK)
    block("RedPad", Vector3.new(0.035, 0.22, 0.22), CFrame.new(0.27, 0, 0.02), RED)
    block("RedPadShine", Vector3.new(0.037, 0.05, 0.16), CFrame.new(0.272, 0.07, 0.02), Color3.fromRGB(255, 120, 110))

    block("BodyUpper", Vector3.new(0.74, 0.64, 0.9), CFrame.new(0, 0.08, -1.07), WHITE)
    block("BodyLower", Vector3.new(0.74, 0.16, 0.9), CFrame.new(0, -0.32, -1.07), WHITE_LO)
    block("TaperCore", Vector3.new(0.7, 0.36, 0.31), CFrame.new(0, 0, -0.465), WHITE)
    wedge("TaperTop", Vector3.new(0.7, 0.22, 0.31), CFrame.new(0, 0.29, -0.465) * CFrame.Angles(0, math.pi, 0), WHITE)
    wedge("TaperBottom", Vector3.new(0.7, 0.22, 0.31), CFrame.new(0, -0.29, -0.465) * CFrame.Angles(0, math.pi, math.pi), WHITE_LO)

    block("SeamTop", Vector3.new(0.745, 0.012, 0.905), CFrame.new(0, 0.39, -1.07), DARK_GREY)
    block("SeamLow", Vector3.new(0.745, 0.012, 0.905), CFrame.new(0, -0.24, -1.07), DARK_GREY)

    block("FrontRim", Vector3.new(0.66, 0.7, 0.03), CFrame.new(0, 0, -1.535), DARK_GREY)
    block("FrontPanel", Vector3.new(0.58, 0.62, 0.03), CFrame.new(0, 0, -1.55), PANEL)
    for ix = -1, 1 do
        for iy = -1, 1 do
            local x, y = ix * 0.18, iy * 0.18
            cyl("EmitterRing", "Z", 0.15, 0.02, Vector3.new(x, y, -1.57), DARK)
