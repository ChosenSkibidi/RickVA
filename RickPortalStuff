-- a valid target is alive and itself above the void line
function isValidVoidTarget(plr)
    char = plr and plr.Character
    hum = char and char:FindFirstChildOfClass("Humanoid")
    r = char and char:FindFirstChild("HumanoidRootPart")
    return hum ~= nil and r ~= nil and hum.Health > 0 and r.Position.Y >= VOID_Y
end

voidConn = RunService.Heartbeat:Connect(function()
    char = LocalPlayer.Character
    root = char and char:FindFirstChild("HumanoidRootPart")
    hum = char and char:FindFirstChildOfClass("Humanoid")
    if not root or not hum or hum.Health <= 0 then return end

    -- above the line: keep track of who you're standing near
    if root.Position.Y >= VOID_Y then
        best, bestDist = nil, VOID_NEAR_RADIUS
        for _, plr in ipairs(Players:GetPlayers()) do
            if plr ~= LocalPlayer and isValidVoidTarget(plr) then
                dist = (plr.Character.HumanoidRootPart.Position - root.Position).Magnitude
                if dist <= bestDist then
                    best, bestDist = plr, dist
                end
            end
        end
        if best then
            void.lastNear = best
            void.lastNearTime = os.clock()
        end
        return
    end

    -- below it (but not if you're at an area that is meant to be down there, like the Garage)
    for _, a in ipairs(AREAS) do
        if a.voidSafe and (root.Position - a.cframe.Position).Magnitude <= VOID_SAFE_RADIUS then
            return
        end
    end
    if failsafe.retreating or os.clock() - void.lastTrigger < VOID_COOLDOWN then return end
    void.lastTrigger = os.clock()

    area = nil
    landCFrame = nil
    target = void.lastNear
    if target and os.clock() - void.lastNearTime <= VOID_MEMORY and isValidVoidTarget(target) then
        tRoot = target.Character.HumanoidRootPart
        look = flatXZ(tRoot.CFrame.LookVector)
        look = look.Magnitude > 0.01 and look.Unit or Vector3.new(0, 0, -1)
        landPos = tRoot.Position - look * VOID_BEHIND_DISTANCE
        landCFrame = CFrame.new(landPos, Vector3.new(tRoot.Position.X, landPos.Y, tRoot.Position.Z))
    else
        area = findArea(VOID_FALLBACK_AREA)
        if not area then return end
        myLook = flatXZ(root.CFrame.LookVector)
        myLook = myLook.Magnitude > 0.01 and myLook.Unit or Vector3.new(0, 0, -1)
        landCFrame = CFrame.lookAt(area.cframe.Position, area.cframe.Position + myLook)
    end

    emitDodgeBurst(root)
    root.AssemblyLinearVelocity = Vector3.zero
    root.AssemblyAngularVelocity = Vector3.zero
    root.CFrame = landCFrame
    playDodgeArrival(root.Parent, root, true)

    if area and area.onArrive then
        task.spawn(area.onArrive)
    end
end)

