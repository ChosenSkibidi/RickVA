	AutoPlay    = true,  -- plays on every respawn (not on execute)
	SpawnWait   = 0,     -- max seconds to wait for clothes to load after a respawn (0 = instant)
	SpawnDelay  = 0.4,   -- seconds after every respawn before the corpse starts regenerating

	-- timeline (sim seconds)
	T_Burst     = 0.65,  -- windup length before everything blows
	T_Regrow    = 2.0,   -- veins start regenerating
	T_Lift      = 3.0,   -- torso hauls itself back up
	T_Pull      = 3.75,  -- limbs start getting yanked home
	LiftTime    = 0.85,
	PullTime    = 0.46,  -- per limb
	PullStagger = 0.10,

	-- burst feel
