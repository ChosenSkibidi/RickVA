        camera,
        TweenInfo.new(duration, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut),
        { FieldOfView = PORTAL_FOV_ZOOM }
    )
    activeFovTween:Play()
end

function playSound(id, volume, parent, sound)
    sound = Instance.new("Sound")
    sound.SoundId = id
    sound.Volume = volume
    sound.Parent = parent
    sound.Ended:Once(function()
        sound:Destroy()
    end)
    sound:Play()
    task.delay(15, function()
        if sound.Parent then
            sound:Destroy()
        end
    end)
    return sound
end

function playSounds(ids, parent, sound, firstSound)
    if not parent then return end
    for _, entry in ipairs(ids) do
        sound = playSound(
            type(entry) == "table" and entry.id or entry,
            type(entry) == "table" and entry.volume or SOUND_VOLUME,
            parent
        )
        firstSound = firstSound or sound
    end
    return firstSound
end

function playCharacterAnimation(character, animationId, humanoid, animator, animation, loaded, track)
    humanoid = character and character:FindFirstChildOfClass("Humanoid")
    animator = humanoid and humanoid:FindFirstChildOfClass("Animator")
    if not animator then return nil end
    animation = Instance.new("Animation")
    animation.AnimationId = animationId
    loaded, track = pcall(function()
        return animator:LoadAnimation(animation)
    end)
    if loaded and track then
        track.Priority = Enum.AnimationPriority.Action4
        track:Play()
        track.Stopped:Once(function()
            animation:Destroy()
        end)
        return track
    else
        warn("[RickPortal] animation failed to load: " .. animationId)
        animation:Destroy()
        return nil
    end
end

