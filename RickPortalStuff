function startDodge(attackerChar, attackerId, nextCount, playStreakVoice, playVoice)
    if failsafe.retreating or os.clock() < dodge.cooldownEnd or isDodgeBlockedByAnimation() then return end

    attackerId = Players:GetPlayerFromCharacter(attackerChar) or attackerChar
    if dodgeStreak.target == attackerId then
        nextCount = dodgeStreak.count + 1
    else
        nextCount = 1
    end
    playStreakVoice = nextCount >= DODGE_STREAK_COUNT
    playVoice = not playStreakVoice and math.random() < DODGE_VOICE_CHANCE

    if teleportBehind(attackerChar, playVoice, playStreakVoice) then
        dodge.cooldownEnd = os.clock() + DODGE_COOLDOWN
        dodgeStreak.target = attackerId
        dodgeStreak.count = playStreakVoice and 0 or nextCount
        lockCameraOn(attackerChar:FindFirstChild("HumanoidRootPart"), DODGE_CAMERA_LOCK_TIME)
        task.spawn(clickMouse)
        if playStreakVoice then
            rickSay(RICK_QUIT_LINES) -- shows up with the sixth-dodge audio
        end
    end
end

