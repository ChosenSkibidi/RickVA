local function makeStump(parent, piece, localCF, size, limbName)
	local nm = limbName or piece.name
	local isSocket = piece.name == "Torso"
	local isLeg, isArm = nm:find("Leg") ~= nil, nm:find("Arm") ~= nil
	local noBone = isSocket or nm == "Head" -- sockets use the pelvis / glenoid cup / neck stack instead of a bare stick

	local cap = newPart(parent, size, Color3.fromRGB(132, 8, 18))
	cap.Name = "Cap"
	cap.Transparency = 1
	-- broken shaft: ivory cortex with a dark marrow core showing through both ends
	local bone = newPart(parent, Vector3.new(0.55, 0.3, 0.3), Color3.fromRGB(238, 228, 208):Lerp(CFG.BloodColor, rr(0, 0.25)), Enum.PartType.Cylinder)
	bone.Name = "Bone"
	bone.Transparency = 1
	local marrow = newPart(parent, Vector3.new(0.59, 0.15, 0.15), Color3.fromRGB(150, 36, 46), Enum.PartType.Cylinder)
	marrow.Reflectance = 0.2
	marrow.Transparency = 1

	local shards, extras = {}, {}
	local function extra(sz, cf, col, shape, refl)
		local ep = newPart(parent, sz, col, shape)
		ep.Transparency = 1
		if refl then ep.Reflectance = refl end
		extras[#extras + 1] = { part = ep, cf = cf }
	end
	if not noBone then
		-- jagged splinters sticking out of the broken bone
		for _ = 1, 3 do
			local sp = newPart(parent, Vector3.new(0.09, 0.09, rr(0.3, 0.65)), Color3.fromRGB(232, 220, 196):Lerp(CFG.BloodColor, rr(0, 0.35)))
			sp.Transparency = 1
			shards[#shards + 1] = {
				part = sp,
				cf = CFrame.new(rr(-0.26, 0.26), rr(0.12, 0.4), rr(-0.26, 0.26)) * CFrame.Angles(PI / 2 + rr(-0.55, 0.55), rr(0, PI * 2), rr(-0.55, 0.55)),
			}
		end
		-- the joint end of the bone pushed out of the cut: femoral head on a short neck, or humeral head
		local headCol = Color3.fromRGB(240, 232, 214):Lerp(CFG.BloodColor, rr(0, 0.25))
		if isLeg then
			extra(Vector3.new(0.55, 0.55, 0.55), CFrame.new(0.05, 0.68, 0), headCol, Enum.PartType.Ball, 0.1)
			extra(Vector3.new(0.4, 0.2, 0.2), CFrame.new(0.02, 0.44, 0) * CFrame.Angles(0, 0, PI / 2 + 0.45), headCol, Enum.PartType.Cylinder)
		elseif isArm then
			extra(Vector3.new(0.42, 0.42, 0.42), CFrame.new(0.03, 0.54, 0), headCol, Enum.PartType.Ball, 0.1)
		end
	elseif isSocket and isArm then
		-- shoulder socket: a ring of bone around a dark cup (the glenoid)
		for i = 1, 7 do
			local ang = i / 7 * PI * 2
			extra(Vector3.new(0.16, 0.1, 0.14),
				CFrame.new(math.cos(ang) * 0.3, 0.08, math.sin(ang) * 0.3) * CFrame.Angles(rr(-0.3, 0.3), ang, rr(-0.3, 0.3)),
				Color3.fromRGB(236, 226, 204):Lerp(CFG.BloodColor, rr(0, 0.35)))
		end
		extra(Vector3.new(0.05, 0.5, 0.5), CFrame.new(0, 0.03, 0) * CFrame.Angles(0, 0, PI / 2), Color3.fromRGB(92, 4, 10), Enum.PartType.Cylinder, 0.2)
	end
	return {
		piece = piece, localCF = localCF, cap = cap, bone = bone, marrow = marrow, noBone = noBone,
		shards = shards, extras = extras, em = makeEmitter(cap), acc = 0, shown = false,
	}
end

local function updateStump(s)
	local base = s.piece.disp * s.localCF
	s.cap.CFrame = base * CFrame.new(0, 0.04, 0)
	local boneCF = base * CFrame.new(0, 0.3, 0) * CFrame.Angles(0, 0, PI / 2)
	s.bone.CFrame = boneCF
	s.marrow.CFrame = boneCF
	for _, sh in ipairs(s.shards) do
		sh.part.CFrame = base * sh.cf
	end
	for _, ex in ipairs(s.extras) do
		ex.part.CFrame = base * ex.cf
	end
end

local function showStump(s, on)
	local t = on and 0 or 1
	s.cap.Transparency = t
	s.bone.Transparency = s.noBone and 1 or t
	s.marrow.Transparency = s.noBone and 1 or t
	for _, sh in ipairs(s.shards) do sh.part.Transparency = t end
	for _, ex in ipairs(s.extras) do ex.part.Transparency = t end
	s.shown = on
end

