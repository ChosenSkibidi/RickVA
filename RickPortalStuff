function orbBezier(p0, p1, p2, p3, t)
    local u = 1 - t
    return p0 * (u * u * u) + p1 * (3 * u * u * t) + p2 * (3 * u * t * t) + p3 * (t * t * t)
end

function orbPop(pos, fromSize, toSize, life, color)
    local pop = Instance.new("Part")
    pop.Shape = Enum.PartType.Ball
    pop.Material = Enum.Material.Neon
    pop.Color = color
    pop.Transparency = 0.15
    pop.Size = Vector3.new(fromSize, fromSize, fromSize)
    pop.Anchored = true
    pop.CanCollide = false
    pop.CanTouch = false
    pop.CanQuery = false
    pop.CastShadow = false
    pop.Position = pos
    pop.Parent = workspace
    local tween = TweenService:Create(
        pop,
        TweenInfo.new(life, Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
        { Size = Vector3.new(toSize, toSize, toSize), Transparency = 1 }
    )
    tween.Completed:Once(function()
        pop:Destroy()
    end)
    tween:Play()
end

