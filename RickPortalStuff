function nearestEnemyChar()
    local character = LocalPlayer.Character
    local root = character and character:FindFirstChild("HumanoidRootPart")
    if not root then return nil end
    local best, bestDist = nil, math.huge
    for _, t in ipairs(getTargets()) do
        local hum = t.root.Parent and t.root.Parent:FindFirstChildOfClass("Humanoid")
        if t.root.Parent and (not hum or hum.Health > 0) then
            local d = (t.root.Position - root.Position).Magnitude
            if d < bestDist then
                best, bestDist = t.root.Parent, d
            end
        end
    end
    return best
end

