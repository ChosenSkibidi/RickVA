-- play()					-> old behaviour: explode + regenerate the (alive) character
-- play(true, deadCharacter) -> you just died: explode now, leave a corpse, regenerate after you respawn
local function play(deathMode, deadChar)
	if deathMode and (S.Fired or workspace:FindFirstChild("RickRegenFX")) then return end
	if deathMode and S.abort then pcall(S.abort) end -- a fresh death replaces whatever is still playing
	if S.running then return end
	local char = deadChar or lp.Character
	local hum = char and char:FindFirstChildOfClass("Humanoid")
	local hrp = char and char:FindFirstChild("HumanoidRootPart")
	if not (hum and hrp) then return end
	if not deathMode and hum.Health <= 0 then return end
	if hum.RigType ~= Enum.HumanoidRigType.R6 then
		warn("[RickRegen] R6 only.")
		return
	end
	for _, spec in ipairs(SPEC) do
		if not char:FindFirstChild(spec.name) then
			warn("[RickRegen] missing part: " .. spec.name)
			return
		end
	end
	local cam = workspace.CurrentCamera
	if not cam then return end

	S.running = true
	if deathMode then S.Fired = true end
	S.RegenSoundPlayed = false
	S.fadeAt = math.huge
	S.splats = 0
	S.trauma, S.flash, S.fov, S.zoom, S.beatPhase = 0, 0, 0, 0, 0
	table.clear(fx)
	table.clear(drops)
	table.clear(gibs)

	local folder = Instance.new("Folder")
	folder.Name = "RickRegenFX"
	folder.Parent = workspace
	S.folder = folder

	local rp = RaycastParams.new()
	rp.FilterType = Enum.RaycastFilterType.Exclude
	rp.FilterDescendantsInstances = { char, folder }
	rp.RespectCanCollide = true
	S.rp = rp
	local gHit = workspace:Raycast(hrp.Position, Vector3.new(0, -30, 0), rp)
	S.groundY = gHit and gHit.Position.Y or (hrp.Position.Y - 3)

	-- fake body ------------------------------------------------
	char.Archivable = true
	local clone = char:Clone()
	if not clone then
		folder:Destroy()
		S.running = false
		return
	end
	for _, d in ipairs(clone:GetDescendants()) do
		if d:IsA("LuaSourceContainer") or d:IsA("Motor6D") or d:IsA("Tool") or d:IsA("Sound") or d:IsA("Accessory") or d:IsA("WeldConstraint") or d:IsA("Weld") then
			d:Destroy()
		end
	end
	local cHrp = clone:FindFirstChild("HumanoidRootPart")
	if cHrp then cHrp:Destroy() end
	local cHum = clone:FindFirstChildOfClass("Humanoid")
	if cHum then
		pcall(function()
			cHum.RequiresNeck = false
			cHum.BreakJointsOnDeath = false
			cHum.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.None
			cHum.HealthDisplayType = Enum.HumanoidHealthDisplayType.AlwaysOff
		end)
	end
	for _, d in ipairs(clone:GetDescendants()) do
		if d:IsA("BasePart") then
			d.Anchored = true
			d.CanCollide = false
			d.CanQuery = false
			d.CanTouch = false
			d.Massless = true
		end
	end
	clone.Name = "RickRegenBody"
	clone.Parent = folder

	-- pieces ---------------------------------------------------
	local pieces, limbs, stumps, sockets, veins = {}, {}, {}, {}, {}
	local torsoP
	for _, spec in ipairs(SPEC) do
		local fake = clone:FindFirstChild(spec.name)
		local real = char:FindFirstChild(spec.name)
		if not (fake and real) then
			clone:Destroy()
			folder:Destroy()
			S.running = false
			return
		end
		local p = {
			name = spec.name, spec = spec, fake = fake, real = real, size = fake.Size,
			cf = fake.CFrame, disp = fake.CFrame, vel = Vector3.zero, av = Vector3.zero,
			state = "intact", seed = rr(1, 90) + 0.37, lastImpact = -1, still = 0,
			dirW = Vector3.zero, order = spec.order or 0, veins = {}, regrown = false,
		}
		pieces[#pieces + 1] = p
		if spec.name == "Torso" then torsoP = p else limbs[#limbs + 1] = p end
	end
	local meshFake, meshOffset, headPiece = clone:FindFirstChild("CustomMesh"), nil, nil
	for _, p in ipairs(limbs) do
		if p.name == "Head" then headPiece = p end
	end
	if meshFake and headPiece then
		meshOffset = headPiece.fake.CFrame:ToObjectSpace(meshFake.CFrame)
	end
	local gunFollowers, armPiece = {}, nil
	for _, p in ipairs(limbs) do
		if p.name == "Right Arm" then armPiece = p end
	end
	if armPiece then
		local gunFake = armPiece.fake:FindFirstChild("PortalGun")
		if gunFake then
			for _, d in ipairs(gunFake:GetDescendants()) do
				if d:IsA("BasePart") then
					gunFollowers[#gunFollowers + 1] = { part = d, offset = armPiece.fake.CFrame:ToObjectSpace(d.CFrame) }
				end
			end
		end
	end
	local torsoCF0 = torsoP.cf
	for _, p in ipairs(limbs) do
		p.dirW = (torsoCF0:VectorToWorldSpace(p.spec.dir).Unit + Vector3.new(rr(-0.25, 0.25), rr(0, 0.2), rr(-0.25, 0.25))).Unit
		p.stump = makeStump(clone, p, p.spec.stump, p.spec.size)
		sockets[p.name] = makeStump(clone, torsoP, p.spec.socket, p.spec.size, p.name)
		stumps[#stumps + 1] = p.stump
		stumps[#stumps + 1] = sockets[p.name]
		for _ = 1, 3 do
			p.veins[#p.veins + 1] = makeVein(folder, p, p.spec.stump, torsoP, p.spec.socket, "L", rr(0.13, 0.24))
		end
		for _ = 1, 2 do
			p.veins[#p.veins + 1] = makeVein(folder, torsoP, p.spec.socket, p, p.spec.stump, "S", rr(0.10, 0.19))
		end
		for _, v in ipairs(p.veins) do veins[#veins + 1] = v end
	end

	local chest = buildChest(folder)
	local armBones = {} -- every limb's exposed bones, keyed by piece (arms, legs, and the neck stub on the head)
	for _, ap in ipairs(limbs) do
		if ap.name == "Right Arm" or ap.name == "Left Arm" then
			armBones[ap] = buildArmBones(folder, 1)
		elseif ap.name == "Right Leg" or ap.name == "Left Leg" then
			armBones[ap] = buildArmBones(folder, 1.3)
		elseif ap.name == "Head" then
			armBones[ap] = buildNeckBones(folder, -1, -0.5, 3)
		end
	end
	local torsoNeck = buildNeckBones(folder, 1, 1.0, 5)

	-- hide + freeze the real character -------------------------
	local hidden, hideConn = {}, nil
	local saved = { ws = 16, jp = 50, jh = 7.2, auto = true, anch = false }
	local function freezeChar()
		saved = {
			ws = hum.WalkSpeed, jp = hum.JumpPower, jh = hum.JumpHeight,
			auto = hum.AutoRotate, anch = saved.anch,
		}
		hum.WalkSpeed = 0
		hum.JumpPower = 0
		hum.JumpHeight = 0
		hum.AutoRotate = false
		hrp.Anchored = true
	end
	if deathMode then
		-- the body that just died only gets hidden (the fake body does the exploding); the next body replaces it
		for _, d in ipairs(char:GetDescendants()) do
			if d:IsA("BasePart") or d:IsA("Decal") then d.Transparency = 1 end
		end
	else
		for _, d in ipairs(char:GetDescendants()) do
			if d:IsA("BasePart") or d:IsA("Decal") then
				hidden[d] = d.Transparency
				d.Transparency = 1
			end
		end
		saved.anch = hrp.Anchored
		freezeChar()
	end

	-- screen + body glow ---------------------------------------
	local cc = Instance.new("ColorCorrectionEffect")
	cc.Name = "RickRegenCC"
	cc.Parent = Lighting
	local blur = Instance.new("BlurEffect")
	blur.Name = "RickRegenBlur"
	blur.Size = 0
	blur.Parent = Lighting
	local hl = Instance.new("Highlight")
	hl.Adornee = clone
	hl.FillColor = Color3.fromRGB(255, 30, 40)
	hl.OutlineColor = Color3.fromRGB(255, 110, 70)
	hl.FillTransparency = 1
	hl.OutlineTransparency = 0.5
	hl.DepthMode = Enum.HighlightDepthMode.Occluded
	hl.Parent = clone
	local light = Instance.new("PointLight")
	light.Color = Color3.fromRGB(255, 40, 40)
	light.Range = 16
	light.Brightness = 0
	light.Shadows = false
	light.Parent = torsoP.fake

	-- run state ------------------------------------------------
	local baseFov = cam.FieldOfView
	local clock, realSince = CFG.T_Burst, 0
	local rawClock, HOLD_T = CFG.T_Burst, CFG.T_Regrow - 0.05 -- the corpse waits at HOLD_T until you've respawned
	local burstDone, finished, restored = false, false, false
	local pre, heat, beat, redAmt = 0, 0, 0, 0
	local bindName = "RickRegen_" .. tostring(os.clock())
	local poolT, chestAcc, suckGibs = 0, 0, false

	local function restoreChar()
		if restored then return end
		restored = true
		if hideConn then
			hideConn:Disconnect()
			hideConn = nil
		end
		for inst, tr in pairs(hidden) do
			if inst.Parent then inst.Transparency = tr end
		end
		if hrp.Parent then hrp.Anchored = saved.anch end
		if hum.Parent then
			hum.WalkSpeed = saved.ws
			hum.JumpPower = saved.jp
			hum.JumpHeight = saved.jh
			hum.AutoRotate = saved.auto
		end
	end

	local function fullCleanup()
		pcall(function() RunService:UnbindFromRenderStep(bindName) end)
		if clone.Parent then clone:Destroy() end
		cc:Destroy()
		blur:Destroy()
		folder:Destroy()
		table.clear(fx)
		table.clear(drops)
		table.clear(gibs)
		local c = workspace.CurrentCamera
		if c then c.FieldOfView = baseFov end
		S.corpse = nil
		S.abort = nil
		S.running = false
	end

	local function abort()
		clearRegenSounds()
		clearSlamSound()
		restoreChar()
		fullCleanup()
	end

	local function doBurst()
		S.flash, S.trauma, S.fov = 1, 1, 16
		for _, cfg in ipairs(EXPLODE_SFX) do
			playTagged(EXPLODE_TAG, cfg)
		end
		for _, p in ipairs(pieces) do
			p.state = "phys"
			if p == torsoP then
				p.vel = Vector3.new(rr(-3, 3), 17, rr(-3, 3)) - p.cf.LookVector * 7
				p.av = p.cf.RightVector * rr(2.5, 4.5)
			else
				p.vel = p.dirW * rr(CFG.BurstSpeed[1], CFG.BurstSpeed[2])
				p.av = Vector3.new(rr(-1, 1), rr(-1, 1), rr(-1, 1)).Unit * rr(9, 20)
			end
		end
		for _, s in ipairs(stumps) do
			showStump(s, true)
			updateStump(s)
			s.em:Emit(60)
			local base = s.piece.disp * s.localCF
			local n = base.UpVector
			for _ = 1, 22 do
				spawnDrop(base.Position, n * rr(16, 44) + Vector3.new(rr(-10, 10), rr(0, 14), rr(-10, 10)))
			end
		end
		-- chest blown open: ribcage + organs revealed, meat and bone fly out
		showChest(chest, true)
		updateChest(chest, torsoP.disp, 0)
		for ap, ab in pairs(armBones) do
			showChest(ab, true)
			updateChest(ab, ap.disp, 0)
		end
		showChest(torsoNeck, true)
		updateChest(torsoNeck, torsoP.disp, 0)
		local tcf = torsoP.cf
		local cpos = (tcf * CFrame.new(0, 0.1, -0.6)).Position
		for _ = 1, 34 do
			spawnDrop(cpos, tcf.LookVector * rr(10, 36) + Vector3.new(rr(-9, 9), rr(-2, 12), rr(-9, 9)))
		end
		for _ = 1, 9 do
			spawnGib(cpos, tcf.LookVector * rr(6, 20) + Vector3.new(rr(-8, 8), rr(6, 18), rr(-8, 8)), false)
		end
		for _ = 1, 7 do
			spawnGib(cpos, tcf.LookVector * rr(6, 18) + Vector3.new(rr(-8, 8), rr(6, 16), rr(-8, 8)), true)
		end
		for _, lp in ipairs(limbs) do
			local lb = lp.cf * lp.spec.stump
			local ln = lb.UpVector
			for _ = 1, 3 do
				spawnGib(lb.Position, ln * rr(8, 22) + Vector3.new(rr(-7, 7), rr(2, 12), rr(-7, 7)), false)
			end
			spawnGib(lb.Position, ln * rr(8, 18) + Vector3.new(rr(-5, 5), rr(2, 10), rr(-5, 5)), true)
		end
		for _, v in ipairs(veins) do
			setMode(v, (v.kind == "L") and "tether" or "dangle", clock)
		end
	end

	local slamPlayed = false
	local function startPull(p)
		if not slamPlayed then
			slamPlayed = true
			suckGibs = true
			if S.sfxId then playTagged(SLAM_TAG, { id = S.sfxId, volume = SLAM_VOLUME }) end
		end
		p.state = "pull"
		p.pull0 = clock
		p.p0 = p.cf.Position
		p.rot0 = p.cf - p.cf.Position
		local tp = p.real.Position
		p.ctrl = (p.p0 + tp) * 0.5 + Vector3.new(rr(-3, 3), rr(6, 10), rr(-3, 3))
		p.spin = rr(1.5, 3.5) * PI
		for _, v in ipairs(p.veins) do
			if v.mode ~= "attached" then setMode(v, "attached", clock) end
		end
	end

	local function onSnap(p)
		local pos = (p.real.CFrame * p.spec.stump).Position
		glowBall(pos, Color3.fromRGB(255, 70, 70), 4.5, 0.26)
		glowBall(pos, Color3.fromRGB(255, 230, 210), 2.2, 0.14)
		p.stump.em:Emit(16)
		sockets[p.name].em:Emit(22)
		for _ = 1, 10 do
			spawnDrop(pos, Vector3.new(rr(-16, 16), rr(2, 18), rr(-16, 16)))
		end
		showStump(p.stump, false)
		showStump(sockets[p.name], false)
		if p.name == "Head" then showChest(torsoNeck, false) end
		if armBones[p] then
			showChest(armBones[p], false)
			for _ = 1, 4 do
				spawnGib(pos, Vector3.new(rr(-12, 12), rr(4, 14), rr(-12, 12)), true)
			end
		end
		for _, v in ipairs(p.veins) do setMode(v, "retract", clock) end
		S.trauma = math.min(1, S.trauma + 0.32)
		S.flash = math.max(S.flash, 0.4)
		S.fov = S.fov + 3.5
	end

	local function finale()
		S.flash, S.trauma = 1, 1
		S.fov = S.fov + 12
		local c = torsoP.real.Position
		for _ = 1, 90 do
			local a = rr(0, PI * 2)
			local sp = rr(8, 32)
			spawnDrop(c, Vector3.new(math.cos(a) * sp, rr(6, 28), math.sin(a) * sp))
		end
		-- the chest seals up: ribcage and organs burst out as the flesh closes over them
		suckGibs = false
		showChest(chest, false)
		for k = 1, 18 do
			local a = rr(0, PI * 2)
			local sp = rr(7, 20)
			spawnGib(c, Vector3.new(math.cos(a) * sp, rr(8, 20), math.sin(a) * sp), k > 10)
		end
		restoreChar()
		pcall(function() -- your body is back: play the finish animation right now, slowed down
			local track = playCharacterAnimation(char, FINALE_ANIMATION_ID)
			if track then
				track.TimePosition = FINALE_ANIMATION_START
				track:AdjustSpeed(FINALE_ANIMATION_SPEED)
			end
		end)
		rickSay() -- Rick Prime dialogue, the instant every part has slammed together
		clearRegenSounds() -- accessories are visible again: stop the start sound
		-- layered finale sounds, all started together (leftovers from an earlier run get wiped first)
		for _, inst in ipairs(workspace:GetChildren()) do
			if inst:IsA("Sound") and inst.Name == FINALE_TAG then inst:Destroy() end
		end
		for _, cfg in ipairs(FINALE_SFX) do
			playTagged(FINALE_TAG, cfg)
		end
		-- accessories come back with a white occluded highlight that fades out
		for _, acc in ipairs(char:GetChildren()) do
			if acc:IsA("Accessory") then
				local h = Instance.new("Highlight")
				h.Adornee = acc
				h.FillColor = Color3.new(1, 1, 1)
				h.OutlineColor = Color3.new(1, 1, 1)
				h.FillTransparency = 0
				h.OutlineTransparency = 0
				h.DepthMode = Enum.HighlightDepthMode.Occluded
				h.Parent = acc
				local tw = TweenService:Create(h, TweenInfo.new(0.8), { FillTransparency = 1, OutlineTransparency = 1 })
				tw.Completed:Connect(function() h:Destroy() end)
				tw:Play()
			end
		end
		-- fake body goes invisible (kept alive so the last mist bursts can finish)
		for _, d in ipairs(clone:GetDescendants()) do
			if d:IsA("BasePart") or d:IsA("Decal") then d.Transparency = 1 end
		end
		for _, v in ipairs(veins) do v.beam.Enabled = false end
		hl.Enabled = false
		light.Brightness = 0
		S.fadeAt = os.clock() + 1.0
		finished = true
		S.corpse = nil
	end

	local function noise3(t, seed)
		return Vector3.new(math.noise(t, seed, 0.5), math.noise(seed, t, 0.5), math.noise(0.5, t, seed))
	end

	local function step(dt)
		dt = math.min(dt, 1 / 15)
		local corpse = S.corpse
		if corpse and not corpse.bound then
			-- corpse phase: you haven't respawned yet, the explosion just plays out
		elseif not (hrp.Parent and hum.Parent) or hum.Health <= 0 then
			abort()
			return
		end
		-- the new body stays parked on the spot where you died until the regeneration is done
		if corpse and corpse.bound and not restored and hrp.Parent then
			hrp.CFrame = corpse.deathCF
		end
		local c = workspace.CurrentCamera
		local sdt = dt

		if not finished then
			-- time (hitstop -> slowmo ramp after the burst)
			local ts = 1
			if burstDone then
				realSince = realSince + dt
				if realSince < 0.07 then
					ts = 0.02
				else
					ts = lerp(CFG.Slowmo, 1, Ease.outCubic(clamp01((realSince - 0.07) / CFG.SlowTime)))
				end
			end
			sdt = dt * ts
			clock = clock + sdt
			rawClock = rawClock + sdt
			if S.corpse and S.corpse.holding and clock > HOLD_T then
				clock = HOLD_T -- freeze the timeline right before the veins regrow until the respawn releases it
			end

			if not burstDone and clock >= CFG.T_Burst then
				burstDone = true
				realSince = 0
				doBurst()
			end
			pre = burstDone and 1 or Ease.inCubic(clamp01(clock / CFG.T_Burst))
			heat = burstDone and clamp01((clock - CFG.T_Burst) / (CFG.T_Pull - CFG.T_Burst)) or 0
			local bpm = burstDone and lerp(72, 175, heat) or lerp(70, 140, pre)
			S.beatPhase = S.beatPhase + sdt * bpm / 60
			beat = heartbeat(S.beatPhase)

			-- triggers
			if burstDone then
				if not S.RegenSoundPlayed and clock >= CFG.T_Regrow then
					S.RegenSoundPlayed = true
					playTagged(START_TAG, EXTRA_SFX)
				end
				if (torsoP.state == "phys" or torsoP.state == "rest") and clock >= CFG.T_Lift then
					torsoP.state = "lift"
					torsoP.lift0 = clock
					torsoP.cfLift = torsoP.cf
				end
				for _, p in ipairs(limbs) do
					local k = p.order - 1
					if not p.regrown and clock >= CFG.T_Regrow + k * 0.1 then
						p.regrown = true
						for _, v in ipairs(p.veins) do
							v.dur = rr(0.8, 1.15)
							v.tip0 = v.lastTip
							setMode(v, "grow", clock)
						end
					end
					if (p.state == "phys" or p.state == "rest") and clock >= CFG.T_Pull + k * CFG.PullStagger then
						startPull(p)
					end
				end
			end

			-- pieces
			for _, p in ipairs(pieces) do
				local st = p.state
				if st == "intact" then
					local off = noise3(os.clock() * 38, p.seed) * (2 * 0.3 * pre) + p.dirW * (0.55 * pre)
					p.disp = p.cf + off
				elseif st == "phys" then
					simulate(p, sdt)
					p.disp = p.cf
				elseif st == "rest" then
					local amp = 0.03 + 0.14 * heat * heat
					local off = noise3(os.clock() * 30, p.seed) * (2 * amp) + Vector3.new(0, beat * 0.16 * heat, 0)
					p.disp = p.cf + off
				elseif st == "lift" then
					local a = clamp01((clock - p.lift0) / CFG.LiftTime)
					local tgt = p.real.CFrame
					p.disp = p.cfLift:Lerp(tgt, Ease.inOutCubic(a)) + Vector3.new(0, math.sin(PI * a) * 2.4, 0)
						+ noise3(os.clock() * 40, p.seed) * 0.12
					p.cf = p.disp
					if a >= 1 then p.state = "hover" end
				elseif st == "hover" then
					p.disp = p.real.CFrame + noise3(os.clock() * 36, p.seed) * 0.12
						+ Vector3.new(0, beat * 0.12, 0)
					p.cf = p.disp
				elseif st == "pull" then
					local a = clamp01((clock - p.pull0) / CFG.PullTime)
					local tgt = p.real.CFrame
					local pos = bezier(p.p0, p.ctrl, tgt.Position, Ease.inCubic(a))
					local ra = Ease.inOutCubic(a)
					local rot = p.rot0:Lerp(tgt - tgt.Position, ra)
					p.disp = CFrame.new(pos) * CFrame.fromAxisAngle(Vector3.yAxis, (1 - ra) * p.spin) * rot
					p.cf = p.disp
					if a >= 1 then
						p.disp = tgt
						p.cf = tgt
						p.state = "home"
						onSnap(p)
					end
				elseif st == "home" then
					p.disp = p.real.CFrame
				end
				p.fake.CFrame = p.disp
			end
			if meshFake and headPiece then
				meshFake.CFrame = headPiece.fake.CFrame * meshOffset
			end
			if armPiece then
				for _, follower in ipairs(gunFollowers) do
					follower.part.CFrame = armPiece.fake.CFrame * follower.offset
				end
			end

			updateChest(chest, torsoP.disp, beat)
			for ap, ab in pairs(armBones) do updateChest(ab, ap.disp, 0) end
			updateChest(torsoNeck, torsoP.disp, 0)

			-- stumps (cut faces, mist, droplet spray)
			if burstDone then
				local spray = math.exp(-(rawClock - CFG.T_Burst) * 1.35)
				for _, s in ipairs(stumps) do
					if s.shown then
						updateStump(s)
						s.em.Rate = (spray > 0.04) and (70 * spray) or 0
						s.acc = s.acc + sdt * 20 * spray
						while s.acc >= 1 do
							s.acc = s.acc - 1
							local base = s.piece.disp * s.localCF
							local n = base.UpVector
							spawnDrop(base.Position + n * 0.2,
								n * rr(10, 26) + Vector3.new(rr(-6, 6), rr(0, 8), rr(-6, 6)))
						end
						-- thick drips keep running long after the spray has died down
						s.drip = (s.drip or 0) + sdt * 5
						while s.drip >= 1 do
							s.drip = s.drip - 1
							local base = s.piece.disp * s.localCF
							spawnDrop(base.Position + base.UpVector * 0.1,
								base.UpVector * rr(0.5, 3) + Vector3.new(rr(-1.2, 1.2), 0, rr(-1.2, 1.2)))
						end
					end
				end
				-- blood pools under the torso while it lies there, and the open chest keeps bleeding
				poolT = poolT - sdt
				if poolT <= 0 and (torsoP.state == "phys" or torsoP.state == "rest") then
					poolT = 0.22
					puddle(Vector3.new(torsoP.cf.Position.X, S.groundY, torsoP.cf.Position.Z), 1.0)
				end
				if chest.shown then
					chestAcc = chestAcc + sdt * 7
					while chestAcc >= 1 do
						chestAcc = chestAcc - 1
						local cp = (torsoP.disp * CFrame.new(rr(-0.5, 0.5), rr(-0.4, 0.5), -0.65)).Position
						spawnDrop(cp, torsoP.disp.LookVector * rr(0.5, 3) + Vector3.new(rr(-1, 1), rr(0, 2), rr(-1, 1)))
					end
				end
			end

			for _, v in ipairs(veins) do updateVein(v, sdt, clock, heat, beat) end

			-- body glow
			local hlAmt = burstDone and (0.1 + 0.28 * heat + 0.3 * beat * (0.4 + heat)) or (0.6 * pre * (0.6 + 0.4 * beat))
			hl.FillTransparency = 1 - clamp01(hlAmt) * 0.6
			light.Brightness = redAmt * (0.3 + beat * 2.2) * 2

			-- everyone home?
			local allHome = true
			for _, p in ipairs(limbs) do
				if p.state ~= "home" then allHome = false end
			end
			if allHome then finale() end
		end

		-- screen + camera ---------------------------------------
		S.trauma = math.max(0, S.trauma - dt * 1.5)
		S.flash = math.max(0, S.flash - dt * 3.0)
		S.fov = S.fov * math.exp(-dt * 6)
		if not finished and not burstDone then
			S.zoom = -9 * pre
		else
			S.zoom = S.zoom * math.exp(-dt * 7)
		end

		local redTarget = 0
		if not finished then
			redTarget = burstDone and (0.28 + 0.5 * heat) or (0.75 * pre)
		end
		redAmt = lerp(redAmt, redTarget, 1 - math.exp(-dt * 8))
		local pr = redAmt * (0.8 + 0.35 * beat)
		cc.Brightness = S.flash * 0.3
		cc.Contrast = 0.1 * pr + S.flash * 0.35
		cc.Saturation = -0.12 * pr
		cc.TintColor = Color3.new(1, 1 - 0.32 * pr, 1 - 0.38 * pr)
		blur.Size = S.flash * 15

		if c then
			local sh = S.trauma * S.trauma
			if sh > 1e-4 then
				local t = os.clock() * 30
				local nx, ny, nz = math.noise(t, 1.7, 0.5), math.noise(t, 8.3, 0.5), math.noise(t, 4.9, 0.5)
				c.CFrame = c.CFrame * CFrame.new(nx * sh * 2.4, ny * sh * 2.4, 0)
					* CFrame.Angles(ny * sh * 0.14, nx * sh * 0.14, nz * sh * 0.22)
			end
			c.FieldOfView = baseFov + S.zoom + S.fov
		end

		stepDrops(sdt)
		stepGibs(sdt, torsoP.real.Position, suckGibs)
		runFx(sdt)

		if finished and #fx == 0 and #drops == 0 and #gibs == 0 and S.flash < 0.02 and S.trauma < 0.02 and redAmt < 0.02 then
			fullCleanup()
		end
	end

	S.abort = abort

	if deathMode then
		local corpse = { deathCF = hrp.CFrame, holding = true, bound = false }
		S.corpse = corpse

		-- called when the next body spawns: hide it, park it on the corpse and aim the pieces at it
		function corpse.bind(newChar, rec, conn)
			if S.corpse ~= corpse then return false end
			local nHum = newChar:WaitForChild("Humanoid", 5)
			local nHrp = newChar:WaitForChild("HumanoidRootPart", 5)
			if not (nHum and nHrp) then return false end
			local reals = {}
			for _, p in ipairs(pieces) do
				local r = newChar:WaitForChild(p.name, 5)
				if not r then return false end
				reals[p] = r
			end
			if S.corpse ~= corpse then return false end
			for p, r in pairs(reals) do p.real = r end
			char, hum, hrp = newChar, nHum, nHrp
			hidden, hideConn = rec, conn
			saved.anch = hrp.Anchored
			hrp.Anchored = true
			hrp.CFrame = corpse.deathCF
			rp.FilterDescendantsInstances = { newChar, folder }
			corpse.bound = true
			return true
		end

		-- SpawnDelay after the respawn: the corpse starts regenerating
		function corpse.release()
			if S.corpse ~= corpse or not corpse.bound then return end
			freezeChar()
			corpse.holding = false
		end
	end

	clearRegenSounds()
	clearSlamSound()
	for _, cfg in ipairs(FINALE_SFX) do
		playTagged(OPEN_TAG, cfg)
	end

	RunService:BindToRenderStep(bindName, Enum.RenderPriority.Camera.Value + 1, function(dt)
		local ok, err = pcall(step, dt)
		if not ok then
			warn("[RickRegen] " .. tostring(err))
			abort()
		end
	end)
end

------------------------------------------------------------------ INPUT
if CFG.AutoPlay then
	-- you die	 -> the fake body explodes right there and the pieces lie around as a corpse
	-- you respawn -> the new body is hidden + parked on the corpse; SpawnDelay later the corpse regenerates into it
	local function bindDeath(char)
		local hum = char:WaitForChild("Humanoid", 10)
		if not hum then return end
		if _G.__RickRegenDiedConn then
			pcall(function() _G.__RickRegenDiedConn:Disconnect() end)
		end
		_G.__RickRegenDiedConn = hum.Died:Connect(function()
			local ok, err = pcall(play, true, char)
			if not ok then
				warn("[RickRegen] " .. tostring(err))
				S.running = false
				S.corpse = nil
			end
		end)
	end

	local function onSpawn(char)
		local spawnTime = os.clock()
		S.Fired = false

		-- a corpse is waiting: hide the new body this very frame so it blends into the splatter
		local session = S.corpse
		local rec, hideConn
		if session then
			rec = {}
			hideConn = hideModel(char, rec)
		end

		-- the hide above stays instant (otherwise you'd see your new body); everything else waits for the morph
		task.delay(MORPH_DELAY, function()
			if char.Parent then bindDeath(char) end
		end)
		char:WaitForChild("Humanoid", 10)
		char:WaitForChild("HumanoidRootPart", 10)
		local morphLeft = MORPH_DELAY - (os.clock() - spawnTime)
		if morphLeft > 0 then task.wait(morphLeft) end

		local bound = false
		if session then
			if S.corpse == session and lp.Character == char then
				local okBind, res = pcall(session.bind, char, rec, hideConn)
				bound = okBind and res == true
			end
			if not bound then
				-- couldn't hook the corpse up to this body: drop it and fall back to a normal respawn
				unhide(rec, hideConn)
				if S.corpse == session and S.abort then pcall(S.abort) end
			end
		end

		local loaded = false
		local conn = lp.CharacterAppearanceLoaded:Connect(function() loaded = true end)
		local t0 = os.clock()
		while not loaded and os.clock() - t0 < CFG.SpawnWait do task.wait() end
		conn:Disconnect()
		local remaining = CFG.SpawnDelay - (os.clock() - spawnTime)
		if remaining > 0 then task.wait(remaining) end

		if bound then
			if S.corpse == session and lp.Character == char then
				session.release()
			end
			return
		end

		-- no corpse (e.g. the script was started while dead): old behaviour, explode + regenerate after the delay
		while S.running and os.clock() - t0 < 8 do task.wait() end
		if lp.Character == char then
			-- if setup ever errors halfway, don't leave the sequence marked "running" (that would block every later respawn)
			local ok, err = pcall(play)
			if not ok then
				warn("[RickRegen] " .. tostring(err))
				S.running = false
			end
		end
	end

	if _G.__RickRegenSpawnConn then
		pcall(function() _G.__RickRegenSpawnConn:Disconnect() end)
	end
	_G.__RickRegenSpawnConn = lp.CharacterAdded:Connect(function(char)
		task.spawn(onSpawn, char)
	end)
	if lp.Character then
		task.spawn(bindDeath, lp.Character)
	end
end

return { Play = play, HasCorpse = function() return S.corpse ~= nil end }
end)()

