-- Holds the camera AND your character pointed at the target for `duration` seconds.
-- Shiftlock keeps spinning your character back to the camera, so AutoRotate is switched off while the
-- hold lasts and your root is turned toward the target every frame; the camera ends up pointing at them
-- too, so shiftlock keeps you facing them afterwards. AutoRotate goes back to what it was.
function lockCameraOn(targetRoot, duration, camera, token)
    if not targetRoot then return end
    dodgeCameraLock.token = dodgeCameraLock.token + 1
    token = dodgeCameraLock.token

    local myChar = LocalPlayer.Character
    local myHum = myChar and myChar:FindFirstChildOfClass("Humanoid")
    local myRoot = myChar and myChar:FindFirstChild("HumanoidRootPart")
    if myHum then
        if dodgeCameraLock.autoRotate == nil then
            dodgeCameraLock.autoRotate = myHum.AutoRotate
        end
        myHum.AutoRotate = false
    end

    pcall(function()
        RunService:UnbindFromRenderStep("RickDodgeCameraLock")
    end)
    RunService:BindToRenderStep("RickDodgeCameraLock", Enum.RenderPriority.Camera.Value + 1, function()
        camera = workspace.CurrentCamera
        if camera and targetRoot.Parent then
            camera.CFrame = CFrame.lookAt(camera.CFrame.Position, targetRoot.Position)
            if myRoot and myRoot.Parent then
                local p, t = myRoot.Position, targetRoot.Position
                local flat = Vector3.new(t.X, p.Y, t.Z)
                if (flat - p).Magnitude > 0.05 then
                    myRoot.CFrame = CFrame.lookAt(p, flat)
                end
            end
        end
    end)
    task.delay(duration, function()
        if dodgeCameraLock.token == token then
            pcall(function()
                RunService:UnbindFromRenderStep("RickDodgeCameraLock")
            end)
            if myHum and myHum.Parent and dodgeCameraLock.autoRotate ~= nil then
                myHum.AutoRotate = dodgeCameraLock.autoRotate
            end
            dodgeCameraLock.autoRotate = nil
        end
    end)
end

