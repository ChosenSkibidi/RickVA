    end
    return false
end

function isDodgeAnimation(animationId)
    if isConditionedDodgeAnimation(animationId) then
        return true
    end
    for _, id in ipairs(DODGE_ANIMATION_IDS) do
        if string.find(animationId, id, 1, true) then
            return true
        end
    end
    return false
end

function shouldDodge(attackerChar, maxRange, anyDirection)
    maxRange = maxRange or DODGE_RANGE
    myChar = LocalPlayer.Character
    myRoot = myChar and myChar:FindFirstChild("HumanoidRootPart")
    myHum = myChar and myChar:FindFirstChildOfClass("Humanoid")
    aRoot = attackerChar:FindFirstChild("HumanoidRootPart")
    aHum = attackerChar:FindFirstChildOfClass("Humanoid")
    if not myRoot or not myHum or myHum.Health <= 0 or not aRoot or not aHum or aHum.Health <= 0 then
        return false
    end

    offset = myRoot.Position - aRoot.Position
    dist = offset.Magnitude
    if dist > maxRange then
        return false
    end
    if dist <= DODGE_POINT_BLANK or anyDirection then
        return true
    end

    toMe = flatXZ(offset)
    look = flatXZ(aRoot.CFrame.LookVector)
    if toMe.Magnitude < 0.01 or look.Magnitude < 0.01 then
        return false
    end
    return look.Unit:Dot(toMe.Unit) >= dodgeRequiredFacing(dist)
end

