function flatXZ(v)
    return Vector3.new(v.X, 0, v.Z)
end

function dodgeRequiredFacing(dist)
    t = math.clamp((dist - DODGE_POINT_BLANK) / (DODGE_RANGE - DODGE_POINT_BLANK), 0, 1)
    smooth = t * t * (3 - 2 * t)
    return DODGE_FACING_NEAR + (DODGE_FACING_FAR - DODGE_FACING_NEAR) * smooth
end

function isConditionedDodgeAnimation(animationId)
    for _, id in ipairs(CONDITIONED_DODGE_ANIMATION_IDS) do
