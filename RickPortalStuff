function buildGunModel()
    local S = GUN_SCALE
    local model = Instance.new("Model")
    model.Name = "PortalGun"

    local WHITE     = Color3.fromRGB(232, 238, 233)
    local WHITE_LO  = Color3.fromRGB(158, 168, 163)
    local NECK      = Color3.fromRGB(205, 211, 207)
    local PANEL     = Color3.fromRGB(196, 204, 200)
    local DARK      = Color3.fromRGB(40, 44, 43)
    local DARK_GREY = Color3.fromRGB(78, 86, 83)
    local MINT      = Color3.fromRGB(196, 236, 232)
    local GLASS     = Color3.fromRGB(120, 255, 105)
    local FILL      = Color3.fromRGB(55, 190, 50)
    local NEON      = Color3.fromRGB(165, 255, 110)
    local DOT       = Color3.fromRGB(110, 255, 95)
    local RED       = Color3.fromRGB(224, 38, 38)
    local RED_DARK  = Color3.fromRGB(112, 16, 16)
    local YELLOW    = Color3.fromRGB(242, 200, 36)
    local PURPLE    = Color3.fromRGB(128, 72, 188)
    local SMOOTH    = Enum.Material.SmoothPlastic
    local NEONMAT   = Enum.Material.Neon

    local function finish(p)
        p.Anchored = false
        p.CanCollide = false
        p.CanTouch = false
        p.CanQuery = false
        p.CastShadow = false
        p.Massless = true
        p.TopSurface = Enum.SurfaceType.Smooth
        p.BottomSurface = Enum.SurfaceType.Smooth
        p.Parent = model
        return p
    end

    local function setCF(p, cf)
        p.CFrame = CFrame.new(cf.Position * S) * cf.Rotation
    end

    local function block(name, size, cf, color, material, transparency)
        local p = Instance.new("Part")
        p.Name = name
        p.Size = size * S
        p.Color = color
        p.Material = material or SMOOTH
        p.Transparency = transparency or 0
        setCF(p, cf)
        return finish(p)
    end

    local function wedge(name, size, cf, color, material)
        local p = Instance.new("WedgePart")
        p.Name = name
        p.Size = size * S
        p.Color = color
        p.Material = material or SMOOTH
        setCF(p, cf)
        return finish(p)
    end

    local function ball(name, diameter, pos, color, material, transparency)
        local p = Instance.new("Part")
        p.Shape = Enum.PartType.Ball
        p.Name = name
        p.Size = Vector3.new(diameter, diameter, diameter) * S
        p.Color = color
        p.Material = material or SMOOTH
        p.Transparency = transparency or 0
        setCF(p, CFrame.new(pos))
        return finish(p)
    end

    local function cyl(name, axis, diameter, length, pos, color, material, transparency)
        local p = Instance.new("Part")
        p.Shape = Enum.PartType.Cylinder
        p.Name = name
        p.Size = Vector3.new(length, diameter, diameter) * S
        p.Color = color
        p.Material = material or SMOOTH
        p.Transparency = transparency or 0
        local rot = CFrame.new()
        if axis == "Y" then
            rot = CFrame.Angles(0, 0, math.rad(90))
        elseif axis == "Z" then
            rot = CFrame.Angles(0, math.rad(90), 0)
        end
        setCF(p, CFrame.new(pos) * rot)
        return finish(p)
    end

    local function segment(name, a, b, thick, color)
        local d = (b - a).Magnitude
        if d < 0.001 then return nil end
        return block(name, Vector3.new(thick, thick, d), CFrame.lookAt((a + b) / 2, b), color, NEONMAT)
    end

