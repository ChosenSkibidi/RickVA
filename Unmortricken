		proxy:Destroy()
	end)
end

local RIPPLE_DISTANCES = { 2, 4.6, 7.8, 11.8 }

local function fireBeam(gunModel, onFinished, lockedTargetRoot, context)
	local palette = context.palette or VFX.palette
	local widthMul = context.widthScale or 1
	local travelTime = context.travelTime or BEAM_TRAVEL_TIME
	local holdTime = context.holdTime or BEAM_HOLD
	local fadeTime = context.fadeTime or BEAM_FADE_TIME
	local aimOffset = context.aimOffset or Vector3.zero
	local rippleList = context.lite and {} or RIPPLE_DISTANCES
	local muzzlePlug = gunModel.Parent and gunModel:FindFirstChild("MuzzlePlug")
	if not muzzlePlug then
		onFinished()
		return
	end

	local function getMuzzleOrigin()
		return muzzlePlug.CFrame:PointToWorldSpace(Vector3.new(muzzlePlug.Size.X / 2, 0, 0))
	end

	local targetRoot = (lockedTargetRoot and lockedTargetRoot.Parent and lockedTargetRoot) or getClosestTargetRoot(getMuzzleOrigin())
	local ball = Enum.PartType.Ball

	local folder = Instance.new("Folder")
	folder.Name = "RickPrimeBeam"
	folder.Parent = workspace
	local stage = context.stage or folder

	local startOrigin = getMuzzleOrigin()
	local fallbackTarget = startOrigin + muzzlePlug.CFrame.RightVector * BEAM_FALLBACK_RANGE
	local function getTargetPosition()
		if targetRoot and targetRoot.Parent then
			return targetRoot.Position + aimOffset
		end
		return fallbackTarget + aimOffset
	end
	local firstOffset = getTargetPosition() - startOrigin
	local fireDirection = firstOffset.Magnitude > 0.1 and firstOffset.Unit or muzzlePlug.CFrame.RightVector

	local blastOk, blastError = pcall(function()
		if context.minimal then return end
		FX.sound(VFX.sounds.fire, folder)
		if context.lite then
			FX.liteMuzzle(stage, startOrigin, fireDirection, palette)
			return
		end
		FX.muzzleBurst(stage, startOrigin, fireDirection, context.palette)
		local feetHit = context.feetPosition and FX.floorAt(context.feetPosition, context.ignore)
		if feetHit then
			local floorFrame = FX.facing(feetHit.Position + feetHit.Normal * 0.12, feetHit.Normal)
			FX.shockRing(stage, floorFrame, { startRadius = 0.8, endRadius = 13, duration = 0.4, thickness = 0.4, color = palette.red, segments = 40, startTransparency = 0.05 })
			FX.shockRing(stage, floorFrame, { startRadius = 0.6, endRadius = 8, duration = 0.28, thickness = 0.25, color = palette.hot, segments = 36, startTransparency = 0.1 })
		end
	end)
	if not blastOk then
		warn("[RickPrimeGun] muzzle blast error:", blastError)
	end

	local originPart, originAttachment = FX.node(folder)
	local headPart, headAttachment = FX.node(folder)
	local tailPart, tailAttachment = FX.node(folder)

	local auraBeam = FX.beam(folder, originAttachment, headAttachment, ColorSequence.new(palette.deep), 1.5, 0.5, NumberSequence.new(0.78), 0)
	local glowBeam = FX.beam(folder, originAttachment, headAttachment, ColorSequence.new(palette.bright, palette.red), 0.62, 0.24, NumberSequence.new(0.1), 0.02)
	local coreBeam = FX.beam(folder, originAttachment, headAttachment, ColorSequence.new(palette.hot), 0.24, 0.1, NumberSequence.new(0), 0.04)
	local cometBeam = FX.beam(
		folder,
		tailAttachment,
		headAttachment,
		ColorSequence.new({
			ColorSequenceKeypoint.new(0, palette.red),
			ColorSequenceKeypoint.new(0.6, palette.hot),
			ColorSequenceKeypoint.new(1, Color3.new(1, 1, 1)),
		}),
		0.05,
		1.1 * widthMul,
		NumberSequence.new({
			NumberSequenceKeypoint.new(0, 1),
			NumberSequenceKeypoint.new(0.35, 0.3),
			NumberSequenceKeypoint.new(1, 0),
		}),
		0.06
	)
	local headBall = FX.part(folder, ball, Color3.new(1, 1, 1), 0, Vector3.one * 0.55, CFrame.new(startOrigin))
	local muzzleBall = FX.part(folder, ball, palette.bright, 0.1, Vector3.one * 0.9, CFrame.new(startOrigin))
	local targetBall = FX.part(folder, ball, palette.red, 1, Vector3.one * 0.5, CFrame.new(startOrigin))
	if context.minimal then
		headBall:Destroy()
		muzzleBall:Destroy()
		targetBall:Destroy()
	end

	local startedAt = os.clock()
	local arrivedAt
	local rippleSpawned = {}
	local connection

	local function cleanup()
		connection:Disconnect()
		folder:Destroy()
	end

	connection = RunService.PreRender:Connect(function()
		if not muzzlePlug.Parent then
			cleanup()
			onFinished()
			return
		end

		local elapsed = os.clock() - startedAt
		local muzzleCFrame = muzzlePlug.CFrame
		local origin = muzzleCFrame:PointToWorldSpace(Vector3.new(muzzlePlug.Size.X / 2, 0, 0))
		local targetPosition = getTargetPosition()
		local offset = targetPosition - origin
		local totalDistance = math.max(offset.Magnitude, 0.1)
		local direction = offset.Magnitude > 0.1 and offset.Unit or muzzleCFrame.RightVector

		local speed = totalDistance / travelTime
		local travelled = speed * elapsed
		local headDistance = math.min(travelled, totalDistance)
		local cometLength = math.min(VFX.cometLength, totalDistance * 0.7)
		local tailDistance = math.clamp(travelled - cometLength, 0, totalDistance)

		if not arrivedAt and headDistance >= totalDistance then
			arrivedAt = elapsed
			local impactOk, impactError = pcall(function()
				if context.minimal then return end
				FX.sound(VFX.sounds.impact, folder)
				if context.lite then
					FX.liteImpact(stage, targetPosition, direction, palette)
					return
				end
				FX.impact(stage, targetPosition, direction, targetRoot and targetRoot.Parent, context.ignore, context.palette)
			end)
			if not impactOk then
				warn("[RickPrimeGun] impact error:", impactError)
			end
			if context.onImpact then
				pcall(context.onImpact)
			end
		end

		local collapse = arrivedAt and math.clamp((elapsed - arrivedAt) / (holdTime + fadeTime), 0, 1) or 0
		if collapse >= 1 then
			cleanup()
			onFinished()
			return
		end

		local punch = 1 + 1.4 * math.exp(-elapsed * 22)
		local flutter = arrivedAt and (1 + 0.12 * math.sin(elapsed * 85) + 0.08 * math.sin(elapsed * 133)) or 1
		local scale = (1 - collapse) ^ 1.6 * flutter * punch
		auraBeam.Width0 = 1.5 * scale * widthMul
		auraBeam.Width1 = 0.5 * scale * widthMul
		auraBeam.Transparency = NumberSequence.new(0.78 + 0.22 * collapse ^ 2)
		glowBeam.Width0 = 0.62 * scale * widthMul
		glowBeam.Width1 = 0.24 * scale * widthMul
		glowBeam.Transparency = NumberSequence.new(0.1 + 0.9 * collapse ^ 2)
		coreBeam.Width0 = 0.24 * scale * widthMul
		coreBeam.Width1 = 0.1 * scale * widthMul
		coreBeam.Transparency = NumberSequence.new(collapse ^ 3)

		local headPosition = origin + direction * headDistance
		originPart.Position = origin
		headPart.Position = headPosition
		tailPart.Position = origin + direction * tailDistance
		cometBeam.Enabled = tailDistance < totalDistance - 0.05

		local headFade = arrivedAt and math.clamp((elapsed - arrivedAt) / 0.06, 0, 1) or 0
		headBall.CFrame = CFrame.new(headPosition)
		headBall.Size = Vector3.one * 0.55 * widthMul * (1 - headFade * 0.5)
		headBall.Transparency = headFade
		muzzleBall.CFrame = CFrame.new(origin)
		muzzleBall.Size = Vector3.one * (0.05 + 0.9 * widthMul * (1 - collapse) ^ 2 * flutter)
		muzzleBall.Transparency = 0.1 + 0.9 * collapse
		if arrivedAt then
			targetBall.CFrame = CFrame.new(targetPosition)
			targetBall.Size = Vector3.one * (0.05 + 1.8 * widthMul * (1 - collapse) ^ 2 * flutter)
			targetBall.Transparency = 0.15 + 0.85 * collapse
		end

		for index, distance in ipairs(rippleList) do
			if not rippleSpawned[index] and elapsed >= (index - 1) * 0.028 and distance < totalDistance * 0.85 then
				rippleSpawned[index] = true
				FX.shockRing(folder, FX.facing(origin + direction * distance, direction), {
					startRadius = 0.35,
					endRadius = 1.4 + index * 0.18,
					duration = 0.24,
					thickness = 0.2,
					color = index % 2 == 0 and palette.hot or palette.bright,
					segments = 18,
					startTransparency = 0.15,
				})
			end
		end
	end)
end

local droneFire

local function runSequence(character, onFinished)
	local humanoid = character:WaitForChild("Humanoid")
	if humanoid.RigType ~= Enum.HumanoidRigType.R6 then
		onFinished()
		return
	end

	local leftArm = character:WaitForChild("Left Arm")
	local rightArm = character:WaitForChild("Right Arm")

	for _, leftoverName in ipairs({ GUN_MODEL_NAME, WELD_NAME, LEGACY_WIELD_NAME }) do
		local leftoverInstance = rightArm:FindFirstChild(leftoverName)
		if leftoverInstance then
			leftoverInstance:Destroy()
		end
	end
	local torso = character:WaitForChild("Torso")
	local rightShoulder = torso:WaitForChild("Right Shoulder")

	local baseShoulderC0 = rightShoulder:GetAttribute(BASE_SHOULDER_ATTRIBUTE)
	if baseShoulderC0 then
		rightShoulder.C0 = baseShoulderC0
		rightShoulder:SetAttribute(BASE_SHOULDER_ATTRIBUTE, nil)
	end

	local rootPart = character:WaitForChild("HumanoidRootPart")
	local targetRoot = getClosestTargetRoot(rootPart.Position)

	character.Archivable = true
	local clone = character:Clone()
	clone.Name = "RickPrimeClone"
	for _, descendant in ipairs(clone:GetDescendants()) do
		if descendant:IsA("LuaSourceContainer") then
			descendant:Destroy()
		end
	end
	local cloneHumanoid = clone:FindFirstChildOfClass("Humanoid")
	cloneHumanoid.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.None
	clone.HumanoidRootPart.Anchored = true
	clone.Parent = workspace
	clone:PivotTo(rootPart.CFrame)

	pcall(FX.releaseAttack2Camera)
	local camera = workspace.CurrentCamera
	local savedCameraType = camera.CameraType
	camera.CameraType = Enum.CameraType.Scriptable
	local baseCameraCFrame = camera.CFrame
	local savedFov = camera.FieldOfView
	local fovZoomStart = os.clock()
	local shakeBindName = "RickPrimeShake" .. tostring(os.clock())
	local cameraRig = FX.camera(shakeBindName, camera, baseCameraCFrame, savedFov, fovZoomStart, BEAM_DELAY)
	local screenFx = FX.screen(camera)

	local stage = Instance.new("Folder")
	stage.Name = "RickPrimeStage"
	stage.Parent = workspace
	task.delay(SEQUENCE_TIMEOUT + 5, function()
		if stage.Parent then
			stage:Destroy()
		end
	end)

	local savedDisplayDistance = humanoid.DisplayDistanceType
	humanoid.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.None
	local savedDecalTransparency = {}
	local cloneRoot = clone.HumanoidRootPart
	local cloneBasePosition = cloneRoot.Position
	local bodyKick = 0

	local function faceCloneAtTarget()
		if targetRoot and targetRoot.Parent and clone.Parent then
			local clonePosition = cloneBasePosition
			local targetPosition = targetRoot.Position
			local flatTarget = Vector3.new(targetPosition.X, clonePosition.Y, targetPosition.Z)
			if (flatTarget - clonePosition).Magnitude > 0.01 then
				clone:PivotTo(CFrame.lookAt(clonePosition, flatTarget) * CFrame.new(0, 0, bodyKick))
			end
		end
	end

	local function updateSequence()
		if not DEBUG_SHOW_REAL_CHARACTER then
			for _, descendant in ipairs(character:GetDescendants()) do
				if descendant:IsA("BasePart") then
					descendant.LocalTransparencyModifier = 1
				elseif descendant:IsA("Decal") then
					if savedDecalTransparency[descendant] == nil then
						savedDecalTransparency[descendant] = descendant.Transparency
					end
					descendant.Transparency = 1
				end
			end
		end

		faceCloneAtTarget()
	end
	updateSequence()
	local sequenceConnection = RunService.Heartbeat:Connect(updateSequence)

	local cloneFaceConnection = RunService.PreRender:Connect(faceCloneAtTarget)

	local lockConnections = {}
	local savedAutoRotate = humanoid.AutoRotate
	local lockDirection
	local sequenceFinished = false

	local function stopLock()
		for _, lockConnection in ipairs(lockConnections) do
			lockConnection:Disconnect()
		end
		table.clear(lockConnections)
	end

	local function pickLockDirection()
		local targetPosition = targetRoot.Position
		local myPosition = rootPart.Position
		local approach = Vector3.new(targetPosition.X - myPosition.X, 0, targetPosition.Z - myPosition.Z)
		if approach.Magnitude > 0.01 then
			lockDirection = approach.Unit
		else

			local look = targetRoot.CFrame.LookVector
			local flatLook = Vector3.new(look.X, 0, look.Z)
			lockDirection = flatLook.Magnitude > 0.01 and -flatLook.Unit or Vector3.new(0, 0, 1)
		end
	end

	local function lockBehindTarget()
		if sequenceFinished then
			return
		end
		if not (rootPart.Parent and targetRoot and targetRoot.Parent) then
			stopLock()
			return
		end
		if not lockDirection then
			return
		end

		local targetPosition = targetRoot.Position

		local anchorPosition = targetPosition
		if LOCK_PREDICT_LATENCY then
			local leadTime = math.clamp(localPlayer:GetNetworkPing(), 0, LOCK_MAX_PREDICT_TIME)
			local lead = targetRoot.AssemblyLinearVelocity * leadTime
			if lead.Magnitude > LOCK_MAX_LEAD then
				lead = lead.Unit * LOCK_MAX_LEAD
			end
			anchorPosition = targetPosition + lead
		end

		local behindPosition = anchorPosition + lockDirection * BEHIND_DISTANCE

		local facePoint = Vector3.new(targetPosition.X, behindPosition.Y, targetPosition.Z)
		if (facePoint - behindPosition).Magnitude < 0.01 then
			facePoint = behindPosition - lockDirection
		end

		rootPart.CFrame = CFrame.lookAt(behindPosition, facePoint)
		rootPart.AssemblyLinearVelocity = Vector3.zero
		rootPart.AssemblyAngularVelocity = Vector3.zero
	end

	if targetRoot then
		task.delay(TELEPORT_DELAY, function()
			if sequenceFinished or not clone.Parent then
				return
			end
			humanoid.AutoRotate = false
			pickLockDirection()
			lockBehindTarget()
			table.insert(lockConnections, RunService.PreSimulation:Connect(lockBehindTarget))
			table.insert(lockConnections, RunService.Heartbeat:Connect(lockBehindTarget))
			table.insert(lockConnections, RunService.PreRender:Connect(lockBehindTarget))
		end)
	end

	local gunModel
	local cloneGunTrack
	local shotLoop
	local shotStart
	local chargeStart
	local returnedToPlayer = false
	local function returnToPlayer()
		if returnedToPlayer then
			return
		end
		returnedToPlayer = true
		sequenceConnection:Disconnect()
		cloneFaceConnection:Disconnect()
		stopLock()
		humanoid.AutoRotate = savedAutoRotate

		local gunTimePosition = cloneGunTrack and cloneGunTrack.TimePosition or ANIMATION_PAUSE_TIME
		if rootPart.Parent and humanoid.Health > 0 then
			rootPart.CFrame = CFrame.new(cloneBasePosition) * clone:GetPivot().Rotation
			rootPart.AssemblyLinearVelocity = Vector3.zero
			rootPart.AssemblyAngularVelocity = Vector3.zero
		end

		local cloneArm = clone:FindFirstChild("Left Arm")
		local cloneArmWeld = cloneArm and cloneArm:FindFirstChild(WELD_NAME)
		if gunModel and cloneArmWeld and leftArm.Parent and humanoid.Health > 0 then
			cloneArmWeld.Part0 = leftArm
			cloneArmWeld.Parent = leftArm
			gunModel.Parent = leftArm
		end

		for _, descendant in ipairs(character:GetDescendants()) do
			if descendant:IsA("BasePart") then
				descendant.LocalTransparencyModifier = 0
			end
		end
		for decal, originalTransparency in pairs(savedDecalTransparency) do
			decal.Transparency = originalTransparency
		end
		humanoid.DisplayDistanceType = savedDisplayDistance

		clone:Destroy()
		if humanoid.Health > 0 then
			resumeGunAnimation(humanoid, gunTimePosition)
		end
	end

	local function finishSequence()
		if sequenceFinished then
			return
		end
		sequenceFinished = true
		sequenceConnection:Disconnect()
		cloneFaceConnection:Disconnect()
		RunService:UnbindFromRenderStep(shakeBindName)
		screenFx.destroy()
		if shotLoop then
			shotLoop:Disconnect()
			shotLoop = nil
		end
		task.delay(1.2, function()
			stage:Destroy()
		end)
		camera.FieldOfView = savedFov
		stopLock()
		humanoid.AutoRotate = savedAutoRotate

		returnToPlayer()
		camera.CameraType = savedCameraType
		local playerGunWeld = leftArm:FindFirstChild(WELD_NAME)
		if playerGunWeld then
			playerGunWeld.C0 = GUN_REST_C0
		end
		onFinished()
	end

	local gunArm = clone:FindFirstChild("Left Arm")
	for _, leftoverName in ipairs({ GUN_MODEL_NAME, WELD_NAME, LEGACY_WIELD_NAME }) do
		local leftoverInstance = gunArm:FindFirstChild(leftoverName)
		if leftoverInstance then
			leftoverInstance:Destroy()
		end
	end
	local permanentGun = leftArm:FindFirstChild(GUN_MODEL_NAME)
	local permanentGunWeld = leftArm:FindFirstChild(WELD_NAME)
	if permanentGun and permanentGunWeld then
		permanentGunWeld.Part0 = gunArm
		permanentGunWeld.Parent = gunArm
		permanentGun.Parent = gunArm
		for _, gunDescendant in ipairs(permanentGun:GetDescendants()) do
			if gunDescendant:IsA("BasePart") then
				gunDescendant.LocalTransparencyModifier = 0
			end
		end
		gunModel = permanentGun
	else
		gunModel = attachGun(gunArm)
	end
	local gunWeld = gunArm:FindFirstChild(WELD_NAME)
	local gunBaseC0 = gunWeld and gunWeld.C0

	local shotContext = {
		stage = stage,
		ignore = FX.ignoreList(clone, character, targetRoot and targetRoot.Parent),
		feetPosition = cloneBasePosition,
		onImpact = function()
			cameraRig.impact()
			screenFx.impact()
		end,
	}

	local chargeEffect = createChargeEffect(gunModel:FindFirstChild("MuzzlePlug"), targetRoot, BEAM_DELAY, shotContext)
	chargeStart = os.clock()
	cloneGunTrack = playGunAnimation(cloneHumanoid)

	shotLoop = RunService.PreRender:Connect(function()
		local now = os.clock()
		local offset = CFrame.identity
		if shotStart then
			local age = now - shotStart
			local rise = 1 - math.exp(-age * 90)
			offset = CFrame.new(0, 0, VFX.gunKickBack * math.exp(-age * 11) * rise)
				* CFrame.Angles(VFX.gunKickPitch * math.exp(-age * 6.5) * rise, 0, 0)
			bodyKick = VFX.bodyKick * math.exp(-age * 8) * rise
		else
			local progress = math.clamp((now - chargeStart) / BEAM_DELAY, 0, 1)
			screenFx.setCharge(progress)
			local tremor = progress ^ 2 * VFX.gunTremor
			local pull = math.clamp((progress - 0.6) / 0.4, 0, 1) * VFX.gunPull
			offset = CFrame.new(
				math.noise(now * 47, 1.3, 0.5) * 2 * tremor,
				math.noise(now * 47, 2.7, 0.5) * 2 * tremor,
				pull + math.noise(now * 47, 4.1, 0.5) * 2 * tremor
			) * CFrame.Angles(math.noise(now * 47, 5.9, 0.5) * 4 * tremor, 0, 0)
		end
		if gunWeld and gunWeld.Parent then
			gunWeld.C0 = gunBaseC0 * offset
		end
	end)

	task.delay(BEAM_DELAY, function()
		if sequenceFinished then
			return
		end
		chargeEffect:Destroy()
		shotStart = os.clock()
		cameraRig.fire()
		pcall(screenFx.fire)
		fireBeam(gunModel, finishSequence, targetRoot, shotContext)
		if droneFire then
			pcall(droneFire, targetRoot, shotContext)
		end
	end)
	task.delay(CLONE_LIFETIME, returnToPlayer)

	task.delay(BEAM_DELAY + 2, finishSequence)
end

