local function dodgeBehindTarget(character, targetRoot)
	local myHumanoid = character and character:FindFirstChildOfClass("Humanoid")
	local myRoot = character and character:FindFirstChild("HumanoidRootPart")
	if not (myHumanoid and myHumanoid.Health > 0 and myRoot and myRoot.Parent and targetRoot and targetRoot.Parent) then
		return false
	end

	local look = targetRoot.CFrame.LookVector
	local flatLook = Vector3.new(look.X, 0, look.Z)
	flatLook = flatLook.Magnitude > 0.01 and flatLook.Unit or Vector3.new(0, 0, -1)

	local targetPosition = targetRoot.Position
	local behindPosition = targetPosition - flatLook * DODGE_BEHIND_DISTANCE

	playDodgeFx("depart", character, myRoot, behindPosition)

	myRoot.CFrame = CFrame.lookAt(behindPosition, Vector3.new(targetPosition.X, behindPosition.Y, targetPosition.Z))
	myRoot.AssemblyLinearVelocity = Vector3.zero
	myRoot.AssemblyAngularVelocity = Vector3.zero

	playDodgeFx("arrive", character, myRoot, behindPosition, targetRoot)
	return true
end

local function followBehindTarget(character, targetRoot)
	local humanoid = character:FindFirstChildOfClass("Humanoid")
	local rootPart = character:FindFirstChild("HumanoidRootPart")
	if not (humanoid and rootPart and targetRoot) then
		return function() end
	end

	local lockConnections = {}
	local savedAutoRotate = humanoid.AutoRotate
	local lockDirection
	local sequenceFinished = false

	local function stopLock()
		for _, lockConnection in ipairs(lockConnections) do
			lockConnection:Disconnect()
		end
		table.clear(lockConnections)
	end

	local function pickLockDirection()
		local targetPosition = targetRoot.Position
		local myPosition = rootPart.Position
		local approach = Vector3.new(targetPosition.X - myPosition.X, 0, targetPosition.Z - myPosition.Z)
		if approach.Magnitude > 0.01 then
			lockDirection = approach.Unit
		else

			local look = targetRoot.CFrame.LookVector
			local flatLook = Vector3.new(look.X, 0, look.Z)
			lockDirection = flatLook.Magnitude > 0.01 and -flatLook.Unit or Vector3.new(0, 0, 1)
		end
	end

	local function getLockSpot()
		local targetPosition = targetRoot.Position

		local anchorPosition = targetPosition
		if LOCK_PREDICT_LATENCY then
			local leadTime = math.clamp(localPlayer:GetNetworkPing(), 0, LOCK_MAX_PREDICT_TIME)
			local lead = targetRoot.AssemblyLinearVelocity * leadTime
			if lead.Magnitude > LOCK_MAX_LEAD then
				lead = lead.Unit * LOCK_MAX_LEAD
			end
			anchorPosition = targetPosition + lead
		end

		local behindPosition = anchorPosition + lockDirection * ATTACK3_FOLLOW_BEHIND_DISTANCE

		local facePoint = Vector3.new(targetPosition.X, behindPosition.Y, targetPosition.Z)
		if (facePoint - behindPosition).Magnitude < 0.01 then
			facePoint = behindPosition - lockDirection
		end

		return behindPosition, facePoint
	end

	local function lockBehindTarget()
		if sequenceFinished then
			return
		end
		if not (rootPart.Parent and targetRoot and targetRoot.Parent) then
			stopLock()
			return
		end
		if not lockDirection then
			return
		end

		local behindPosition, facePoint = getLockSpot()

		rootPart.CFrame = CFrame.lookAt(behindPosition, facePoint)
		rootPart.AssemblyLinearVelocity = Vector3.zero
		rootPart.AssemblyAngularVelocity = Vector3.zero
	end

	humanoid.AutoRotate = false
	pickLockDirection()

	local landingSpot = getLockSpot()

	playDodgeFx("depart", character, rootPart, landingSpot)

	lockBehindTarget()
	table.insert(lockConnections, RunService.PreSimulation:Connect(lockBehindTarget))
	table.insert(lockConnections, RunService.Heartbeat:Connect(lockBehindTarget))
	table.insert(lockConnections, RunService.PreRender:Connect(lockBehindTarget))

	playDodgeFx("arrive", character, rootPart, landingSpot, targetRoot)

	return function()
		sequenceFinished = true
		stopLock()
		humanoid.AutoRotate = savedAutoRotate
	end
end

