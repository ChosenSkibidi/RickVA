local function chargeDroneM1(side, targetRoot, shotStage, duration)
	local shooter = findDroneRig(side)
	if not shooter or not targetRoot or not targetRoot.Parent then
		return
	end

	local palette = VFX.palette
	local fullTurn = math.pi * 2
	local streakCycleTime = 0.14
	local ringCycleTime = 0.16
	local lastTargetPosition = targetRoot.Position

	local function getMuzzleFrame()
		local pivot = shooter.model:GetPivot()
		local muzzlePosition = (pivot * CFrame.new(0, 0, -0.09)).Position
		if targetRoot.Parent then
			lastTargetPosition = targetRoot.Position
		end
		local offset = lastTargetPosition - muzzlePosition
		if offset.Magnitude < 0.1 then
			return pivot.Rotation + muzzlePosition
		end
		return CFrame.lookAt(muzzlePosition, muzzlePosition + offset.Unit)
	end

	local startFrame = getMuzzleFrame()
	local chargeCore = FX.part(shotStage, Enum.PartType.Ball, palette.hot, 0, Vector3.one * 0.05, startFrame)
	local chargeHalo = FX.part(shotStage, Enum.PartType.Ball, palette.red, 0.5, Vector3.one * 0.1, startFrame)
	local chargeAura = FX.part(shotStage, Enum.PartType.Ball, palette.deep, 0.86, Vector3.one * 0.2, startFrame)

	local chargeLight = Instance.new("PointLight")
	chargeLight.Color = palette.bright
	chargeLight.Range = 6
	chargeLight.Brightness = 1
	chargeLight.Shadows = false
	chargeLight.Parent = chargeCore

	local streaks = {}
	for _ = 1, 14 do
		local streakColor = FX.rng:NextInteger(1, 2) == 1 and palette.bright or palette.hot
		table.insert(streaks, {
			part = FX.part(shotStage, Enum.PartType.Block, streakColor, 1, Vector3.new(0.05, 0.05, 0.4), startFrame),
			angle = FX.rng:NextNumber(0, fullTurn),
			polar = FX.rng:NextNumber(0.2, 1.4),
			radius = FX.rng:NextNumber(1.6, 3.2),
			swirl = FX.rng:NextNumber(5, 9) * (FX.rng:NextInteger(0, 1) == 0 and -1 or 1),
			phase = FX.rng:NextNumber(0, 1),
		})
	end

	local rings = { FX.newRing(shotStage, 20, palette.red), FX.newRing(shotStage, 20, palette.bright) }

	FX.run(shotStage, duration, function(progress, elapsed)
		local coreFrame = getMuzzleFrame() * CFrame.new(0, 0, -0.2)
		local flicker = 1 + (0.5 + progress) * (0.06 * math.sin(elapsed * 57) + 0.04 * math.sin(elapsed * 93))
		local coreSize = (0.05 + 0.7 * progress ^ 2) * flicker
		chargeCore.Size = Vector3.one * coreSize
		chargeCore.CFrame = coreFrame
		chargeHalo.Size = Vector3.one * coreSize * 2.2
		chargeHalo.CFrame = coreFrame
		chargeAura.Size = Vector3.one * coreSize * 3.4
		chargeAura.CFrame = coreFrame
		chargeLight.Brightness = 1 + 5 * progress
		chargeLight.Range = 6 + 4 * progress

		for _, streak in ipairs(streaks) do
			local cycleAlpha = (elapsed / streakCycleTime + streak.phase) % 1
			local radius = streak.radius * (1 - cycleAlpha) ^ 1.5
			local angle = streak.angle + streak.swirl * elapsed
			local localOffset = Vector3.new(math.sin(streak.polar) * math.cos(angle), math.sin(streak.polar) * math.sin(angle), -math.cos(streak.polar)) * radius
			local streakPosition = coreFrame:PointToWorldSpace(localOffset)
			local streakLength = 0.12 + 0.5 * (1 - cycleAlpha)
			streak.part.Size = Vector3.new(0.05, 0.05, streakLength)
			streak.part.CFrame = CFrame.lookAt(streakPosition, coreFrame.Position)
			streak.part.Transparency = 1 - 0.9 * math.sin(math.pi * cycleAlpha) ^ 0.6
		end

		for ringIndex, ring in ipairs(rings) do
			local ringAlpha = (elapsed / ringCycleTime + (ringIndex - 1) * 0.5) % 1
			local ringRadius = 0.15 + 2.2 * (1 - ringAlpha) ^ 1.6
			local ringTransparency = 1 - 0.85 * math.sin(math.pi * ringAlpha) ^ 0.5
			FX.setRing(ring, coreFrame, ringRadius, 0.03 + 0.02 * progress, ringTransparency, 0)
		end
	end, function()
		chargeCore:Destroy()
		chargeHalo:Destroy()
		chargeAura:Destroy()
		for _, streak in ipairs(streaks) do
			streak.part:Destroy()
		end
		for _, ring in ipairs(rings) do
			FX.destroyRing(ring)
		end
	end)
end

local function fireDroneM1(side, targetRoot, shotStage)
	if not targetRoot or not targetRoot.Parent then
		return
	end

	local palette = VFX.palette
	local shooter = findDroneRig(side)
	if not shooter then
		return
	end

	local function getMuzzlePosition()
		return (shooter.model:GetPivot() * CFrame.new(0, 0, -0.09)).Position
	end

	local startPosition = getMuzzlePosition()
	local lastTargetPosition = targetRoot.Position
	local initialOffset = lastTargetPosition - startPosition
	local initialDirection = initialOffset.Magnitude > 0.1 and initialOffset.Unit or shooter.model:GetPivot().LookVector
	local totalTime = DRONE_BEAM_TRAVEL_TIME + DRONE_BEAM_HOLD_TIME + DRONE_BEAM_COLLAPSE_TIME

	FX.comboFlash(shotStage, startPosition, lastTargetPosition, palette.bright, 3, 0.4)

	local muzzleFlare = FX.part(shotStage, Enum.PartType.Ball, palette.hot, 0.05, Vector3.one * 0.35, CFrame.new(startPosition))
	FX.tween(muzzleFlare, 0.12, { Size = Vector3.one * 1.5, Transparency = 1 })
	local muzzleSparkPart = FX.node(shotStage)
	muzzleSparkPart.CFrame = CFrame.lookAt(startPosition, startPosition + initialDirection)
	FX.burst(muzzleSparkPart, 6, {
		speed = NumberRange.new(22, 48),
		spread = Vector2.new(24, 24),
		lifetime = NumberRange.new(0.08, 0.18),
		size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.28), NumberSequenceKeypoint.new(1, 0) }),
		acceleration = Vector3.zero,
		drag = 3,
	})

	local headPart, headAttachment = FX.node(shotStage)
	local tailPart, tailAttachment = FX.node(shotStage)
	local auraBeam = FX.beam(shotStage, tailAttachment, headAttachment, ColorSequence.new(palette.red), 1.3, 1.3, NumberSequence.new(0.8), 0)
	local glowBeam = FX.beam(shotStage, tailAttachment, headAttachment, ColorSequence.new(palette.bright), 0.55, 0.55, NumberSequence.new(0.2), 0.02)
	local coreBeam = FX.beam(shotStage, tailAttachment, headAttachment, ColorSequence.new(palette.hot), 0.2, 0.2, NumberSequence.new(0), 0.04)
	local headBall = FX.part(shotStage, Enum.PartType.Ball, palette.hot, 0, Vector3.one * 0.6, CFrame.new(startPosition))

	local function spawnImpact(impactPosition, impactDirection)
		local impactFlash = FX.part(shotStage, Enum.PartType.Ball, palette.hot, 0.05, Vector3.one * 0.8, CFrame.new(impactPosition))
		FX.tween(impactFlash, 0.16, { Size = Vector3.one * 2.6, Transparency = 1 })
		local impactSparkPart = FX.node(shotStage)
		impactSparkPart.CFrame = CFrame.lookAt(impactPosition, impactPosition - impactDirection)
		FX.burst(impactSparkPart, 10, {
			speed = NumberRange.new(16, 36),
			spread = Vector2.new(60, 60),
			lifetime = NumberRange.new(0.12, 0.28),
			size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.32), NumberSequenceKeypoint.new(1, 0) }),
			acceleration = Vector3.new(0, -30, 0),
			drag = 2.5,
		})
		FX.shockRing(shotStage, FX.facing(impactPosition - impactDirection * 0.4, impactDirection), {
			startRadius = 0.3,
			endRadius = 3,
			duration = 0.2,
			thickness = 0.14,
			color = palette.bright,
			segments = 20,
			startTransparency = 0.1,
		})
	end

	local hasImpacted = false
	FX.run(shotStage, totalTime, function(_, elapsed)
		local muzzlePosition = getMuzzlePosition()
		if targetRoot.Parent then
			lastTargetPosition = targetRoot.Position
		end
		local offset = lastTargetPosition - muzzlePosition
		local distance = math.max(offset.Magnitude, 0.1)
		local direction = offset.Magnitude > 0.1 and offset.Unit or initialDirection

		local travelAlpha = math.clamp(elapsed / DRONE_BEAM_TRAVEL_TIME, 0, 1)
		local collapseAlpha = math.clamp((elapsed - DRONE_BEAM_TRAVEL_TIME - DRONE_BEAM_HOLD_TIME) / DRONE_BEAM_COLLAPSE_TIME, 0, 1)
		local headDistance = distance * (1 - (1 - travelAlpha) ^ 2)
		local tailDistance = distance * collapseAlpha ^ 2.2
		headPart.Position = muzzlePosition + direction * headDistance
		tailPart.Position = muzzlePosition + direction * tailDistance

		if not hasImpacted and travelAlpha >= 1 then
			hasImpacted = true
			spawnImpact(lastTargetPosition, direction)
		end

		local widthScale = (1 - collapseAlpha) ^ 1.4 * (1 + 0.9 * math.exp(-elapsed * 45)) * (1 + 0.07 * math.sin(elapsed * 220))
		auraBeam.Width0 = 1.3 * widthScale
		auraBeam.Width1 = 1.3 * widthScale
		glowBeam.Width0 = 0.55 * widthScale
		glowBeam.Width1 = 0.55 * widthScale
		coreBeam.Width0 = 0.2 * widthScale
		coreBeam.Width1 = 0.2 * widthScale
		auraBeam.Transparency = NumberSequence.new(0.8 + 0.2 * collapseAlpha)
		glowBeam.Transparency = NumberSequence.new(0.2 + 0.8 * collapseAlpha ^ 2)
		coreBeam.Transparency = NumberSequence.new(collapseAlpha ^ 3)

		headBall.CFrame = CFrame.new(headPart.Position)
		headBall.Size = Vector3.one * math.max(0.6 * (1 - collapseAlpha), 0.05)
		headBall.Transparency = collapseAlpha
	end, function()
		headBall:Destroy()
		headPart:Destroy()
		tailPart:Destroy()
		auraBeam:Destroy()
		glowBeam:Destroy()
		coreBeam:Destroy()
	end)
end

local ATTACK2_CHARGE_TIME = 0.2
local ATTACK2_FIRE_START = 0.2
local ATTACK2_FIRE_END = 1.7
local ATTACK2_SHOT_INTERVAL = 0.1
local ATTACK2_STAGE_LIFETIME = 2.5
local attack2Running = false

local ATTACK2_SHAKE_START = 0.2
local ATTACK2_SHAKE_END = 1.7
local ATTACK2_SHAKE_FADE_IN = 0.04
local ATTACK2_SHAKE_FADE_OUT = 0.25
local ATTACK2_SHAKE_NOISE_SPEED = 80
local ATTACK2_SHAKE_POSITION = 0.3
local ATTACK2_SHAKE_ROTATION = math.rad(1.4)
local ATTACK2_SHAKE_PUNCH_BACK = 0.4
local ATTACK2_SHAKE_PUNCH_PITCH = math.rad(1.2)
local ATTACK2_SHAKE_PUNCH_ROLL = math.rad(2)
local ATTACK2_SHAKE_PUNCH_DECAY = 35

function FX.attack2Shake()
	local noiseSeed = FX.rng:NextNumber(1, 90)
	local startedAt = os.clock()
	local bindName = "RickPrimeAttack2Shake" .. tostring(startedAt)
	local duration = ATTACK2_SHAKE_END - ATTACK2_SHAKE_START

	RunService:BindToRenderStep(bindName, Enum.RenderPriority.Last.Value + 1, function()
		local camera = workspace.CurrentCamera
		local age = os.clock() - startedAt - ATTACK2_SHAKE_START
		if not camera or age >= duration then
			RunService:UnbindFromRenderStep(bindName)
			return
		end
		if age < 0 then return end

		local intensity = math.clamp(age / ATTACK2_SHAKE_FADE_IN, 0, 1)
			* math.clamp((duration - age) / ATTACK2_SHAKE_FADE_OUT, 0, 1)
		local punch = math.exp(-(age % ATTACK2_SHOT_INTERVAL) * ATTACK2_SHAKE_PUNCH_DECAY) * intensity
		local rollSign = math.floor(age / ATTACK2_SHOT_INTERVAL) % 2 == 0 and 1 or -1
		local function noise(offset)
			return math.noise(age * ATTACK2_SHAKE_NOISE_SPEED, noiseSeed, offset) * 2 * intensity
		end

		camera.CFrame = camera.CFrame
			* CFrame.new(
				noise(0.13) * ATTACK2_SHAKE_POSITION,
				noise(0.37) * ATTACK2_SHAKE_POSITION,
				ATTACK2_SHAKE_PUNCH_BACK * punch
			)
			* CFrame.Angles(
				noise(0.61) * ATTACK2_SHAKE_ROTATION + ATTACK2_SHAKE_PUNCH_PITCH * punch,
				noise(0.83) * ATTACK2_SHAKE_ROTATION,
				noise(0.97) * ATTACK2_SHAKE_ROTATION + rollSign * ATTACK2_SHAKE_PUNCH_ROLL * punch
			)
	end)

	return function()
		pcall(function()
			RunService:UnbindFromRenderStep(bindName)
		end)
	end
end

local ATTACK2_FOLLOW_START = 0.2
local ATTACK2_FOLLOW_END = 1.7
local ATTACK2_GUN_KICK_SCALE = 0.5
local ATTACK2_CLONE_LINGER = 0.6
local ATTACK2_GUN_FIRE_START = ATTACK2_FIRE_START
local ATTACK2_GUN_FIRE_END = ATTACK2_FIRE_END - 0.25
local ATTACK2_GUN_SHOT_INTERVAL = 0.05
local ATTACK2_GUN_SPREAD = 2.4
local ATTACK2_GUN_BEAM = { widthScale = 0.55, travelTime = 0.05, holdTime = 0.06, fadeTime = 0.1 }

local function startAttack2Clone(character, rootPart, getTargetRoot, stage)
	local humanoid = character:FindFirstChildOfClass("Humanoid")
	if not humanoid then
		return function() end
	end

	character.Archivable = true
	local clone = character:Clone()
	if not clone then
		return function() end
	end
	clone.Name = "RickPrimeClone"
	for _, descendant in ipairs(clone:GetDescendants()) do
		if descendant:IsA("LuaSourceContainer") then
			descendant:Destroy()
		end
	end
	local cloneHumanoid = clone:FindFirstChildOfClass("Humanoid")
	local cloneRoot = clone:FindFirstChild("HumanoidRootPart")
	if not cloneHumanoid or not cloneRoot then
		clone:Destroy()
		return function() end
	end
	cloneHumanoid.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.None
	cloneRoot.Anchored = true
	local cloneArm = clone:FindFirstChild("Left Arm")
	if cloneArm then
		for _, leftoverName in ipairs({ GUN_MODEL_NAME, WELD_NAME, LEGACY_WIELD_NAME }) do
			local leftoverInstance = cloneArm:FindFirstChild(leftoverName)
			if leftoverInstance then
				leftoverInstance:Destroy()
			end
		end
	end
	clone.Parent = workspace
	clone:PivotTo(rootPart.CFrame)
	local cloneBasePosition = cloneRoot.Position

	local gunModel = cloneArm and attachGun(cloneArm)
	local gunWeld = cloneArm and cloneArm:FindFirstChild(WELD_NAME)
	local gunBaseC0 = gunWeld and gunWeld.C0
	local cloneGunTrack
	if cloneHumanoid:FindFirstChildOfClass("Animator") then
		cloneGunTrack = playGunAnimation(cloneHumanoid)
	end
	local lastShotTime
	local gunKickConnection = RunService.PreRender:Connect(function()
		if not (gunWeld and gunWeld.Parent and lastShotTime) then return end
		local age = os.clock() - lastShotTime
		local rise = 1 - math.exp(-age * 90)
		gunWeld.C0 = gunBaseC0
			* CFrame.new(0, 0, VFX.gunKickBack * ATTACK2_GUN_KICK_SCALE * math.exp(-age * 11) * rise)
			* CFrame.Angles(VFX.gunKickPitch * ATTACK2_GUN_KICK_SCALE * math.exp(-age * 6.5) * rise, 0, 0)
	end)
	local function markGunShot()
		lastShotTime = os.clock()
	end

	local savedDisplayDistance = humanoid.DisplayDistanceType
	humanoid.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.None
	local finished = false

	local function faceCloneAtTarget()
		local targetRoot = getTargetRoot()
		if targetRoot and targetRoot.Parent and clone.Parent then
			local targetPosition = targetRoot.Position
			local flatTarget = Vector3.new(targetPosition.X, cloneBasePosition.Y, targetPosition.Z)
			if (flatTarget - cloneBasePosition).Magnitude > 0.01 then
				clone:PivotTo(CFrame.lookAt(cloneBasePosition, flatTarget))
			end
		end
	end

	local function updateClone()
		faceCloneAtTarget()
	end
	updateClone()
	local restoreHide = FX.hideCharacter(character)
	local cloneUpdateConnection = RunService.Heartbeat:Connect(updateClone)
	local cloneFaceConnection = RunService.PreRender:Connect(faceCloneAtTarget)

	-- camera on the clone, same rig as attack 1
	local camera = workspace.CurrentCamera
	local savedCameraType, savedFov, savedCameraCFrame, cameraRig
	local cameraBindName = "RickPrimeAttack2Cam" .. tostring(os.clock())
	local cameraOk, cameraError = pcall(function()
		savedCameraType = camera.CameraType
		savedFov = camera.FieldOfView
		savedCameraCFrame = camera.CFrame
		camera.CameraType = Enum.CameraType.Scriptable
		local baseCameraCFrame = camera.CFrame
		local focus = cloneBasePosition + Vector3.new(0, 1.5, 0)
		local toFocus = focus - baseCameraCFrame.Position
		local aimRoot = getTargetRoot()
		local awayFromTarget = aimRoot and Vector3.new(cloneBasePosition.X - aimRoot.Position.X, 0, cloneBasePosition.Z - aimRoot.Position.Z) or Vector3.zero
		awayFromTarget = awayFromTarget.Magnitude > 0.05 and awayFromTarget.Unit or -rootPart.CFrame.LookVector
		if toFocus.Magnitude < 5 then
			baseCameraCFrame = CFrame.lookAt(focus + awayFromTarget * 9 + Vector3.new(0, 1.5, 0), focus)
		elseif baseCameraCFrame.LookVector:Dot(toFocus.Unit) < 0.8 then
			baseCameraCFrame = CFrame.lookAt(baseCameraCFrame.Position, focus)
		end
		cameraRig = FX.camera(cameraBindName, camera, baseCameraCFrame, savedFov, os.clock(), ATTACK2_CHARGE_TIME)
	end)
	if not cameraOk then
		warn("[Attack2] camera error:", cameraError)
		cameraRig = nil
		if camera and savedCameraType then
			camera.CameraType = savedCameraType
		end
	end

	-- gives the camera back right away (used when another attack starts mid attack 2)
	local cameraReleased = false
	local function releaseCamera(restoreFrame)
		if cameraReleased then return end
		cameraReleased = true
		if not cameraOk then return end
		pcall(function()
			RunService:UnbindFromRenderStep(cameraBindName)
		end)
		camera.FieldOfView = savedFov
		camera.CameraType = savedCameraType
		if restoreFrame and savedCameraCFrame then
			camera.CFrame = savedCameraCFrame
		end
	end

	-- gun mag dump: first round is the full attack 1 beam, the rest are lighter scattered rounds
	local gunIgnoreList = FX.ignoreList(stage, clone, character)
	local function shootGun(shotTargetRoot, isOpener)
		if finished or not (gunModel and gunModel.Parent and shotTargetRoot and shotTargetRoot.Parent) then
			return
		end
		markGunShot()
		local context
		if isOpener then
			context = {
				stage = stage,
				ignore = FX.ignoreList(stage, clone, character, shotTargetRoot.Parent),
				feetPosition = cloneBasePosition,
				onImpact = function()
					if cameraRig then
						cameraRig.impact()
					end
				end,
			}
			if cameraRig then
				cameraRig.fire()
			end
		else
			local spread = ATTACK2_GUN_SPREAD
			context = {
				stage = stage,
				ignore = gunIgnoreList,
				lite = true,
				aimOffset = Vector3.new(FX.rng:NextNumber(-spread, spread), FX.rng:NextNumber(-spread, spread), FX.rng:NextNumber(-spread, spread)),
				widthScale = ATTACK2_GUN_BEAM.widthScale,
				travelTime = ATTACK2_GUN_BEAM.travelTime,
				holdTime = ATTACK2_GUN_BEAM.holdTime,
				fadeTime = ATTACK2_GUN_BEAM.fadeTime,
			}
		end
		pcall(fireBeam, gunModel, function() end, shotTargetRoot, context)
	end

	local lockConnections = {}
	local savedAutoRotate = humanoid.AutoRotate
	local lockDirection

	local function stopLock()
		for _, lockConnection in ipairs(lockConnections) do
			lockConnection:Disconnect()
		end
		table.clear(lockConnections)
	end

	local function pickLockDirection(targetRoot)
		local targetPosition = targetRoot.Position
		local myPosition = rootPart.Position
		local approach = Vector3.new(targetPosition.X - myPosition.X, 0, targetPosition.Z - myPosition.Z)
		if approach.Magnitude > 0.01 then
			lockDirection = approach.Unit
		else
			local look = targetRoot.CFrame.LookVector
			local flatLook = Vector3.new(look.X, 0, look.Z)
			lockDirection = flatLook.Magnitude > 0.01 and -flatLook.Unit or Vector3.new(0, 0, 1)
		end
	end

	local function lockBehindTarget()
		if finished then return end
		if not rootPart.Parent then
			stopLock()
			return
		end
		local targetRoot = getTargetRoot()
		if not (targetRoot and targetRoot.Parent and lockDirection) then return end

		local targetPosition = targetRoot.Position
		local anchorPosition = targetPosition
		if LOCK_PREDICT_LATENCY then
			local leadTime = math.clamp(localPlayer:GetNetworkPing(), 0, LOCK_MAX_PREDICT_TIME)
			local lead = targetRoot.AssemblyLinearVelocity * leadTime
			if lead.Magnitude > LOCK_MAX_LEAD then
				lead = lead.Unit * LOCK_MAX_LEAD
			end
			anchorPosition = targetPosition + lead
		end

		local behindPosition = anchorPosition + lockDirection * BEHIND_DISTANCE
		local facePoint = Vector3.new(targetPosition.X, behindPosition.Y, targetPosition.Z)
		if (facePoint - behindPosition).Magnitude < 0.01 then
			facePoint = behindPosition - lockDirection
		end

		rootPart.CFrame = CFrame.lookAt(behindPosition, facePoint)
		rootPart.AssemblyLinearVelocity = Vector3.zero
		rootPart.AssemblyAngularVelocity = Vector3.zero
	end

	task.delay(ATTACK2_FOLLOW_START, function()
		if finished or not clone.Parent then return end
		local targetRoot = getTargetRoot()
		if not (targetRoot and targetRoot.Parent) then return end
		humanoid.AutoRotate = false
		pickLockDirection(targetRoot)
		lockBehindTarget()
		table.insert(lockConnections, RunService.PreSimulation:Connect(lockBehindTarget))
		table.insert(lockConnections, RunService.Heartbeat:Connect(lockBehindTarget))
		table.insert(lockConnections, RunService.PreRender:Connect(lockBehindTarget))
	end)

	local function cleanup()
		if finished then return end
		finished = true
		cloneUpdateConnection:Disconnect()
		cloneFaceConnection:Disconnect()
		gunKickConnection:Disconnect()
		stopLock()
		humanoid.AutoRotate = savedAutoRotate

		local gunTimePosition = cloneGunTrack and cloneGunTrack.TimePosition or ANIMATION_PAUSE_TIME
		if rootPart.Parent and humanoid.Health > 0 then
			rootPart.CFrame = CFrame.new(cloneBasePosition) * clone:GetPivot().Rotation
			rootPart.AssemblyLinearVelocity = Vector3.zero
			rootPart.AssemblyAngularVelocity = Vector3.zero
		end

		restoreHide()
		releaseCamera()
		humanoid.DisplayDistanceType = savedDisplayDistance
		clone:Destroy()

		-- pick the clone's gun pose back up on the real character
		if humanoid.Health > 0 then
			local animator = humanoid:FindFirstChildOfClass("Animator")
			if animator then
				for _, playingTrack in ipairs(animator:GetPlayingAnimationTracks()) do
					if playingTrack.Animation and playingTrack.Animation.AnimationId == GUN_ANIMATION_ID then
						playingTrack:Stop(0)
					end
				end
			end
			resumeGunAnimation(humanoid, gunTimePosition)
		end
	end

	return cleanup, shootGun, releaseCamera
end

local function runAttack2(character, root)
	if attack2Running then return end
	local targetRoot = getClosestTargetRoot(root.Position)
	if not targetRoot then return end
	attack2Running = true

	local stage = Instance.new("Folder")
	stage.Name = "DroneAttack2Stage"
	stage.Parent = workspace
	Debris:AddItem(stage, ATTACK2_STAGE_LIFETIME)

	local cloneOk, returnToPlayer, shootGun, releaseCloneCamera = pcall(startAttack2Clone, character, root, function()
		return targetRoot
	end, stage)
	if not cloneOk then
		warn("[Attack2] clone error:", returnToPlayer)
		returnToPlayer = function() end
		shootGun = nil
		releaseCloneCamera = nil
	end
	local attack2Finished = false
	local function finishAttack2()
		if attack2Finished then return end
		attack2Finished = true
		returnToPlayer()
		FX.releaseAttack2Camera = function() end
		attack2Running = false
	end
	task.delay(ATTACK2_FOLLOW_END, finishAttack2)

	local shakeOk, cancelShake = pcall(FX.attack2Shake)
	FX.releaseAttack2Camera = function()
		if releaseCloneCamera then
			pcall(releaseCloneCamera, true)
		end
		if shakeOk and cancelShake then
			cancelShake()
		end
	end
	pcall(chargeDroneM1, -1, targetRoot, stage, ATTACK2_CHARGE_TIME)
	pcall(chargeDroneM1, 1, targetRoot, stage, ATTACK2_CHARGE_TIME)

	task.spawn(function()
		local startClock = os.clock()
		local shotTime = ATTACK2_FIRE_START
		while shotTime < ATTACK2_FIRE_END - 0.001 do
			local waitTime = startClock + shotTime - os.clock()
			if waitTime > 0 then
				task.wait(waitTime)
			end
			if not stage.Parent or not character.Parent then break end
			if not targetRoot.Parent then
				targetRoot = getClosestTargetRoot(root.Position)
				if not targetRoot then break end
			end
			pcall(fireDroneM1, -1, targetRoot, stage)
			pcall(fireDroneM1, 1, targetRoot, stage)
			shotTime += ATTACK2_SHOT_INTERVAL
		end
		if shotTime < ATTACK2_FIRE_END - 0.001 then
			finishAttack2()
		end
	end)

	if shootGun then
		task.spawn(function()
			local gunStartClock = os.clock()
			local shotTime = ATTACK2_GUN_FIRE_START
			local round = 0
			while shotTime < ATTACK2_GUN_FIRE_END - 0.001 do
				local waitTime = gunStartClock + shotTime - os.clock()
				if waitTime > 0 then
					task.wait(waitTime)
				end
				if attack2Finished or not stage.Parent or not character.Parent then break end
				if targetRoot and targetRoot.Parent then
					round += 1
					shootGun(targetRoot, round == 1)
				end
				shotTime += ATTACK2_GUN_SHOT_INTERVAL
			end
		end)
	end
end

local function spawnHitbox(root, character, onHit)
	local hitbox = Instance.new("Part")
	hitbox.Name = "Hitbox"
	hitbox.Size = Vector3.new(12, 12, 12)
	hitbox.Anchored = true
	hitbox.CanCollide = false
	hitbox.CanQuery = false
	hitbox.Transparency = 1
	hitbox.CFrame = root.CFrame * CFrame.new(0, 0, -0.3)
	hitbox.Parent = workspace

	local handled = false
	hitbox.Touched:Connect(function(touched)
		if handled then return end
		local model = touched:FindFirstAncestorOfClass("Model")
		if not model or model == character or model.Name == "RickPrimeClone" then return end
		if not model:FindFirstChild("Humanoid") then return end
		handled = true
		hitbox:Destroy()
		onHit(model)
	end)
	Debris:AddItem(hitbox, 0.15)
end

local function hookCharacter(character)
	local humanoid = character:WaitForChild("Humanoid")
	local root = character:WaitForChild("HumanoidRootPart")
	humanoid.AnimationPlayed:Connect(function(track)
		if ownTracks[track] then return end
		local id = track.Animation and track.Animation.AnimationId
		if id and string.find(id, TRIGGER_ANIM_IDS.ATTACK2, 1, true) then
			runAttack2(character, root)
			return
		end

		local replacement = COMBO_ANIMS[id]
		if not replacement then return end

		if replacement ~= id then
			track:Stop()
			local anim = Instance.new("Animation")
			anim.AnimationId = replacement
			local newTrack = humanoid:LoadAnimation(anim)
			ownTracks[newTrack] = true
			newTrack:Play()
		end

		spawnHitbox(root, character, function(hitModel)
			local targetRoot = hitModel:FindFirstChild("HumanoidRootPart")
			if not targetRoot then return end
			local stage = Instance.new("Folder")
			stage.Name = "DroneHitStage"
			stage.Parent = workspace
			Debris:AddItem(stage, 2)
			if not GUN_BEAM_COMBO_IDS[id] then
				pcall(chargeDroneM1, COMBO_SIDE[id], targetRoot, stage, DRONE_HIT_DELAY)
			end
			task.delay(DRONE_HIT_DELAY, function()
				if not targetRoot.Parent then return end
				if GUN_BEAM_COMBO_IDS[id] then
					local leftArm = character:FindFirstChild("Left Arm")
					local gunModel = leftArm and leftArm:FindFirstChild(GUN_MODEL_NAME)
					if gunModel then
						local comboShake = FX.comboShake(GUN_SHAKE_DURATION)
						local gunShotContext = {
							stage = stage,
							ignore = FX.ignoreList(stage, character, hitModel),
							feetPosition = root.Position,
							onImpact = comboShake.impact,
						}
						comboShake.fire()
						pcall(fireBeam, gunModel, function() end, targetRoot, gunShotContext)
					end
					return
				end
				FX.m1Shake(DRONE_SHAKE_DURATION, COMBO_SIDE[id])
				pcall(fireDroneM1, COMBO_SIDE[id], targetRoot, stage)
			end)
		end)
	end)
end

if player.Character then
	task.spawn(hookCharacter, player.Character)
end
player.CharacterAdded:Connect(hookCharacter)

RunService.RenderStepped:Connect(function(dt)
	local cloneChar = workspace:FindFirstChild("RickPrimeClone")
	local char = cloneChar or player.Character
	local hrp = char and char:FindFirstChild("HumanoidRootPart")
	if not hrp then return end

	local t = os.clock()
	local look = hrp.CFrame.LookVector
	local flat = Vector3.new(look.X, 0, look.Z)
	if flat.Magnitude < 0.01 then flat = Vector3.new(0, 0, -1) end
	local base = CFrame.lookAt(hrp.Position, hrp.Position + flat.Unit)
	local a = 1 - math.exp(-dt * CONFIG.Follow)

	for _, r in ipairs(rigs) do
		local target = base * CFrame.new(r.side * CONFIG.Side, CONFIG.Height, CONFIG.Back)
		r.cf = r.cf and r.cf:Lerp(target, a) or target
		local bob = math.sin(t * CONFIG.FloatSpeed + r.phase) * CONFIG.FloatAmp
		local sway = CFrame.Angles(
			math.sin(t * 0.7 + r.phase) * 0.04,
			math.sin(t * 0.9 + r.phase) * 0.08,
			math.sin(t * 1.1 + r.phase) * 0.05
		)
		r.model:PivotTo(r.cf * CFrame.new(0, bob, 0) * sway)
		if not r.model.Parent then r.model.Parent = workspace end
	end
end)
end)
