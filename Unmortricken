	FX.run(fxFolder, ATTACK3_TOTAL, function(alpha, elapsed)
		local animTime = track.IsPlaying and track.TimePosition or (ATTACK3_START_TIME + elapsed)
		local windup = math.clamp((animTime - ATTACK3_START_TIME) / ATTACK3_WINDUP, 0, 1)
		kick = pickKickLeg(legs, root, kick)
		local foot = legTip(kick)
		local flicker = rng:NextNumber()

		if not fired then

			local p = windup ^ 2.6
			local h = windup ^ 1.6
			orb.Size = Vector3.one * (0.15 + 1.1 * p)
			orb.CFrame = CFrame.new(foot)
			orb.Color = ELEC.blue:Lerp(ELEC.cyan, p)
			orb.Transparency = 0.45 - 0.3 * p
			orbShell.Size = Vector3.one * (0.4 + 2.2 * p) * (0.9 + 0.2 * flicker)
			orbShell.CFrame = CFrame.new(foot)
			orbShell.Transparency = 0.85 - 0.25 * p
			orbLight.Brightness = 0.4 + 2.6 * p
			legGlow.Adornee = kick.part
			legGlow.FillTransparency = math.clamp(0.93 - 0.35 * p - 0.05 * flicker, 0, 1)
			legGlow.OutlineTransparency = math.clamp(0.85 - 0.45 * p + 0.1 * flicker, 0, 1)
			aura.OutlineTransparency = math.clamp(0.9 - 0.4 * p, 0, 1)
			grade.TintColor = Color3.new(1, 1, 1):Lerp(Color3.fromRGB(205, 225, 255), p)
			grade.Contrast = 0.05 * p

			local legCFrame, legSize = kick.part.CFrame, kick.part.Size
			local thick = 0.05 + 0.06 * h
			local coilFade = math.clamp(0.92 - 0.6 * h - 0.08 * flicker, 0, 1)
			for strand = 1, 2 do
				local previous
				for index = 0, HELIX_POINTS do
					local along = index / HELIX_POINTS
					local angle = along * math.pi * 3 + elapsed * 16 * (strand == 1 and 1 or -1) + (strand - 1) * math.pi
					local point = legCFrame * Vector3.new(math.cos(angle) * 0.85, (along - 0.5) * legSize.Y, math.sin(angle) * 0.85)
					if previous and (point - previous).Magnitude > 0.02 then
						local piece = helixParts[strand][index]
						piece.Size = Vector3.new(thick, thick, (point - previous).Magnitude + thick)
						piece.CFrame = FX.facing((point + previous) / 2, point - previous)
						piece.Transparency = coilFade
					end
					previous = point
				end
			end

			streakDebt = streakDebt + 0.12 + 1.1 * windup ^ 1.5
			while streakDebt >= 1 do
				streakDebt = streakDebt - 1
				local streak = FX.part(fxFolder, block, rng:NextNumber() < 0.6 and ELEC.blue or ELEC.cyan, 0.4, Vector3.new(0.08, 0.08, 1), CFrame.new(foot))
				table.insert(streaks, {
					part = streak,
					rel = randomUnit() * rng:NextNumber(5, 8.5),
					swirl = rng:NextNumber(0.9, 1.8) * (rng:NextNumber() < 0.5 and -1 or 1),
					born = os.clock(),
					life = rng:NextNumber(0.18, 0.28),
				})
			end

			if elapsed >= nextArc then
				nextArc = elapsed + 0.09 - 0.05 * windup
				if rng:NextNumber() < 0.25 + 0.75 * windup then
					elecBolt(fxFolder, kick.part.Position + randomUnit() * 0.3, foot + randomUnit() * 0.3, 0.07, 0.1, 5, 0.35, nil, true)
				end
				if rng:NextNumber() < windup then
					elecBolt(fxFolder, foot, foot + randomUnit() * rng:NextNumber(1.5, 2.2 + 1.8 * windup), 0.06, 0.09, 4, 0.45, nil, true)
				end
				if rng:NextNumber() < 0.6 * windup then
					elecBolt(fxFolder, root.Position + randomUnit() * 0.8, root.Position + randomUnit() * 2.5, 0.05, 0.09, 4, 0.4, nil, true)
				end
				if rng:NextNumber() < 0.35 + 0.4 * windup then
