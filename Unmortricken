function DodgeVfx.depart(character, myRoot, destination)
	local folder = dodgeFolder(1.2)
	local origin = myRoot.Position

	for _, part in ipairs(character:GetChildren()) do
		if part:IsA("BasePart") and part.Name ~= "HumanoidRootPart" and part.Transparency < 1 then
			local ghost = FX.part(folder, Enum.PartType.Block, ELEC.cyan, 0.3, part.Size, part.CFrame)
			FX.tween(ghost, 0.45, { Transparency = 1, Size = part.Size * 1.25 })
		end
	end

	local delta = destination - origin
	if delta.Magnitude > 1 then
		local streakFrame = FX.facing(origin + delta / 2, delta)
		local streak = FX.part(folder, Enum.PartType.Block, ELEC.cyan, 0.15, Vector3.new(1.4, 1.4, delta.Magnitude), streakFrame)
		FX.tween(streak, 0.3, { Transparency = 1, Size = Vector3.new(0.1, 0.1, delta.Magnitude) })
		local core = FX.part(folder, Enum.PartType.Block, ELEC.white, 0, Vector3.new(0.5, 0.5, delta.Magnitude), streakFrame)
		FX.tween(core, 0.22, { Transparency = 1, Size = Vector3.new(0.05, 0.05, delta.Magnitude) })
		for _ = 1, 3 do
			elecBolt(folder, origin, destination, 0.3, 0.25, 8, 2.5, false, true)
		end
	end

	dodgeFlash(folder, origin, 7)
	dodgeFloorRings(folder, origin, character, 8)
	dodgeSparks(folder, origin, 14)
end

function DodgeVfx.arrive(character, myRoot, destination, targetRoot)
	local folder = dodgeFolder(1.2)
	local position = myRoot.Position

	dodgeFlash(folder, position, 9)
	dodgeFloorRings(folder, position, character, 10)
	dodgeSparks(folder, position, 18)

	for _ = 1, 4 do
		local direction = Vector3.new(FX.rng:NextNumber(-1, 1), FX.rng:NextNumber(-0.3, 1), FX.rng:NextNumber(-1, 1))
		if direction.Magnitude < 0.1 then
			direction = Vector3.yAxis
		end
		elecBolt(folder, position, position + direction.Unit * FX.rng:NextNumber(4, 8), 0.25, 0.22, 6, 1.2, false, false)
	end

	local highlight = Instance.new("Highlight")
	highlight.Adornee = character
	highlight.FillColor = ELEC.cyan
	highlight.OutlineColor = ELEC.white
	highlight.FillTransparency = 0.2
	highlight.OutlineTransparency = 0
	highlight.Parent = folder
	FX.tween(highlight, 0.4, { FillTransparency = 1, OutlineTransparency = 1 })
end

