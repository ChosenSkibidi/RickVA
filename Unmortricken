droneFire = function(targetRoot, ctx, palette)
	palette = palette or VFX.palette
	local shooters = rigs
	if ctx.side then
		shooters = {}
		for _, r in ipairs(rigs) do
			if r.side == ctx.side then
				table.insert(shooters, r)
			end
		end
	end
	for _, r in ipairs(shooters) do
		local gun = Instance.new("Model")
		gun.Name = "RickPrimeDroneGun"
		local function makePart(name, color, transparency)
			local part = Instance.new("Part")
			part.Name = name
			part.Color = color
			part.Transparency = transparency
			part.Material = Enum.Material.Neon
			part.Anchored = true
			part.CanCollide = false
			part.CanQuery = false
			part.CanTouch = false
			part.CastShadow = false
			part.Size = Vector3.one * 0.1
			part.Parent = gun
			return part
		end
		local muzzle = makePart("MuzzlePlug", Color3.new(1, 1, 1), 1)
		local body = makePart("BeamBody", palette.hot, 0)
		body.Shape = Enum.PartType.Cylinder
		local glow = makePart("BeamGlow", palette.bright, 0.55)
		glow.Shape = Enum.PartType.Cylinder
		gun.Parent = workspace

		local t0 = os.clock()
		local arrivedAt
		local conn
		local function update()
			if not gun.Parent then
				conn:Disconnect()
				return
			end
			local pivot = r.model:GetPivot()
			local pos = (pivot * CFrame.new(0, 0, -0.3)).Position
			local aim = pivot.LookVector
			if targetRoot and targetRoot.Parent then
				local toTarget = targetRoot.Position - pos
				if toTarget.Magnitude > 0.01 then aim = toTarget end
			end
			muzzle.CFrame = CFrame.lookAt(pos, pos + aim) * CFrame.Angles(0, math.rad(90), 0)

			local rot = muzzle.CFrame.Rotation
			local dir = muzzle.CFrame.RightVector
			local eye = (pivot * CFrame.new(0, 0, -0.09)).Position
			local total = math.max(((targetRoot and targetRoot.Parent and targetRoot.Position or pos + aim * BEAM_FALLBACK_RANGE) - eye).Magnitude, 0.1)
			local elapsed = os.clock() - t0
			local head = math.min(total / BEAM_TRAVEL_TIME * elapsed, total)
			if not arrivedAt and head >= total then
				arrivedAt = elapsed
			end
			local collapse = arrivedAt and math.clamp((elapsed - arrivedAt) / (BEAM_HOLD + BEAM_FADE_TIME), 0, 1) or 0
			local k = math.max((1 - collapse) ^ 1.6, 0.001)
			local len = math.max(head, 0.05)
			local center = CFrame.new(eye + dir * len / 2) * rot
			body.Size = Vector3.new(len, 0.38 * k, 0.67 * k)
			body.CFrame = center
			glow.Size = Vector3.new(len, 0.38 * k * 1.7, 0.67 * k * 1.7)
			glow.CFrame = center
		end
		update()
		conn = RunService.PreRender:Connect(update)
		fireBeam(gun, function()
			conn:Disconnect()
			gun:Destroy()
		end, targetRoot, { stage = ctx.stage, ignore = ctx.ignore, palette = palette, minimal = ctx.minimal })
	end
end

