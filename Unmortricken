function FX.comboShake(duration)
	local rollSign = FX.rng:NextNumber() < 0.5 and -1 or 1
	local bindName = "RickPrimeComboShake" .. tostring(os.clock())
	local kicks = {}
	local shake = {}

	local function addKick(strength, roll)
		table.insert(kicks, { time = os.clock(), strength = strength, roll = roll })
	end

	function shake.fire()
		addKick(1, rollSign)
	end

	function shake.impact()
		addKick(0.6, -rollSign)
	end

	local function jitter(amount)
		return (math.random() - 0.5) * 2 * amount
	end

	RunService:BindToRenderStep(bindName, Enum.RenderPriority.Camera.Value + 1, function()
		local camera = workspace.CurrentCamera
		if not camera then return end
		local now = os.clock()
		local kickBack, kickRoll, kickShake = 0, 0, 0
		for _, kick in ipairs(kicks) do
			local age = now - kick.time
			if age < duration then
				local fade = 1 - age / duration
				local decay = math.exp(-age * VFX.kickDecay) * fade
				kickBack += kick.strength * decay * math.cos(age * VFX.kickFreq)
				kickRoll += kick.strength * kick.roll * decay * math.cos(age * VFX.kickFreq * 0.55)
				kickShake += kick.strength * fade ^ SHAKE_FALLOFF
			end
		end
		if kickShake == 0 then return end
		local jitterPosition = SHAKE_POSITION * kickShake
		local jitterRotation = SHAKE_ROTATION * kickShake
		camera.CFrame = camera.CFrame
			* CFrame.new(jitter(jitterPosition), jitter(jitterPosition), kickBack * VFX.kickBack)
			* CFrame.Angles(jitter(jitterRotation), jitter(jitterRotation), kickRoll * VFX.kickRoll + jitter(jitterRotation))
	end)

	task.delay(duration + BEAM_TRAVEL_TIME + 0.5, function()
		pcall(function()
			RunService:UnbindFromRenderStep(bindName)
		end)
	end)

	return shake
end

function FX.m1Shake(duration, side)
	local noiseSeed = FX.rng:NextNumber(1, 90)
	local startedAt = os.clock()
	local bindName = "RickPrimeM1Shake" .. tostring(startedAt)

	RunService:BindToRenderStep(bindName, Enum.RenderPriority.Camera.Value + 1, function()
		local camera = workspace.CurrentCamera
		local age = os.clock() - startedAt
		if not camera or age >= duration then
			RunService:UnbindFromRenderStep(bindName)
			return
		end

		local falloff = (1 - age / duration) ^ 2
		local punch = math.exp(-age * 30)
		local function smoothNoise(offset)
			return math.noise(age * 48, noiseSeed, offset) * 2
		end

		camera.CFrame = camera.CFrame
			* CFrame.new(
				smoothNoise(0.13) * 0.14 * falloff,
				smoothNoise(0.37) * 0.14 * falloff,
				0.32 * punch
			)
			* CFrame.Angles(
				math.rad(1.3) * punch + smoothNoise(0.61) * math.rad(0.6) * falloff,
				smoothNoise(0.83) * math.rad(0.6) * falloff,
				side * math.rad(1.6) * punch + smoothNoise(0.97) * math.rad(0.5) * falloff
			)
	end)
end

