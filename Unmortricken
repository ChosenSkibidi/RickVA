	FX.tween(flash, 0.09, { Transparency = 1, Size = Vector3.one * 1.7 }).Completed:Once(function()
		flash:Destroy()
	end)
	local spike = FX.part(owner, Enum.PartType.Block, palette.bright, 0.1, Vector3.new(0.14, 0.14, 3), CFrame.lookAt(origin + direction * 1.5, origin + direction * 3))
	FX.tween(spike, 0.07, { Transparency = 1, Size = Vector3.new(0.03, 0.03, 6) }).Completed:Once(function()
		spike:Destroy()
	end)
	local proxy = FX.part(owner, Enum.PartType.Block, palette.hot, 1, Vector3.new(0.1, 0.1, 0.1), FX.facing(origin, direction))
