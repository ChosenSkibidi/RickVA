local function attachGun(targetArm)
	for _, leftoverName in ipairs({ GUN_MODEL_NAME, WELD_NAME, LEGACY_WIELD_NAME }) do
		local leftoverInstance = targetArm:FindFirstChild(leftoverName)
		if leftoverInstance then
			leftoverInstance:Destroy()
		end
	end

	local gunModel = gunTemplate:Clone()

	local armWeld = Instance.new("Weld")
	armWeld.Name = WELD_NAME
	armWeld.Part0 = targetArm
	armWeld.Part1 = gunModel.PrimaryPart
	armWeld.C0 = GUN_REST_C0
	armWeld.C1 = CFrame.new()
	armWeld.Parent = targetArm

	gunModel.Parent = targetArm

	return gunModel
end

local function equipPermanentGun(character)
	local humanoid = character:WaitForChild("Humanoid")
	if humanoid.RigType ~= Enum.HumanoidRigType.R6 or humanoid.Health <= 0 then
		return
	end

	local leftArm = character:WaitForChild("Left Arm")
	if leftArm:FindFirstChild(GUN_MODEL_NAME) and leftArm:FindFirstChild(WELD_NAME) then
		return
	end

	local equippedGun = attachGun(leftArm)

	local appearHighlight = Instance.new("Highlight")
	appearHighlight.Name = "RickPrimeGunAppear"
	appearHighlight.Adornee = equippedGun
	appearHighlight.FillColor = Color3.new(1, 1, 1)
	appearHighlight.OutlineColor = Color3.new(1, 1, 1)
	appearHighlight.FillTransparency = 0
	appearHighlight.OutlineTransparency = 0
	appearHighlight.DepthMode = Enum.HighlightDepthMode.Occluded
	appearHighlight.Parent = equippedGun

	TweenService:Create(
		appearHighlight,
		TweenInfo.new(GUN_APPEAR_FADE_TIME, Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
		{ FillTransparency = 1, OutlineTransparency = 1 }
	):Play()

	task.delay(GUN_APPEAR_FADE_TIME + 0.1, function()
		appearHighlight:Destroy()
	end)
end

local function playGunAnimation(humanoid)
	local animator = humanoid:WaitForChild("Animator")

	for _, playingTrack in ipairs(animator:GetPlayingAnimationTracks()) do
		if playingTrack.Animation and playingTrack.Animation.AnimationId == GUN_ANIMATION_ID then
			playingTrack:Stop(0)
		end
	end

	local gunAnimation = Instance.new("Animation")
	gunAnimation.AnimationId = GUN_ANIMATION_ID

	local gunAnimationTrack = animator:LoadAnimation(gunAnimation)
	gunAnimationTrack.Priority = GUN_ANIMATION_PRIORITY
	gunAnimationTrack:Play()

	local pauseConnection
	pauseConnection = RunService.Heartbeat:Connect(function()
		if not gunAnimationTrack.IsPlaying then
			pauseConnection:Disconnect()
		elseif gunAnimationTrack.TimePosition >= ANIMATION_PAUSE_TIME then
			pauseConnection:Disconnect()
			gunAnimationTrack.TimePosition = ANIMATION_PAUSE_TIME
			gunAnimationTrack:AdjustSpeed(0)
		end
	end)

	return gunAnimationTrack
end

local function resumeGunAnimation(humanoid, timePosition)
	local animator = humanoid:FindFirstChildOfClass("Animator")
	if not animator then
		return
	end

	local gunAnimation = Instance.new("Animation")
	gunAnimation.AnimationId = GUN_ANIMATION_ID

	local gunAnimationTrack = animator:LoadAnimation(gunAnimation)
	gunAnimationTrack.Priority = GUN_ANIMATION_PRIORITY
	gunAnimationTrack:Play(0)
	gunAnimationTrack.TimePosition = timePosition
end

