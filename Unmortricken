local function runAttack3(character, animator, onDone)
	pcall(FX.releaseAttack2Camera)
	local root = character:FindFirstChild("HumanoidRootPart")
	local camera = workspace.CurrentCamera
	local legs = {
		{ part = character:FindFirstChild("Right Leg") or character:FindFirstChild("RightFoot"), rest = Vector3.new(0.5, -3, 0) },
		{ part = character:FindFirstChild("Left Leg") or character:FindFirstChild("LeftFoot"), rest = Vector3.new(-0.5, -3, 0) },
