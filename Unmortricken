local function createGunPart(gunModel, handle, partName, partShape, partSize, partOffset, partColor, partMaterial)
	local gunPart = Instance.new("Part")
	gunPart.Name = partName
	gunPart.Shape = partShape
	gunPart.Size = partSize * GUN_SCALE
	gunPart.Color = partColor
	gunPart.Material = partMaterial
	gunPart.TopSurface = Enum.SurfaceType.Smooth
	gunPart.BottomSurface = Enum.SurfaceType.Smooth
	gunPart.Anchored = false
	gunPart.CanCollide = false
	gunPart.CanTouch = false
	gunPart.CanQuery = false
	gunPart.Massless = true

	local partWeld = Instance.new("Weld")
	partWeld.Name = partName .. "Weld"
	partWeld.Part0 = handle
	partWeld.Part1 = gunPart
	local shiftedOffset = GUN_ORIGIN_SHIFT * partOffset
	partWeld.C0 = CFrame.new(shiftedOffset.Position * GUN_SCALE) * shiftedOffset.Rotation
	partWeld.Parent = gunPart

	gunPart.Parent = gunModel
	return gunPart
end

local function buildGunTemplate()
	local gunModel = Instance.new("Model")
	gunModel.Name = GUN_MODEL_NAME

	local handle = Instance.new("Part")
	handle.Name = "Handle"
	handle.Size = Vector3.new(0.2, 0.2, 0.2)
	handle.Transparency = 1
	handle.Anchored = false
	handle.CanCollide = false
	handle.CanTouch = false
	handle.CanQuery = false
	handle.Massless = true
	handle.Parent = gunModel
	gunModel.PrimaryPart = handle

	local block = Enum.PartType.Block
	local cylinder = Enum.PartType.Cylinder
	local metal = Enum.Material.Metal
	local neon = Enum.Material.Neon
	local smoothPlastic = Enum.Material.SmoothPlastic

	local gripTopFrame = CFrame.new(0, 0.55, 0.17) * CFrame.Angles(GRIP_TILT_ANGLE, 0, 0)
	local lengthwiseAlignment = CFrame.Angles(0, math.rad(90), 0)
	local sideSigns = { -1, 1 }

	createGunPart(gunModel, handle, "Grip", block, Vector3.new(0.42, 1.05, 0.55), gripTopFrame * CFrame.new(0, -0.525, 0), COLOR_GRIP_NAVY, smoothPlastic)
	createGunPart(gunModel, handle, "GripBase", block, Vector3.new(0.5, 0.36, 0.8), gripTopFrame * CFrame.new(0, -1.21, 0.04), COLOR_BASE_BLOCK, smoothPlastic)
	createGunPart(gunModel, handle, "GripBasePlate", block, Vector3.new(0.42, 0.05, 0.62), gripTopFrame * CFrame.new(0, -1.385, 0.04), COLOR_BASE_PLATE, metal)

	for _, sideSign in ipairs(sideSigns) do
		local sideName = sideSign < 0 and "Left" or "Right"
		createGunPart(gunModel, handle, "GripPanelBorder" .. sideName, block, Vector3.new(0.02, 0.5, 0.34), gripTopFrame * CFrame.new(sideSign * 0.215, -0.36, 0), COLOR_PANEL_BORDER, smoothPlastic)
		createGunPart(gunModel, handle, "GripPanelScreen" .. sideName, block, Vector3.new(0.025, 0.4, 0.25), gripTopFrame * CFrame.new(sideSign * 0.218, -0.36, 0), COLOR_PANEL_SCREEN, smoothPlastic)
	end

	createGunPart(gunModel, handle, "Slide", block, Vector3.new(0.42, 0.5, 1.5), CFrame.new(0, 0.78, -0.55), COLOR_BODY_NAVY, smoothPlastic)
	createGunPart(gunModel, handle, "RearShell", block, Vector3.new(0.42, 0.46, 0.32), CFrame.new(0, 0.76, 0.36), COLOR_REAR_SHELL, smoothPlastic)

	for _, sideSign in ipairs(sideSigns) do
		local sideName = sideSign < 0 and "Left" or "Right"
		createGunPart(gunModel, handle, "SlideEdgeRail" .. sideName, cylinder, Vector3.new(1.82, 0.1, 0.1), CFrame.new(sideSign * 0.16, 1.0, -0.4) * lengthwiseAlignment, COLOR_BODY_EDGE, smoothPlastic)
		createGunPart(gunModel, handle, "RedPanel" .. sideName, block, Vector3.new(0.03, 0.26, 0.6), CFrame.new(sideSign * 0.215, 0.88, -0.1), COLOR_RED_PANEL, neon)
		createGunPart(gunModel, handle, "FramePocket" .. sideName, block, Vector3.new(0.02, 0.1, 0.8), CFrame.new(sideSign * 0.225, 0.43, -0.72), COLOR_FRAME_POCKET, smoothPlastic)
	end

	createGunPart(gunModel, handle, "RedPanelTop", block, Vector3.new(0.2, 0.03, 0.6), CFrame.new(0, 1.04, -0.1), COLOR_RED_PANEL, neon)
	createGunPart(gunModel, handle, "LowerFrame", block, Vector3.new(0.44, 0.2, 1.25), CFrame.new(0, 0.43, -0.72), COLOR_LOWER_FRAME, smoothPlastic)

	createGunPart(gunModel, handle, "MuzzleBlock", block, Vector3.new(0.5, 0.62, 0.5), CFrame.new(0, 0.78, -1.55), COLOR_MUZZLE_GRAY, smoothPlastic)
	createGunPart(gunModel, handle, "MuzzleTopBevel", block, Vector3.new(0.5, 0.05, 0.5), CFrame.new(0, 1.115, -1.55), COLOR_MUZZLE_BEVEL, smoothPlastic)
	createGunPart(gunModel, handle, "MuzzleFrontChamfer", block, Vector3.new(0.5, 0.05, 0.22), CFrame.new(0, 1.07, -1.76) * CFrame.Angles(math.rad(-40), 0, 0), COLOR_MUZZLE_BEVEL, smoothPlastic)
	createGunPart(gunModel, handle, "MuzzlePlug", cylinder, Vector3.new(0.12, 0.24, 0.24), CFrame.new(0, 0.85, -1.84) * lengthwiseAlignment, COLOR_MUZZLE_PLUG, metal)

	local triggerCenterY = 0.4
	local triggerCenterZ = -0.3
	local triggerRadius = 0.14
	local triggerSegmentCount = 8
	local triggerStartAngle = math.rad(200)
	local triggerEndAngle = math.rad(340)

	for segmentIndex = 0, triggerSegmentCount - 1 do
		local arcProgress = segmentIndex / (triggerSegmentCount - 1)
		local arcAngle = triggerStartAngle + (triggerEndAngle - triggerStartAngle) * arcProgress
		local segmentY = triggerCenterY + triggerRadius * math.sin(arcAngle)
		local segmentZ = triggerCenterZ + triggerRadius * math.cos(arcAngle)
		local segmentTilt = math.atan2(-math.cos(arcAngle), -math.sin(arcAngle))
		createGunPart(gunModel, handle, "TriggerSegment" .. segmentIndex, block, Vector3.new(0.1, 0.045, 0.075), CFrame.new(0, segmentY, segmentZ) * CFrame.Angles(segmentTilt, 0, 0), COLOR_TRIGGER, smoothPlastic)
	end

	return gunModel
end

