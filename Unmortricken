local function getAllTargetRoots()
	local targetRoots = {}

	for _, otherPlayer in ipairs(Players:GetPlayers()) do
		local otherCharacter = otherPlayer ~= localPlayer and otherPlayer.Character
		local otherRoot = otherCharacter and otherCharacter:FindFirstChild("HumanoidRootPart")
		local otherHumanoid = otherCharacter and otherCharacter:FindFirstChildOfClass("Humanoid")
		if otherRoot and otherHumanoid and otherHumanoid.Health > 0 then
			table.insert(targetRoots, otherRoot)
		end
	end

	local liveFolder = workspace:FindFirstChild(DUMMY_FOLDER_NAME)
	local dummy = liveFolder and liveFolder:FindFirstChild(DUMMY_NAME)
	if dummy then
		local dummyRoot = dummy:FindFirstChild("HumanoidRootPart") or (dummy:IsA("Model") and dummy.PrimaryPart)
		local dummyHumanoid = dummy:FindFirstChildOfClass("Humanoid")
		if dummyRoot and dummyRoot.Parent and (not dummyHumanoid or dummyHumanoid.Health > 0) then
			table.insert(targetRoots, dummyRoot)
		end
	end

	return targetRoots
end

local function describeDummy()
	local liveFolder = workspace:FindFirstChild(DUMMY_FOLDER_NAME)
	if not liveFolder then
		return "workspace." .. DUMMY_FOLDER_NAME .. " does not exist"
	end
	local dummy = liveFolder:FindFirstChild(DUMMY_NAME)
	if not dummy then
		return "no '" .. DUMMY_NAME .. "' inside workspace." .. DUMMY_FOLDER_NAME
	end
	local dummyRoot = dummy:FindFirstChild("HumanoidRootPart") or (dummy:IsA("Model") and dummy.PrimaryPart)
	if not (dummyRoot and dummyRoot.Parent) then
		return "found it, but it has no HumanoidRootPart / PrimaryPart"
	end
	local dummyHumanoid = dummy:FindFirstChildOfClass("Humanoid")
	if dummyHumanoid and dummyHumanoid.Health <= 0 then
		return "found it, but its Humanoid.Health is " .. tostring(dummyHumanoid.Health) .. " (counts as dead)"
	end
	return "OK, counts as a target (root is " .. dummyRoot.Name .. ")"
end

local function isRootInsideHitbox(hitbox, targetRoot)
	local localPosition = hitbox.CFrame:PointToObjectSpace(targetRoot.Position)
	local reach = hitbox.Size / 2 + Vector3.one * ATTACK3_HITBOX_TOUCH_PADDING
	return math.abs(localPosition.X) <= reach.X and math.abs(localPosition.Y) <= reach.Y and math.abs(localPosition.Z) <= reach.Z
end

local function findTouchedTarget(hitbox)
	local bestRoot
	local bestDistance = math.huge
	for _, targetRoot in ipairs(getAllTargetRoots()) do
		if isRootInsideHitbox(hitbox, targetRoot) then
			local distance = (targetRoot.Position - hitbox.Position).Magnitude
			if distance < bestDistance then
				bestDistance = distance
				bestRoot = targetRoot
			end
		end
	end
	return bestRoot
end

