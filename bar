        "LEGENDARY SUPER SAIYAN",
        "SAIYAN INSTINCT",
    }

    local function typeText(text, duration)
        label.Text = ""
        local length = #text
        local step = duration / math.max(length, 1)

        for i = 1, length do
            label.Text = text:sub(1, i)
            task.wait(step)
        end
