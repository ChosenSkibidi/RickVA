Font { Family = rbxasset://fonts/families/GothamSSm.json, Weight = Medium, Style = Normal }

    local s = Font.new("rbxasset://fonts/families/SourceSansPro.json", Enum.FontWeight.Regular, Enum.FontStyle.Normal)

