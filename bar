    if health then
        if health:FindFirstChild("Bar") then
            health.Bar.Image = "rbxassetid://15248647876"
            health.Bar.ImageTransparency = 1
            health.Bar.ImageColor3 = Color3.new(0, 0, 0)

            if health.Bar:FindFirstChild("Bar") then
