    countdown.TextStrokeTransparency = 0.3
    countdown.Visible = false
    countdown.ZIndex = 3
    countdown.Parent = mini

    cooldownEnd = 0
    cooldownConn = nil

    function setReady(ready)
        mini.ImageTransparency = ready and 0 or 0.7
        stroke.Color = ready and GLOW_COLOR or Color3.fromRGB(230, 70, 70)
        countdown.Visible = not ready
    end

    function startCooldown()
        cooldownEnd = os.clock() + MANUAL_RETREAT_COOLDOWN
        setReady(false)
        if cooldownConn then
            cooldownConn:Disconnect()
        end
        cooldownConn = RunService.Heartbeat:Connect(function()
            remaining = cooldownEnd - os.clock()
            if remaining <= 0 then
                cooldownConn:Disconnect()
                cooldownConn = nil
                setReady(true)
                return
            end
            countdown.Text = tostring(math.ceil(remaining))
        end)
    end

    activatedConn = mini.Activated:Connect(function()
        if os.clock() < cooldownEnd then return end
        if manualRetreat() then
            startCooldown()
        end
    end)

    return function()
        activatedConn:Disconnect()
        if cooldownConn then
            cooldownConn:Disconnect()
            cooldownConn = nil
        end
        mini:Destroy()
    end
end

function applyAppearance(character)
