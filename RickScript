dodgeConn = RunService.Heartbeat:Connect(function()
    if not dodge.enabled then return end

    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= LocalPlayer then
            char = plr.Character
            hum = char and char:FindFirstChildOfClass("Humanoid")
            animator = hum and hum:FindFirstChildOfClass("Animator")
            current = {}
            if animator then
                previous = dodge.seen[plr]
                for _, track in ipairs(animator:GetPlayingAnimationTracks()) do
                    anim = track.Animation
                    if anim and isDodgeAnimation(anim.AnimationId) then
                        current[track] = true
                        if not (previous and previous[track]) and shouldDodge(char, isConditionedDodgeAnimation(anim.AnimationId) and CONDITIONED_DODGE_RANGE or DODGE_RANGE, isConditionedDodgeAnimation(anim.AnimationId)) then
                            startDodge(char)
                        end
                    end
                end
            end
            dodge.seen[plr] = current
        end
    end
end)

