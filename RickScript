function flatXZ(v)
    return Vector3.new(v.X, 0, v.Z)
end

-- How much the attacker must be facing you grows smoothly (an S-curve) with distance:
-- point-blank = anything goes, short range = "kind of facing", max range = "properly facing".
function dodgeRequiredFacing(dist)
    t = math.clamp((dist - DODGE_POINT_BLANK) / (DODGE_RANGE - DODGE_POINT_BLANK), 0, 1)
    smooth = t * t * (3 - 2 * t)
    return DODGE_FACING_NEAR + (DODGE_FACING_FAR - DODGE_FACING_NEAR) * smooth
end

function isConditionedDodgeAnimation(animationId)
    for _, id in ipairs(CONDITIONED_DODGE_ANIMATION_IDS) do
        if string.find(animationId, id, 1, true) then
            return true
        end
    end
    return false
end

function isDodgeAnimation(animationId)
    if isConditionedDodgeAnimation(animationId) then
        return true
    end
    for _, id in ipairs(DODGE_ANIMATION_IDS) do
        if string.find(animationId, id, 1, true) then
            return true
        end
    end
    return false
end

function shouldDodge(attackerChar, maxRange, anyDirection)
    maxRange = maxRange or DODGE_RANGE
    myChar = LocalPlayer.Character
    myRoot = myChar and myChar:FindFirstChild("HumanoidRootPart")
    myHum = myChar and myChar:FindFirstChildOfClass("Humanoid")
    aRoot = attackerChar:FindFirstChild("HumanoidRootPart")
    aHum = attackerChar:FindFirstChildOfClass("Humanoid")
    if not myRoot or not myHum or myHum.Health <= 0 or not aRoot or not aHum or aHum.Health <= 0 then
        return false
    end

    offset = myRoot.Position - aRoot.Position
    dist = offset.Magnitude
    if dist > maxRange then
        return false
    end
    if dist <= DODGE_POINT_BLANK or anyDirection then
        return true
    end

    toMe = flatXZ(offset)
    look = flatXZ(aRoot.CFrame.LookVector)
    if toMe.Magnitude < 0.01 or look.Magnitude < 0.01 then
        return false
    end
    return look.Unit:Dot(toMe.Unit) >= dodgeRequiredFacing(dist)
end

-- Teleport VFX: clones a particle template onto your root and bursts every emitter in it.
function emitVFX(root, vfxTemplate, emitCount, keepEnabled)
    part = vfxTemplate:Clone()
    part.Parent = root
    for _, v in ipairs(part:GetChildren()) do
        if v:IsA("ParticleEmitter") then
            v:Emit(emitCount or 15)
            v.Enabled = keepEnabled or false
        end
    end
    Debris:AddItem(part, 3)
end

-- hidden = true makes your whole body invisible, false brings it back exactly as it was
hiddenOriginals = setmetatable({}, { __mode = "k" })
function setVisibility(character, hidden)
    for _, d in ipairs(character:GetDescendants()) do
        if (d:IsA("BasePart") or d:IsA("Decal")) and d.Name ~= "HumanoidRootPart" then
            if hidden then
                if hiddenOriginals[d] == nil then
                    hiddenOriginals[d] = d.Transparency
                end
                d.Transparency = 1
            elseif hiddenOriginals[d] ~= nil then
                d.Transparency = hiddenOriginals[d]
                hiddenOriginals[d] = nil
            end
        end
    end
end

-- Hologram-blue highlight over your whole body (hidden behind walls, not through them) that fades out
-- smoothly; one tween drives both the fill and the outline, same as the portal flash.
function flashDodgeHighlight(character, highlight, tween)
    highlight = Instance.new("Highlight")
    highlight.Name = "RickDodgeFlash"
    highlight.Adornee = character
    highlight.FillColor = DODGE_GLOW_COLOR
    highlight.OutlineColor = DODGE_GLOW_COLOR
    highlight.FillTransparency = 0
    highlight.OutlineTransparency = 0
    highlight.DepthMode = Enum.HighlightDepthMode.Occluded
    highlight.Parent = character

    tween = TweenService:Create(
        highlight,
        TweenInfo.new(DODGE_FLASH_TIME, Enum.EasingStyle.Sine, Enum.EasingDirection.Out),
        { FillTransparency = 1, OutlineTransparency = 1 }
    )
    tween.Completed:Once(function()
        highlight:Destroy()
    end)
    tween:Play()
end

function emitDodgeBurst(root)
    pcall(function()
        particles = ReplicatedStorage.Resources.NinjaUlt.Start_Effects.Particles
        emitVFX(root, particles.Low)
        emitVFX(root, particles.Center_Tilted)
        emitVFX(root, particles.Ground)
    end)
end

function isStreakVoicePlaying()
    return dodgeStreak.sound ~= nil and dodgeStreak.sound.Parent ~= nil and dodgeStreak.sound.IsPlaying
end

function playDodgeArrival(character, root, playVoice, playStreakVoice, sound)
    flashDodgeHighlight(character)
    for _, snd in ipairs(DODGE_SOUNDS) do
        if snd.asset and (snd ~= DODGE_VOICE or (playVoice and not isStreakVoicePlaying())) and (snd ~= DODGE_STREAK_VOICE or playStreakVoice) then
            sound = playSounds({ { id = snd.asset, volume = snd.volume } }, root)
            if snd == DODGE_STREAK_VOICE then
                dodgeStreak.sound = sound
            end
        end
    end

    -- quick blink so the teleport reads as a flash (own thread so the dodge poll isn't held up)
    task.spawn(function()
        setVisibility(character, true)  task.wait(0.01)
        setVisibility(character, false) task.wait(0.01)
        setVisibility(character, true)  task.wait(0.01)
        setVisibility(character, false)
    end)
end

-- the teleport itself: burst, land behind them, highlight, sounds, blink. Returns false if it couldn't.
function teleportBehind(attackerChar, playVoice, playStreakVoice)
    character = LocalPlayer.Character
    humanoid = character and character:FindFirstChildOfClass("Humanoid")
    root = character and character:FindFirstChild("HumanoidRootPart")
    aRoot = attackerChar:FindFirstChild("HumanoidRootPart")
    if not humanoid or humanoid.Health <= 0 or not root or not aRoot then return false end

    -- burst at the spot you're leaving (a missing template never blocks the teleport)
    emitDodgeBurst(root)

    -- land behind them, facing them
    look = flatXZ(aRoot.CFrame.LookVector)
    look = look.Magnitude > 0.01 and look.Unit or Vector3.new(0, 0, -1)
    landPos = aRoot.Position - look * DODGE_BEHIND_DISTANCE
    root.CFrame = CFrame.new(landPos, Vector3.new(aRoot.Position.X, landPos.Y, aRoot.Position.Z))

    playDodgeArrival(character, root, playVoice, playStreakVoice)
    return true
end

dodgeCameraLock = { token = 0 }

function lockCameraOn(targetRoot, duration, camera, token)
    if not targetRoot then return end
    dodgeCameraLock.token = dodgeCameraLock.token + 1
    token = dodgeCameraLock.token
    pcall(function()
        RunService:UnbindFromRenderStep("RickDodgeCameraLock")
    end)
    RunService:BindToRenderStep("RickDodgeCameraLock", Enum.RenderPriority.Camera.Value + 1, function()
        camera = workspace.CurrentCamera
        if camera and targetRoot.Parent then
            camera.CFrame = CFrame.lookAt(camera.CFrame.Position, targetRoot.Position)
        end
    end)
    task.delay(duration, function()
        if dodgeCameraLock.token == token then
            pcall(function()
                RunService:UnbindFromRenderStep("RickDodgeCameraLock")
            end)
        end
    end)
end

