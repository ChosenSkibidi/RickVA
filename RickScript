function bounce(t)
    if t <= 0 then
        return 0
    end
    return 1 - math.exp(-DAMPING * t) * math.cos(FREQUENCY * t)
end

function getTargets()
    list = {}
    for _, p in ipairs(Players:GetPlayers()) do
        root = p ~= LocalPlayer and p.Character and p.Character:FindFirstChild("HumanoidRootPart")
        if root then
            table.insert(list, { name = p.Name, displayName = p.DisplayName, root = root, userId = p.UserId, player = p })
        end
    end

    live = workspace:FindFirstChild("Live")
    dummy = live and live:FindFirstChild("Weakest Dummy")
    dummyRoot = dummy and dummy:FindFirstChild("HumanoidRootPart")
    if dummyRoot then
        table.insert(list, { name = "Weakest Dummy", displayName = "Weakest Dummy", root = dummyRoot, model = dummy })
    end

    return list
end

function pickTarget()
    list = getTargets()
    if #list == 0 then
        return nil
    end
    return list[math.random(1, #list)].root
end

activeFovTween = nil

function snapFieldOfView()
    camera = workspace.CurrentCamera
    if not camera then return end
    if activeFovTween then
        activeFovTween:Cancel()
    end
    camera.FieldOfView = PORTAL_FOV_SNAP
    activeFovTween = TweenService:Create(
        camera,
        TweenInfo.new(PORTAL_FOV_RETURN_TIME, Enum.EasingStyle.Quint, Enum.EasingDirection.Out),
        { FieldOfView = PORTAL_FOV_REST }
    )
    activeFovTween:Play()
end

function zoomFieldOfView(duration)
    camera = workspace.CurrentCamera
    if not camera then return end
    if activeFovTween then
        activeFovTween:Cancel()
    end
    activeFovTween = TweenService:Create(
        camera,
        TweenInfo.new(duration, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut),
        { FieldOfView = PORTAL_FOV_ZOOM }
    )
    activeFovTween:Play()
end

function playSound(id, volume, parent, sound)
    sound = Instance.new("Sound")
    sound.SoundId = id
    sound.Volume = volume
    sound.Parent = parent
    sound.Ended:Once(function()
        sound:Destroy()
    end)
    sound:Play()
    task.delay(15, function()
        if sound.Parent then
            sound:Destroy()
        end
    end)
    return sound
end

function playSounds(ids, parent, sound, firstSound)
    if not parent then return end
    for _, entry in ipairs(ids) do
        sound = playSound(
            type(entry) == "table" and entry.id or entry,
            type(entry) == "table" and entry.volume or SOUND_VOLUME,
            parent
        )
        firstSound = firstSound or sound
    end
    return firstSound
end

function playCharacterAnimation(character, animationId, humanoid, animator, animation, loaded, track)
    humanoid = character and character:FindFirstChildOfClass("Humanoid")
    animator = humanoid and humanoid:FindFirstChildOfClass("Animator")
    if not animator then return nil end
    animation = Instance.new("Animation")
    animation.AnimationId = animationId
    loaded, track = pcall(function()
        return animator:LoadAnimation(animation)
    end)
    if loaded and track then
        track.Priority = Enum.AnimationPriority.Action4
        track:Play()
        track.Stopped:Once(function()
            animation:Destroy()
        end)
        return track
    else
        warn("[RickPortal] animation failed to load: " .. animationId)
        animation:Destroy()
        return nil
    end
end

