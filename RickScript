-- Highlight (portal light green) over the whole character that fades out smoothly. One tween drives both
-- the fill and the outline, so they fade together.
function flashHighlight(character, highlight, tween)
    if not character then return end

    if activeFlash then
        activeFlash:Destroy()
        activeFlash = nil
    end

    highlight = Instance.new("Highlight")
    highlight.Name = "RickPortalFlash"
    highlight.Adornee = character
    highlight.FillColor = GLOW_COLOR
    highlight.OutlineColor = GLOW_COLOR
    highlight.FillTransparency = 0
    highlight.OutlineTransparency = 0
    highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
    highlight.Parent = character
    activeFlash = highlight

    tween = TweenService:Create(
        highlight,
        TweenInfo.new(PORTAL_FLASH_TIME, Enum.EasingStyle.Sine, Enum.EasingDirection.Out),
        { FillTransparency = 1, OutlineTransparency = 1 }
    )
    tween.Completed:Once(function()
        if activeFlash == highlight then
            activeFlash = nil
        end
        highlight:Destroy()
    end)
    tween:Play()
end

-- Pushes you forward at your WalkSpeed for the first `distance` studs after a regular portal,
-- even if you let go of the controls, so the walk out of the exit portal always looks smooth.
function walkOut(root, look, distance, hum, currentSpeed, bv, startPos, startTime, dir, conn)
    hum = root.Parent and root.Parent:FindFirstChildOfClass("Humanoid")
    function currentSpeed()
        return hum and hum.WalkSpeed or 16
    end

    bv = Instance.new("BodyVelocity")
    bv.Name = "RickPortalWalk"
    bv.MaxForce = Vector3.new(math.huge, 0, math.huge) -- sideways only, gravity still works
    bv.P = 10000
    bv.Velocity = look * currentSpeed()
    bv.Parent = root

    startPos = root.Position
    startTime = os.clock()
    dir = look
    conn = nil
    conn = RunService.Heartbeat:Connect(function()
        speed = currentSpeed()
        walked = Vector3.new(root.Position.X - startPos.X, 0, root.Position.Z - startPos.Z).Magnitude
        timedOut = os.clock() - startTime > distance / math.max(speed, 1) + 0.75
        if not bv.Parent or not root.Parent or walked >= distance or timedOut then
            conn:Disconnect()
            bv:Destroy()
            return
        end

        -- after the first EXIT_PORTAL_BEHIND_DISTANCE studs (you've passed the exit portal),
        -- steer by where you're facing now. Y is thrown away so it can never push you up or down.
        if walked >= EXIT_PORTAL_BEHIND_DISTANCE then
            live = Vector3.new(root.CFrame.LookVector.X, 0, root.CFrame.LookVector.Z)
            if live.Magnitude > 0.01 then
                dir = live.Unit
            end
        end

        bv.Velocity = dir * speed -- always grabs the current WalkSpeed
    end)
end

-- regular = true (normal portals): no exit animation, and you keep walking forward at your
-- walk speed so you stroll out through the exit portal.
function teleportOut(root, landPos, faceAt, regular, noAnimation, flat, look, hum)
    flat = Vector3.new(faceAt.X - landPos.X, 0, faceAt.Z - landPos.Z)
    look = flat.Magnitude > 0.01 and flat.Unit or Vector3.new(0, 0, -1)
    root.CFrame = CFrame.lookAt(landPos, landPos + look)

    if regular then
        hum = root.Parent and root.Parent:FindFirstChildOfClass("Humanoid")
        root.AssemblyLinearVelocity = look * (hum and hum.WalkSpeed or 16)
        walkOut(root, look, EXIT_WALK_DISTANCE)
    else
        root.AssemblyLinearVelocity = Vector3.zero
    end

    if shootTrack and shootTrack.IsPlaying then
        shootTrack:Stop(0)
    end
    shootTrack = nil

    if not regular and not noAnimation then
        playCharacterAnimation(root.Parent, EXIT_ANIMATION_ID)
    end

    -- white flash over the whole character, fading out
    flashHighlight(root.Parent)
end

function makeFace(frame, face)
    gui = Instance.new("SurfaceGui")
    gui.Face = face
    gui.SizingMode = Enum.SurfaceGuiSizingMode.FixedSize
    gui.CanvasSize = Vector2.new(512, 512)
    gui.LightInfluence = 0
    gui.Brightness = 1
    gui.AlwaysOnTop = false
    gui.Parent = frame

    img = Instance.new("ImageLabel")
    img.BackgroundTransparency = 1
    img.Image = textureUrl
    img.AnchorPoint = Vector2.new(0.5, 0.5)
    img.Position = UDim2.fromScale(0.5, 0.5)
    img.Size = UDim2.fromScale(textureScale.X, textureScale.Y)
    img.Parent = gui

    corner = Instance.new("UICorner")
    corner.CornerRadius = UDim.new(0.5, 0)
    corner.Parent = img
    return img
end

function destroyPortal(p)
    if p.wallParts then
        for _, part in ipairs(p.wallParts) do
            if part.Parent then
                part.CanCollide = true
            end
        end
        p.wallParts = nil
    end
    if p.conn then p.conn:Disconnect() end
    if p.touchConn then p.touchConn:Disconnect() end
    if p.frame then p.frame:Destroy() end
    if p.trigger then p.trigger:Destroy() end
    portals[p] = nil
end

function closePortal(p)
    if p.state ~= "closing" then
        p.state = "closing"
        p.stateStart = os.clock()
        p.armed = false
    end
end

function shootOrb(fromPos, toPos, travelTime, orb, tw)
    orb = Instance.new("Part")
    orb.Shape = Enum.PartType.Ball
    orb.Material = Enum.Material.Neon
    orb.Color = GLOW_COLOR
    orb.Size = Vector3.new(1.2, 1.2, 1.2)
    orb.Anchored = true
    orb.CanCollide = false
    orb.CanTouch = false
    orb.CanQuery = false
    orb.CastShadow = false
    orb.Position = fromPos
    orb.Parent = workspace

    tw = TweenService:Create(
        orb,
        TweenInfo.new(travelTime, Enum.EasingStyle.Quad, Enum.EasingDirection.In),
        { Position = toPos, Size = Vector3.new(0.4, 0.4, 0.4) }
    )
    tw:Play()
    tw.Completed:Wait()
    orb:Destroy()
end

function buildPortal(portalCF, decorative, onWall, p, frame, light, enter)
    p = { state = "opening", stateStart = os.clock(), spawnTime = os.clock(), armed = false, decorative = decorative, onWall = onWall }
    if not decorative then
        snapFieldOfView()
    end

    -- Wall portal: switch off collision on the wall behind the opening (same trick as the
    -- retreat floor) so you can actually walk through. Restored when the portal goes away.
    p.wallParts = {}
    if onWall and not decorative then
        overlap = OverlapParams.new()
        overlap.FilterType = Enum.RaycastFilterType.Exclude
        ignore = {}
        for _, plr in ipairs(Players:GetPlayers()) do
            if plr.Character then
                table.insert(ignore, plr.Character)
            end
        end
        overlap.FilterDescendantsInstances = ignore
        -- portal faces out along -Z, so the wall is on the +Z side
        cutCF = portalCF * CFrame.new(0, 0, WALL_CUT_DEPTH / 2)
        found = workspace:GetPartBoundsInBox(cutCF, Vector3.new(TRIGGER_SIZE.X, TRIGGER_SIZE.Y, WALL_CUT_DEPTH), overlap)
        for _, part in ipairs(found) do
            if part.CanCollide and not part:IsA("Terrain") then
                table.insert(p.wallParts, part)
                part.CanCollide = false
            end
        end
    end
    -- if nothing could be switched off (e.g. a terrain wall) fall back to touch-to-enter
    p.touchMode = onWall and not decorative and #p.wallParts == 0

    frame = Instance.new("Part")
    frame.Name = "RickPortal"
    frame.Transparency = 1
    frame.Size = Vector3.new(0.05, 0.05, DISC_THICKNESS)
    frame.Anchored = true
    frame.CanCollide = false
    frame.CanTouch = false
    frame.CanQuery = false
    frame.CastShadow = false
    frame.CFrame = portalCF

    p.labels = {
        makeFace(frame, Enum.NormalId.Front),
        makeFace(frame, Enum.NormalId.Back),
    }

    light = Instance.new("PointLight")
    light.Color = GLOW_COLOR
    light.Range = 0
    light.Brightness = 0
    light.Shadows = false
    light.Parent = frame
    p.light = light

    TweenService:Create(
        light,
        TweenInfo.new(LIGHT_TWEEN_TIME, Enum.EasingStyle.Quint, Enum.EasingDirection.Out),
        { Range = LIGHT_RANGE }
    ):Play()

    frame.Parent = workspace
    p.frame = frame
    playSounds(OPEN_SOUNDS, frame)
    if decorative and EXIT_SOUND.asset then
        playSounds({ { id = EXIT_SOUND.asset, volume = EXIT_PORTAL_SOUND_VOLUME } }, frame)
    end

    -- Walking into a portal isn't enough: you have to go all the way THROUGH it, and a bit
    -- past (ENTER_DEPTH studs beyond the portal's face), inside its opening, before it fires.
    function enter(root, area, tRoot, portalSpot, toTarget, landPos, retPos)
        area = chosenArea
        chosenArea = nil

        if area then
            chosenTarget = nil
            p.armed = false
            teleportToArea(root, area, p)
            return
        end

        tRoot = (chosenTarget and chosenTarget:IsDescendantOf(workspace)) and chosenTarget or pickTarget()
        chosenTarget = nil
        if not tRoot then
            warn("[RickPortal] no other player to teleport to")
            return
        end

        p.armed = false
        -- exit portal sits where you used to land; you appear 2 studs behind it, facing the
        -- target, and keep walking forward through it
        portalSpot = (tRoot.CFrame * CFrame.new(0, 0, ARRIVE_DISTANCE + RETURN_PORTAL_OFFSET - EXIT_PORTAL_FRONT_DISTANCE)).Position
        toTarget = Vector3.new(tRoot.Position.X - portalSpot.X, 0, tRoot.Position.Z - portalSpot.Z)
        toTarget = toTarget.Magnitude > 0.01 and toTarget.Unit or Vector3.new(0, 0, -1)
        landPos = portalSpot - toTarget * EXIT_PORTAL_BEHIND_DISTANCE
        snapFieldOfView()
        teleportOut(root, landPos, tRoot.Position, true)
        closePortal(p)

        retPos = Vector3.new(portalSpot.X, tRoot.Position.Y + SPAWN_HEIGHT, portalSpot.Z)
        buildPortal(CFrame.lookAt(retPos, retPos + toTarget), true)
    end

    p.conn = RunService.Heartbeat:Connect(function()
        now = os.clock()
        t = now - p.stateStart
        w, h = nil, nil

        if not p.decorative and p.state ~= "closing" then
            char = LocalPlayer.Character
            root = char and char:FindFirstChild("HumanoidRootPart")
            if root and p.touchMode then
                -- wall we couldn't cut open (e.g. terrain): touching the portal is enough
                if p.armed then
                    overlap = OverlapParams.new()
                    overlap.FilterType = Enum.RaycastFilterType.Include
                    overlap.FilterDescendantsInstances = { char }
                    if #workspace:GetPartBoundsInBox(portalCF, TRIGGER_SIZE, overlap) > 0 then
                        enter(root)
                    end
                end
            elseif root then
                rel = portalCF:PointToObjectSpace(root.Position)
                prev = p.lastRel
                p.lastRel = rel

                -- startSide = the side of the portal you came from (+1 or -1 along its normal)
                if p.startSide == nil then
                    p.startSide = rel.Z >= 0 and 1 or -1
                elseif math.abs(rel.Z) > ENTER_DEPTH + 1 then
                    p.startSide = rel.Z > 0 and 1 or -1
                end

                -- depth = how far past the plane you are, measured away from where you started
                if p.armed and prev then
                    dPrev = -p.startSide * prev.Z
                    dNow = -p.startSide * rel.Z
                    if dPrev < ENTER_DEPTH and dNow >= ENTER_DEPTH then
                        -- where on the portal's opening did you cross the "deep" line?
                        alpha = (ENTER_DEPTH - dPrev) / (dNow - dPrev)
                        crossX = prev.X + (rel.X - prev.X) * alpha
                        crossY = prev.Y + (rel.Y - prev.Y) * alpha
                        if math.abs(crossX) <= TRIGGER_SIZE.X / 2 and math.abs(crossY) <= TRIGGER_SIZE.Y / 2 then
                            enter(root)
                        end
                    end
                end
            else
                p.lastRel = nil
            end
        end

        if p.state == "opening" then
            w = PORTAL_SIZE * bounce(t)
            h = PORTAL_SIZE * bounce(t - STAGGER)
            if t >= ARM_DELAY and not p.decorative then p.armed = true end
            if t >= OPEN_TIME then
                if p.decorative then
                    closePortal(p)
                else
                    p.state = "open"
                    p.stateStart = now
                end
            end
        elseif p.state == "open" then
            w = PORTAL_SIZE * (1 + PULSE_AMOUNT * math.sin(t * PULSE_SPEED))
            h = PORTAL_SIZE * (1 + PULSE_AMOUNT * math.sin(t * PULSE_SPEED + 1.2))
            if t >= PORTAL_LIFETIME then
                closePortal(p)
            end
        else
            u = math.clamp(t / CLOSE_TIME, 0, 1)
            w = PORTAL_SIZE * (1 - TweenService:GetValue(u, Enum.EasingStyle.Back, Enum.EasingDirection.In))
            h = PORTAL_SIZE * (1 - TweenService:GetValue(math.min(u * 1.25, 1), Enum.EasingStyle.Back, Enum.EasingDirection.In))
            if u >= 1 then
                destroyPortal(p)
                return
            end
        end

        w = math.max(w, 0.05)
        h = math.max(h, 0.05)

        frame.Size = Vector3.new(w * widthScale, h, DISC_THICKNESS)

        rot = ((now - p.spawnTime) * SPIN_SPEED) % 360
        for _, lbl in ipairs(p.labels) do
            lbl.Rotation = rot
        end
        light.Brightness = LIGHT_BRIGHTNESS * math.clamp(w / PORTAL_SIZE, 0, 1.3)
    end)

    portals[p] = true
    return p
end

-- Retreat arrival: you appear sunk into the ground under the exit portal, hold for a moment,
-- then get thrown up and forward. Only YOU go non-solid (and un-supported) - the floor itself is
-- never touched, so a big floor part keeps its collision everywhere.
function emergeFromFloor(root, portalPos, normal, look, upSpeed, fwdSpeed, character, hum, charParts, prevPlatformStand, sunkPos, launchUp, forwardApplied, done, launched, launchTime, conn, finish)
    upSpeed = upSpeed or FAILSAFE_LAUNCH_UP
    fwdSpeed = fwdSpeed or FAILSAFE_LAUNCH_FWD
    character = root.Parent
    hum = character and character:FindFirstChildOfClass("Humanoid")
    if not character or not hum then return end

    -- no collision on you
    charParts = {}
    for _, d in ipairs(character:GetDescendants()) do
        if d:IsA("BasePart") then
            charParts[d] = d.CanCollide
            d.CanCollide = false
        end
    end
    prevPlatformStand = hum.PlatformStand
    hum.PlatformStand = true

    -- sunk into the ground, held still
    sunkPos = portalPos - normal * FAILSAFE_SINK_DEPTH
    root.CFrame = CFrame.lookAt(sunkPos, sunkPos + look)
    root.AssemblyLinearVelocity = Vector3.zero
    root.Anchored = true

    -- straight up first; the forward push only starts once you've risen back out of the sink depth
    launchUp = Vector3.new(0, upSpeed, 0)
    forwardApplied = false
    done = false
    launched = false
    launchTime = 0
    conn = nil

    function finish()
        if done then return end
        done = true
        if conn then
            conn:Disconnect()
            conn = nil
        end
        if root.Parent then
            root.Anchored = false
        end
        for part, original in pairs(charParts) do
            if part.Parent then
                part.CanCollide = original
            end
        end
        if hum.Parent then
            hum.PlatformStand = prevPlatformStand
            hum:ChangeState(Enum.HumanoidStateType.Freefall)
        end
    end

    conn = RunService.Stepped:Connect(function()
        if not character.Parent or not root.Parent or hum.Health <= 0 then
            finish()
            return
        end
        -- the humanoid keeps turning collision back on, so keep it off
        for part in pairs(charParts) do
            if part.Parent and part.CanCollide then
                part.CanCollide = false
            end
        end
        if launched then
            height = (root.Position - portalPos):Dot(normal)
            -- height starts at -FAILSAFE_SINK_DEPTH; 0 means you've passed the whole sink distance
            if not forwardApplied and height >= 0 then
                forwardApplied = true
                if fwdSpeed > 0 then
                    v = root.AssemblyLinearVelocity
                    root.AssemblyLinearVelocity = Vector3.new(look.X * fwdSpeed, v.Y, look.Z * fwdSpeed)
                end
            end
            if height >= 3 or os.clock() - launchTime > 2 then
                finish()
            end
        end
    end)

    task.delay(FAILSAFE_SINK_HOLD, function()
        if done or not root.Parent then return end
        root.Anchored = false
        root.AssemblyLinearVelocity = launchUp
        launched = true
        launchTime = os.clock()
        RunService.Heartbeat:Once(function()
            if not done and not forwardApplied and root.Parent then
                root.AssemblyLinearVelocity = launchUp
            end
        end)
    end)
end

teleportToArea = function(root, area, fromPortal, opts, origin, flat, look, landPos, floorExit, pos, faceAt, toFace, floorPos, rayParams, ignore, hit, behind, portalPos, retPos)

    origin = root.CFrame
    flat = Vector3.new(origin.LookVector.X, 0, origin.LookVector.Z)
    look = flat.Magnitude > 0.01 and flat.Unit or Vector3.new(0, 0, -1)
    landPos = area.cframe.Position
    floorExit = opts and opts.floorExit

    -- areas can work out their destination at the last moment (e.g. "behind that player")
    if area.resolve then
        pos, faceAt = area.resolve()
        if pos then
            landPos = pos
            if faceAt then
                toFace = Vector3.new(faceAt.X - pos.X, 0, faceAt.Z - pos.Z)
                if toFace.Magnitude > 0.01 then
                    look = toFace.Unit
                end
            end
        end
    end

    floorPos = nil
    if floorExit then
        -- find the floor at the destination and put the exit portal flat on it
        rayParams = RaycastParams.new()
        rayParams.FilterType = Enum.RaycastFilterType.Exclude
        rayParams.RespectCanCollide = true
        ignore = {}
        for _, plr in ipairs(Players:GetPlayers()) do
            if plr.Character then
                table.insert(ignore, plr.Character)
            end
        end
        rayParams.FilterDescendantsInstances = ignore
        hit = workspace:Raycast(landPos + Vector3.new(0, 5, 0), Vector3.new(0, -40, 0), rayParams)
        floorPos = hit and hit.Position or (landPos - Vector3.new(0, 3, 0))
        landPos = Vector3.new(landPos.X, floorPos.Y + 2.5, landPos.Z)
    end

    snapFieldOfView()
    if floorExit then
        -- retreat arrival: no exit animation
        teleportOut(root, landPos, landPos + look, false, true)
    else
        -- regular portal: appear 2 studs behind the exit portal and keep walking forward
        behind = landPos - look * EXIT_PORTAL_BEHIND_DISTANCE
        teleportOut(root, behind, behind + look, true)
    end
    if fromPortal then
        closePortal(fromPortal)
    end

    if floorExit then
        portalPos = floorPos + Vector3.new(0, WALL_OFFSET, 0)
        buildPortal(CFrame.lookAt(portalPos, portalPos + Vector3.yAxis, Vector3.zAxis), true)

        -- start sunk into the ground under the portal, then get thrown out up and forward
        emergeFromFloor(root, portalPos, Vector3.yAxis, look, opts.upSpeed, opts.fwdSpeed)
    else
        retPos = Vector3.new(landPos.X, landPos.Y + SPAWN_HEIGHT, landPos.Z)
        buildPortal(CFrame.lookAt(retPos, retPos + look), true)
    end

    if area.onArrive then
        task.spawn(area.onArrive)
    end
end

function openPortal(target, char, root, rootCF, center, portalCF, rayParams, ignore, rayOrigin, shotVector, reach, hit, orbEnd, onWall, stuckPos, hand, fromPos)
    if shooting then return end
    char = LocalPlayer.Character
    root = char and char:FindFirstChild("HumanoidRootPart")
    if not root then
        warn("[RickPortal] no character / HumanoidRootPart found")
        return
    end

    rootCF = root.CFrame
    center = (rootCF * CFrame.new(0, SPAWN_HEIGHT, -SPAWN_DISTANCE)).Position

    portalCF = CFrame.lookAt(center, Vector3.new(rootCF.Position.X, center.Y, rootCF.Position.Z))

    rayParams = RaycastParams.new()
    rayParams.FilterType = Enum.RaycastFilterType.Exclude
    rayParams.RespectCanCollide = true
    ignore = {}
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr.Character then
            table.insert(ignore, plr.Character)
        end
    end
    rayParams.FilterDescendantsInstances = ignore

    rayOrigin = rootCF.Position + Vector3.new(0, SPAWN_HEIGHT, 0)
    shotVector = center - rayOrigin
    reach = shotVector + shotVector.Unit * WALL_SNAP_DISTANCE
    hit = workspace:Raycast(rayOrigin, reach, rayParams)
    orbEnd = center
    onWall = false
    if hit and math.abs(hit.Normal.Y) < WALL_MAX_NORMAL_Y then
        onWall = true
        orbEnd = hit.Position
        stuckPos = hit.Position + hit.Normal * WALL_OFFSET

        portalCF = CFrame.lookAt(stuckPos, stuckPos + hit.Normal)
    end

    hand = char:FindFirstChild("RightHand") or char:FindFirstChild("Right Arm") or root
    fromPos = hand.Position

    for p in pairs(portals) do
        closePortal(p)
    end

    chosenTarget = typeof(target) == "Instance" and target or nil
    chosenArea = (type(target) == "table" and typeof(target.cframe) == "CFrame") and target or nil
    shooting = true
    shootTrack = playCharacterAnimation(char, SHOOT_ANIMATION_ID)
    playSounds(SHOOT_SOUNDS, root)
    task.spawn(function()

        shotTime = math.max(SHOT_TIME * (orbEnd - fromPos).Magnitude / (center - fromPos).Magnitude, 0.08)
        zoomFieldOfView(shotTime)
        task.delay(math.max(shotTime - PRE_OPEN_TIME, 0), function()
            playSounds({ PRE_OPEN_SOUND }, root)
        end)
        orbOk, orbErr = pcall(shootOrb, fromPos, orbEnd, shotTime)
        if not orbOk then warn("[RickPortal] orb failed: " .. tostring(orbErr)) end
        shooting = false
        buildOk, buildErr = pcall(buildPortal, portalCF, nil, onWall)
        if not buildOk then warn("[RickPortal] portal failed: " .. tostring(buildErr)) end
    end)
end

failsafe = {
    enabled = FAILSAFE_ENABLED,
    threshold = FAILSAFE_HEALTH,
    armed = true,
    retreating = false,
    lastTrigger = -math.huge,
    bindId = 0,
    conns = {},
}

function findArea(name)
    for _, area in ipairs(AREAS) do
        if area.name == name then
            return area
        end
    end
    return nil
end

StarterGui = game:GetService("StarterGui")

function performRetreat(character, humanoid, area, track, preflagged, stopTrack, root, ignore, rayParams, hit, floorPos, floorY, portalPos)
    function stopTrack()
        if track and track.IsPlaying then
            track:Stop(0)
        end
    end

    if failsafe.retreating and not preflagged then return end
    root = character:FindFirstChild("HumanoidRootPart")
    if not character.Parent or humanoid.Health <= 0 or not root then
        stopTrack()
        failsafe.retreating = false
        return
    end

    ignore = {}
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr.Character then
            table.insert(ignore, plr.Character)
        end
    end

    -- find the floor under the player and lay a portal flat on it
    rayParams = RaycastParams.new()
    rayParams.FilterType = Enum.RaycastFilterType.Exclude
    rayParams.RespectCanCollide = true
    rayParams.FilterDescendantsInstances = ignore

    hit = workspace:Raycast(root.Position, Vector3.new(0, -40, 0), rayParams)
    floorPos = hit and hit.Position or (root.Position - Vector3.new(0, 3, 0))
    floorY = floorPos.Y
    portalPos = floorPos + Vector3.new(0, WALL_OFFSET, 0)
    ok, err = pcall(buildPortal, CFrame.lookAt(portalPos, portalPos + Vector3.yAxis, Vector3.zAxis), true)
    if not ok then
        warn("[RickPortal] failsafe portal failed: " .. tostring(err))
    end

    failsafe.retreating = true

    task.delay(FAILSAFE_DELAY, function(curRoot, floorParts, overlap, found, charParts, prevPlatformStand, done, conn, started, finish)
        curRoot = character:FindFirstChild("HumanoidRootPart")
        if not character.Parent or humanoid.Health <= 0 or not curRoot then
            stopTrack()
            failsafe.retreating = false
            return
        end

        -- remember + disable the floor parts under the portal
        floorParts = {}
        overlap = OverlapParams.new()
        overlap.FilterType = Enum.RaycastFilterType.Exclude
        overlap.FilterDescendantsInstances = ignore
        found = workspace:GetPartBoundsInBox(CFrame.new(floorPos.X, floorY - 8, floorPos.Z), Vector3.new(10, 20, 10), overlap)
        for _, part in ipairs(found) do
            if part.CanCollide and not part:IsA("Terrain") then
                table.insert(floorParts, part)
                part.CanCollide = false
            end
        end

        -- remember + disable the character's collision
        charParts = {}
        for _, d in ipairs(character:GetDescendants()) do
            if d:IsA("BasePart") then
                charParts[d] = d.CanCollide
                d.CanCollide = false
            end
        end

        -- PlatformStand stops the humanoid from holding you up off the ground
        prevPlatformStand = humanoid.PlatformStand
        humanoid.PlatformStand = true
        curRoot.AssemblyLinearVelocity = Vector3.new(0, -12, 0)

        done = false
        conn = nil
        started = os.clock()

        function finish(doTeleport)
            if done then return end
            done = true
            if conn then
                conn:Disconnect()
                conn = nil
            end
            stopTrack()

            for part, original in pairs(charParts) do
                if part.Parent then
                    part.CanCollide = original
                end
            end
            for _, part in ipairs(floorParts) do
                if part.Parent then
                    part.CanCollide = true
                end
            end
            if humanoid.Parent then
                humanoid.PlatformStand = prevPlatformStand
            end
            failsafe.retreating = false

            if doTeleport then
                r = character:FindFirstChild("HumanoidRootPart")
                if r and humanoid.Health > 0 then
                    teleportToArea(r, area, nil, { floorExit = true, upSpeed = area.upSpeed, fwdSpeed = area.fwdSpeed })
                end
            end
        end

        conn = RunService.Stepped:Connect(function()
            if not character.Parent or humanoid.Health <= 0 or not curRoot.Parent then
                finish(false)
                return
            end
            -- the humanoid keeps trying to turn collision back on, so keep it off
            for part in pairs(charParts) do
                if part.Parent and part.CanCollide then
                    part.CanCollide = false
                end
            end
            if curRoot.Position.Y <= floorY - FAILSAFE_FALL_DEPTH or os.clock() - started > FAILSAFE_FALL_TIMEOUT then
                finish(true)
            end
        end)
    end)
end

-- The full retreat: wave animation + pre-open sound, then the floor portal 0.1s later.
-- Both the mini button and the Retreat? popup use this so they look identical.
function runRetreatSequence(character, humanoid, area, root, track)
    root = character:FindFirstChild("HumanoidRootPart")
    if not character.Parent or not root or humanoid.Health <= 0 or failsafe.retreating then
        return false
    end

    failsafe.retreating = true
    track = playCharacterAnimation(character, RETREAT_ANIMATION_ID)
    playSounds({ PRE_OPEN_SOUND }, root)
    task.delay(RETREAT_START_DELAY, function()
        performRetreat(character, humanoid, area, track, true)
    end)
    return true
end

function triggerFailsafe(character, humanoid, area, root, callback)
    area = findArea(FAILSAFE_AREA)
    root = character:FindFirstChild("HumanoidRootPart")
    if not area or not root then return end
    if (root.Position - area.cframe.Position).Magnitude < FAILSAFE_MIN_DISTANCE then return end

    -- disarmed until health goes back above the threshold (or you respawn)
    failsafe.armed = false
    failsafe.lastTrigger = os.clock()

    callback = Instance.new("BindableFunction")
    callback.OnInvoke = function(choice)
        if choice == "Yes" then
            runRetreatSequence(character, humanoid, area)
        end
        task.defer(function()
            callback:Destroy()
        end)
    end
    task.delay(FAILSAFE_PROMPT_TIME + 2, function()
        if callback.Parent == nil then
            callback:Destroy()
        end
    end)

    ok, err = pcall(function()
        StarterGui:SetCore("SendNotification", {
            Title = "Retreat?",
            Text = string.format("Health is low (%d). Teleport to %s?", math.floor(humanoid.Health), area.name),
            Duration = FAILSAFE_PROMPT_TIME,
            Button1 = "Yes",
            Button2 = "No",
            Callback = callback,
        })
    end)
    if not ok then
        warn("[RickPortal] couldn't show the Retreat? prompt: " .. tostring(err))
        callback:Destroy()
    end
end

function bindFailsafe(character)
    failsafe.bindId = failsafe.bindId + 1
    myId = failsafe.bindId
    for _, c in ipairs(failsafe.conns) do
        c:Disconnect()
    end
    table.clear(failsafe.conns)
    failsafe.armed = true

    humanoid = character:WaitForChild("Humanoid", 10)
    if not humanoid or failsafe.bindId ~= myId then return end

    table.insert(failsafe.conns, humanoid.HealthChanged:Connect(function(health)
        if health > failsafe.threshold then
            failsafe.armed = true
            return
        end
        if not failsafe.enabled or not failsafe.armed or health <= 0 then return end
        if os.clock() - failsafe.lastTrigger < FAILSAFE_COOLDOWN then return end
        triggerFailsafe(character, humanoid)
    end))
end

failsafeCharConn = LocalPlayer.CharacterAdded:Connect(function(character)
