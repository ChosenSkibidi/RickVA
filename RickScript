-- ===================== VOID RESCUE =====================
void = { lastNear = nil, lastNearTime = 0, lastTrigger = -math.huge }

-- a valid target is alive and itself above the void line
function isValidVoidTarget(plr)
    char = plr and plr.Character
    hum = char and char:FindFirstChildOfClass("Humanoid")
    r = char and char:FindFirstChild("HumanoidRootPart")
    return hum ~= nil and r ~= nil and hum.Health > 0 and r.Position.Y >= VOID_Y
end

voidConn = RunService.Heartbeat:Connect(function()
    char = LocalPlayer.Character
    root = char and char:FindFirstChild("HumanoidRootPart")
    hum = char and char:FindFirstChildOfClass("Humanoid")
    if not root or not hum or hum.Health <= 0 then return end

    -- above the line: keep track of who you're standing near
    if root.Position.Y >= VOID_Y then
        best, bestDist = nil, VOID_NEAR_RADIUS
        for _, plr in ipairs(Players:GetPlayers()) do
            if plr ~= LocalPlayer and isValidVoidTarget(plr) then
                dist = (plr.Character.HumanoidRootPart.Position - root.Position).Magnitude
                if dist <= bestDist then
                    best, bestDist = plr, dist
                end
            end
        end
        if best then
            void.lastNear = best
            void.lastNearTime = os.clock()
        end
        return
    end

    -- below it
    if failsafe.retreating or os.clock() - void.lastTrigger < VOID_COOLDOWN then return end
    void.lastTrigger = os.clock()

    area = nil
    landCFrame = nil
    target = void.lastNear
    if target and os.clock() - void.lastNearTime <= VOID_MEMORY and isValidVoidTarget(target) then
        tRoot = target.Character.HumanoidRootPart
        look = flatXZ(tRoot.CFrame.LookVector)
        look = look.Magnitude > 0.01 and look.Unit or Vector3.new(0, 0, -1)
        landPos = tRoot.Position - look * VOID_BEHIND_DISTANCE
        landCFrame = CFrame.new(landPos, Vector3.new(tRoot.Position.X, landPos.Y, tRoot.Position.Z))
    else
        area = findArea(VOID_FALLBACK_AREA)
        if not area then return end
        myLook = flatXZ(root.CFrame.LookVector)
        myLook = myLook.Magnitude > 0.01 and myLook.Unit or Vector3.new(0, 0, -1)
        landCFrame = CFrame.lookAt(area.cframe.Position, area.cframe.Position + myLook)
    end

    emitDodgeBurst(root)
    root.AssemblyLinearVelocity = Vector3.zero
    root.AssemblyAngularVelocity = Vector3.zero
    root.CFrame = landCFrame
    playDodgeArrival(root.Parent, root, true)

    if area and area.onArrive then
        task.spawn(area.onArrive)
    end
end)

gunTemplate = nil
gunHolder = nil

function loadGunTemplate()
    if gunTemplate then
        return gunTemplate
    end
    loadedOk, loadedObjects = pcall(function()
        return game:GetObjects(GUN_MODEL_ID)
    end)
    if not loadedOk or not loadedObjects or not loadedObjects[1] then
        warn("[RickPortal] couldn't load the gun model")
        return nil
    end
    gunTemplate = loadedObjects[1]
    return gunTemplate
end

function attachGun(character)
    template = loadGunTemplate()
    if not template then return end

    arm = character:WaitForChild("Right Arm", 5)
    if not arm then
        warn("[RickPortal] no Right Arm found for the gun")
        return
    end

    if gunHolder then
        gunHolder:Destroy()
        gunHolder = nil
    end

    newHolder = Instance.new("Model")
    newHolder.Name = "RickPortalGun"
    template:Clone().Parent = newHolder

    gunParts = {}
    for _, descendant in ipairs(newHolder:GetDescendants()) do
        if descendant:IsA("BaseScript") then
            descendant:Destroy()
        elseif descendant:IsA("BasePart") then
            table.insert(gunParts, descendant)
        end
    end
    if #gunParts == 0 then
        warn("[RickPortal] gun model has no parts")
        newHolder:Destroy()
        return
    end

    handle = newHolder:FindFirstChild("Handle", true)
    if not handle or not handle:IsA("BasePart") then
        handle = gunParts[1]
    end

    relativeOffsets = {}
    for _, part in ipairs(gunParts) do
        relativeOffsets[part] = handle.CFrame:Inverse() * part.CFrame
    end

    for _, part in ipairs(gunParts) do
        part.Anchored = false
        part.CanCollide = false
        part.Massless = true
        if part ~= handle then
            partWeld = Instance.new("Weld")
            partWeld.Part0 = handle
            partWeld.Part1 = part
            partWeld.C0 = relativeOffsets[part]
            partWeld.C1 = CFrame.new()
            partWeld.Parent = handle
        end
    end

    handle.Name = "Handle"
    gunWeld = Instance.new("Weld")
    gunWeld.Name = "RightGrip"
    gunWeld.Part0 = arm
    gunWeld.Part1 = handle
    gunWeld.C0 = GUN_ARM_OFFSET
    gunWeld.C1 = CFrame.new()
    gunWeld.Parent = handle

    newHolder.Parent = character
    gunHolder = newHolder
end

